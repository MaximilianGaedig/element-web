.mx_BulkActionsBar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background-color: var(--cpd-color-bg-canvas-default);
    z-index: 100;
    height: 77px;
    box-sizing: border-box;

    .mx_BulkActionsBar_count {
        font-weight: var(--cpd-font-weight-semibold);
    }

    .mx_BulkActionsBar_actions {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-2x);
    }

    .mx_BulkActionsBar_action {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-1x);
    }
}
