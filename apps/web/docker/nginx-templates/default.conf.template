server {
    listen       ${ELEMENT_WEB_PORT};
    listen  [::]:${ELEMENT_WEB_PORT};
    server_name  localhost;

    root   /usr/share/nginx/html;
    index  index.html;

    # Compress text assets; the JS bundles are several MB uncompressed.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/javascript text/javascript application/json
               application/manifest+json image/svg+xml application/wasm;

    # Content-hashed assets never change under the same URL: cache them for a year so repeat
    # loads don't touch the network. index.html, sw.js and config stay no-store (below), so new
    # deploys are still picked up immediately.
    location /bundles/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }
    location ~* "\.[0-9a-f]{7,}\.(woff2?|ttf|svg|png|jpe?g|gif|webp|json|mp3|ogg|wasm)$" {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Use no-store for files that must always be fresh to prevent any caching
    # issues when deploying new builds.

    location = /index.html {
        add_header Cache-Control "no-store";
    }
    location = /version {
        add_header Cache-Control "no-store";
    }
    location = /sw.js {
        add_header Cache-Control "no-store";
    }
    location /i18n/ {
        add_header Cache-Control "no-store";
    }

    # covers config.json and config.hostname.json requests as it is prefix.
    location /config {
        root /tmp/element-web-config;
        add_header Cache-Control "no-store";
    }
    location /modules {
        alias /modules;
    }
    # redirect server error pages to the static page /50x.html
    #
    error_page   500 502 503 504  /50x.html;
}
