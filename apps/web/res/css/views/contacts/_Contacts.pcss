/* Element's own list shapes, not a new set: a row is an avatar, two lines of text and a trailing note. */
.mx_Contacts {
    /*
     * One control with two positions: a tinted track with the chosen half raised out of it, which is how a
     * segmented control reads. Element's own colours and font, iOS's shape.
     */
    .mx_Contacts_tabs {
        display: flex;
        gap: 2px;
        padding: 2px;
        margin: 0 var(--mx-contacts-gutter) var(--cpd-space-2x);
        border-radius: var(--mx-contacts-inset-radius);
        background: var(--cpd-color-bg-subtle-secondary);

        button {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: var(--cpd-space-1x);
            flex: 1;
            min-height: calc(var(--mx-contacts-row-height) - 12px);
            padding: 0 var(--cpd-space-2x);
            border: none;
            border-radius: calc(var(--mx-contacts-inset-radius) - 2px);
            background: transparent;
            color: var(--cpd-color-text-secondary);
            font: var(--cpd-font-body-sm-semibold);
            cursor: pointer;
            transition:
                background-color 120ms ease,
                color 120ms ease;

            &[aria-selected="true"] {
                background: var(--cpd-color-bg-canvas-default);
                color: var(--cpd-color-text-primary);
                box-shadow: 0 1px 2px rgb(0 0 0 / 12%);
            }
        }
    }

    /*
     * What is picked and what can be done to it, above the list rather than over it: a bar that floats on
     * top of the rows hides the very names the reader is choosing between.
     */
    .mx_Contacts_batch {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-2x);
        padding: var(--cpd-space-2x) var(--mx-contacts-gutter);
        margin: 0 var(--mx-contacts-gutter) var(--cpd-space-2x);
        border-radius: var(--mx-contacts-inset-radius);
        background: var(--cpd-color-bg-subtle-secondary);
    }

    .mx_Contacts_batchCount {
        flex: 1;
        color: var(--cpd-color-text-secondary);
        font: var(--cpd-font-body-sm-medium);
    }

    /*
     * The reader's own row, above the letters and set apart from them: it is not one of the names being
     * scrolled through, it is the card this list belongs to.
     */
    .mx_Contacts_me {
        margin-bottom: var(--cpd-space-2x);

        &::after {
            display: none;
        }
    }

    /* The face, and whatever is marked on it. */
    .mx_Contacts_faceWith {
        position: relative;
        display: flex;
        flex-shrink: 0;
    }

    /*
     * Where the marks go, which is where the room list puts them: the network in the bottom-left corner,
     * presence in the bottom-right (see _BridgeInfo.pcss). Both ringed in the canvas colour so they read
     * as badges on the face rather than as part of the picture.
     */
    .mx_Contacts_face {
        position: relative;
        display: flex;
        flex-shrink: 0;

        .mx_Contacts_networkLogo {
            position: absolute;
            inset-inline-start: -3px;
            inset-block-end: -3px;
            border-radius: 4px;
            box-shadow: 0 0 0 2px var(--cpd-color-bg-canvas-default);
        }
    }

    /*
     * The tick that says a row is picked, on the corner of the face: in the row it would be a column that
     * appears and disappears, which shifts every name in the list at the moment of picking one.
     */
    .mx_Contacts_tick {
        position: absolute;
        inset-block-end: -2px;
        inset-inline-end: -2px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 18px;
        height: 18px;
        border: 2px solid var(--cpd-color-bg-canvas-default);
        border-radius: 50%;
        background: var(--cpd-color-bg-subtle-primary);
        color: var(--cpd-color-icon-on-solid-primary);
        transition: background-color 120ms ease;

        &[data-selected] {
            background: var(--cpd-color-bg-accent-rest);
        }
    }

    /*
     * The row's own menu control, out of the way until it is wanted.
     *
     * Only where there is a pointer to reveal it with: on a touch screen a control that appears on hover
     * takes the first tap to appear and the second to work, so there it is simply always there - and a long
     * press on the row opens the same menu either way.
     */
    /*
     * The row's one control, at the end of the row and always there.
     *
     * It used to appear on hover as a little slab beside the row, on its own surface, with the row's
     * hairline stopping short of it - three surfaces where there is one thing. It sits inside the row's
     * own padding now, where the network logos used to be, and the hairline runs the full width under it.
     */
    .mx_Contacts_more {
        flex-shrink: 0;
        color: var(--cpd-color-icon-secondary);
    }

    /*
     * Shown when the row is pointed at, and always where there is no pointer to point with: a control
     * revealed on hover takes the first tap to appear and the second to work on a touch screen.
     */
    @media (hover: hover) and (pointer: fine) {
        .mx_Contacts_more {
            opacity: 0;
            transition: opacity 100ms ease;
        }

        .mx_Contacts_rowWith:hover .mx_Contacts_more,
        .mx_Contacts_rowWith:focus-within .mx_Contacts_more,
        .mx_Contacts_more[data-open] {
            opacity: 1;
        }
    }

    /*
     * A full-width row with a hairline under the words, which is the shape of a grouped list: the rounded
     * pill this used to be made every name look like a separate control rather than one list to read down.
     */
    .mx_Contacts_row {
        position: relative;
        display: flex;
        align-items: center;
        gap: var(--cpd-space-3x);
        width: 100%;
        box-sizing: border-box;
        min-height: var(--mx-contacts-row-height);
        padding: var(--mx-contacts-row-padding-block) var(--mx-contacts-gutter);
        border: none;
        border-radius: 0;
        background: transparent;
        color: var(--cpd-color-text-primary);
        text-align: start;
        font: var(--cpd-font-body-md-regular);
        cursor: pointer;

        &:hover,
        &:focus-visible {
            background: var(--cpd-color-bg-subtle-secondary);
        }
    }

    /*
     * The separator starts where the text starts, so a row divides under the name and not under the face.
     * Drawn on the row rather than between rows so it survives a row being filtered out of the middle.
     */
    .mx_Contacts_row:not(:last-child)::after {
        content: "";
        position: absolute;
        inset-inline: var(--mx-contacts-separator-inset) 0;
        bottom: 0;
        height: 1px;
        background: var(--mx-contacts-hairline);
    }

    /*
     * The row and its one control are one surface.
     *
     * The control cannot be inside the row - a button in a button is not markup a browser keeps - so the
     * wrapper carries the padding, the hover and the hairline, and the two things inside it carry none of
     * their own. Otherwise the line under a row stops wherever the button starts.
     */
    .mx_Contacts_rowWith {
        position: relative;
        display: flex;
        align-items: center;
        padding-inline-end: var(--mx-contacts-gutter);

        &:hover,
        &:focus-within {
            background: var(--cpd-color-bg-subtle-secondary);
        }

        .mx_Contacts_row {
            min-width: 0;
            padding-inline-end: var(--cpd-space-2x);

            /* The wrapper draws it, across the whole row including the control. */
            &:hover,
            &:focus-visible {
                background: transparent;
            }

            &::after {
                display: none;
            }
        }
    }

    /* Room at the end of every row for the letters floating over the list. */
    .mx_Contacts_listWithIndex .mx_Contacts_rowWith,
    .mx_Contacts_listWithIndex .mx_Contacts_letter {
        padding-inline-end: calc(var(--mx-contacts-gutter) + var(--cpd-space-3x));
    }

    /* One hairline per row, under the text and running to the edge past the control. */
    .mx_Contacts_rowWith:not(:last-child)::after {
        content: "";
        position: absolute;
        inset-inline: var(--mx-contacts-separator-inset) 0;
        bottom: 0;
        height: 1px;
        background: var(--mx-contacts-hairline);
    }

    /*
     * Two accounts that might be one person, above the list because it is a question rather than a row:
     * tinted so it does not read as somebody you can open, and gone as soon as it is answered either way.
     */
    /*
     * A question, stacked, because this now lives in the room list's column rather than a dialog.
     *
     * Side by side - face, sentence, two buttons - the sentence had perhaps six characters of room and
     * arrived as an ellipsis, which is no use for a question whose whole job is to say which two people
     * it means. The face and name keep their row; what it says and what you can answer sit under it.
     */
    /*
     * A suggestion: who it is, how many cards were found, and the cards themselves a disclosure away.
     *
     * Naming the networks in a sentence said nothing about which card was which - and two cards on the same
     * network with the same name and picture is the case this exists for. Opening it lists each card with
     * the number or handle that tells it from its twin, and a tick that keeps it in or leaves it out.
     */
    .mx_Contacts_suggestion {
        display: flex;
        flex-direction: column;
        padding: var(--cpd-space-1x) 0;
        margin: 0 var(--mx-contacts-gutter) var(--cpd-space-2x);
        border-radius: var(--mx-contacts-inset-radius);
        background: var(--cpd-color-bg-subtle-secondary);
    }

    .mx_Contacts_suggestionHead {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-1x);
        padding-inline-end: var(--cpd-space-2x);
    }

    .mx_Contacts_suggestionWho {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-3x);
        flex: 1;
        min-width: 0;
        min-height: var(--mx-contacts-row-height);
        padding: var(--cpd-space-1x) var(--cpd-space-3x);
        border: none;
        border-radius: var(--mx-contacts-inset-radius);
        background: none;
        color: var(--cpd-color-text-primary);
        text-align: start;
        cursor: pointer;
    }

    /* The faces overlap, as a stack of people does, so several fit in a row's worth of width. */
    .mx_Contacts_suggestionFaces {
        display: flex;
        flex-shrink: 0;
    }

    .mx_Contacts_suggestionFace {
        position: relative;
        display: flex;
        flex-shrink: 0;

        & + & {
            margin-inline-start: -12px;
        }
    }

    .mx_Contacts_suggestionChevron {
        flex-shrink: 0;
        color: var(--cpd-color-icon-secondary);
        transition: transform 160ms ease;

        &[data-open] {
            transform: rotate(180deg);
        }
    }

    .mx_Contacts_suggestionActions {
        display: flex;
        gap: var(--cpd-space-1x);
        flex-shrink: 0;
    }

    .mx_Contacts_suggestionCards {
        display: flex;
        flex-direction: column;
        margin: 0;
        padding: 0;
        list-style: none;
    }

    .mx_Contacts_suggestionCard {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-3x);
        width: 100%;
        box-sizing: border-box;
        min-height: var(--mx-contacts-row-height);
        padding: var(--cpd-space-1x) var(--cpd-space-3x);
        border: none;
        background: none;
        color: var(--cpd-color-text-primary);
        text-align: start;
        cursor: pointer;

        &:hover:not(:disabled),
        &:focus-visible {
            background: var(--cpd-color-bg-subtle-primary);
        }

        /* A card with no Matrix ID cannot be merged with anything, so it is shown and not offered. */
        &:disabled {
            opacity: 0.6;
            cursor: default;
        }

        .mx_Contacts_tick {
            position: static;
            border: none;
        }
    }

    /*
     * The list, with the letters floating over it.
     *
     * Over rather than beside: a column of its own took width from every name and put the ruler outside
     * the thing it rules. It sits on the inside edge of the list, vertically centred, and the rows keep
     * enough room at their end that nothing runs under it.
     */
    .mx_Contacts_listWithIndex {
        position: relative;
        display: flex;
        align-items: stretch;
        min-height: 0;

        .mx_Contacts_list {
            flex: 1;
            min-width: 0;
        }
    }

    /*
     * One letter per section, as a column down the edge of the list.
     *
     * Small and tight on purpose: it is a ruler for the list rather than a set of buttons, so it stays out
     * of the way of the names until it is aimed at.
     */
    /*
     * The letters fill the strip rather than sitting in the middle of it.
     *
     * The whole strip takes the drag - that is what makes it a ruler - so the letters have to be the whole
     * strip as well: centred in a full-height column, the list jumped from a point where nothing was drawn,
     * which reads as the list moving on its own.
     */
    .mx_Contacts_index {
        position: absolute;
        inset-inline-end: var(--cpd-space-1x);
        inset-block-start: 50%;
        transform: translateY(-50%);
        z-index: 2;
        display: flex;
        flex-direction: column;
        justify-content: center;
        /*
         * As tall as its own letters, and no taller: stretched to the list's height they were spread
         * almost fifty pixels apart and the strip took a drag over mostly empty space, which is the same
         * mismatch from the other side - what can be dragged has to be what is drawn.
         */
        flex-shrink: 0;
        padding: 0 var(--cpd-space-1x);
        /* Dragged rather than scrolled, so the strip keeps the gesture instead of the list taking it. */
        touch-action: none;
        cursor: ns-resize;
        user-select: none;

        span[aria-hidden] {
            /* Tight, as an index is: a ruler to run a thumb down, not a column of controls. */
            color: var(--cpd-color-text-secondary);
            font: var(--cpd-font-body-xs-medium);
            line-height: 1.25;
            text-align: center;
        }

        /* While it is being dragged the whole strip is the control, so all of it lights up. */
        &[data-dragging] span[aria-hidden] {
            color: var(--cpd-color-text-primary);
        }
    }

    /*
     * The same letters for the keyboard, off screen but not out of the tree: the strip is a drag, which a
     * keyboard cannot do, and a letter nobody can tab to is a list half the readers cannot navigate.
     */
    .mx_Contacts_indexKeys {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
    }

    /*
     * Sticky, so the reader can always see which letter the names under the cursor belong to.
     *
     * No band behind it: a tinted bar reads as a row of its own and cuts the list into pieces, where a
     * phone's address book just sets the letter in the margin above the names it belongs to.
     */
    .mx_Contacts_letter {
        position: sticky;
        top: 0;
        z-index: 1;
        margin: 0;
        padding: var(--cpd-space-2x) var(--mx-contacts-gutter) var(--cpd-space-1x);
        /*
         * The canvas colour rather than nothing: it is sticky, so rows scrolling under it have to be
         * covered by something or the letter reads over the top of a name.
         */
        background: var(--cpd-color-bg-canvas-default);
        color: var(--cpd-color-text-secondary);
        font: var(--cpd-font-body-sm-semibold);
        /* A rule across the full width under it, which is what closes the section off from the one above. */
        border-bottom: 1px solid var(--mx-contacts-hairline);
    }

    /*
     * The favourites as a grid that fills the width it is given.
     *
     * Sideways scrolling hid most of them behind a gesture nothing announced, and on a wide panel left the
     * row three quarters empty. A grid that takes as many columns as fit shows the whole set at any width,
     * which is what a phone's favourites screen does.
     */
    .mx_Contacts_favourites {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(80px, 1fr));
        gap: var(--cpd-space-3x) var(--cpd-space-2x);
        padding: 0 var(--mx-contacts-gutter) var(--cpd-space-3x);
    }

    .mx_Contacts_favourite {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: var(--cpd-space-2x);
        min-width: 0;
        padding: var(--cpd-space-2x) var(--cpd-space-1x);
        border: none;
        border-radius: var(--mx-contacts-inset-radius);
        background: transparent;
        color: var(--cpd-color-text-primary);
        cursor: pointer;

        &:hover,
        &:focus-visible {
            background: var(--cpd-color-bg-subtle-secondary);
        }
    }

    .mx_Contacts_favouriteName {
        max-width: 100%;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font: var(--cpd-font-body-xs-regular);
    }

    /* The same shape as the bar at the foot of the column, with the same travelling mark. */
    .mx_Contacts_filters {
        position: relative;
        display: flex;
        gap: 2px;
        padding: 2px;
        margin: 0 var(--mx-contacts-gutter) var(--cpd-space-2x);
        border-radius: var(--mx-contacts-inset-radius);
        background: var(--cpd-color-bg-subtle-secondary);

        button {
            position: relative;
            z-index: 1;
            flex: 1;
            min-height: calc(var(--mx-contacts-row-height) - 12px);
            padding: 0 var(--cpd-space-2x);
            border: none;
            border-radius: calc(var(--mx-contacts-inset-radius) - 2px);
            background: none;
            color: var(--cpd-color-text-secondary);
            font: var(--cpd-font-body-sm-semibold);
            cursor: pointer;
            transition: color 160ms ease;

            &[aria-selected="true"] {
                color: var(--cpd-color-text-primary);
            }
        }
    }

    .mx_Contacts_filterSelection {
        position: absolute;
        inset-block: 2px;
        inset-inline-start: 0;
        border-radius: calc(var(--mx-contacts-inset-radius) - 2px);
        background: var(--cpd-color-bg-canvas-default);
        box-shadow: 0 1px 2px rgb(0 0 0 / 12%);
        transition:
            transform 220ms cubic-bezier(0.2, 0, 0, 1),
            width 220ms cubic-bezier(0.2, 0, 0, 1);
        pointer-events: none;
    }

    /* A missed call is the one row people open this list to find. */
    .mx_Contacts_row_missed .mx_Contacts_name {
        color: var(--cpd-color-text-critical-primary);
    }

    .mx_Contacts_rowText {
        display: flex;
        flex-direction: column;
        flex: 1;
        min-width: 0;
    }

    .mx_Contacts_name {
        font: var(--cpd-font-body-md-medium);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mx_Contacts_detail,
    .mx_Contacts_when {
        color: var(--cpd-color-text-secondary);
        font: var(--cpd-font-body-sm-regular);
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mx_Contacts_networks {
        display: flex;
        gap: var(--cpd-space-1x);
        flex-shrink: 0;
    }

    /*
     * Which way a call went and how it ended, in colour, because it is now the only thing saying it.
     * Element's semantic icon colours rather than a palette of this screen's own.
     */
    .mx_Contacts_callMark {
        /*
         * On the text's own line, explicitly: this client draws svg as a block by default, which put the
         * mark above the duration instead of in front of it and made every call row two lines tall.
         */
        display: inline-block;
        flex-shrink: 0;
        vertical-align: -3px;
        margin-inline-end: var(--cpd-space-1x);
        color: var(--cpd-color-icon-secondary);

        /* The one that is still owed an answer. */
        &[data-mark="missed"] {
            color: var(--cpd-color-icon-critical-primary);
        }

        &[data-mark="declined"] {
            color: var(--cpd-color-icon-tertiary);
        }

        &[data-mark="answered"] {
            color: var(--cpd-color-icon-success-primary);
        }

        &[data-mark="outgoing"] {
            color: var(--cpd-color-icon-accent-tertiary);
        }
    }

    /*
     * The detail line stays a line of text.
     *
     * Making it a flex container to seat the call mark quietly turned off the ellipsis every one of these
     * lines relies on - `text-overflow` does nothing to flex children - so a long identifier ran out of the
     * row instead of being cut. The mark is inline and sits on the text's own baseline instead.
     */
    .mx_Contacts_detail {
        display: block;
    }

    .mx_Contacts_network {
        padding: 0 var(--cpd-space-2x);
        /* A pill, as Element's other rounded chrome writes it. */
        border-radius: 99px;
        background: var(--cpd-color-bg-subtle-primary);
        color: var(--cpd-color-text-secondary);
        font: var(--cpd-font-body-xs-medium);
        line-height: 20px;
    }

    .mx_Contacts_empty {
        padding: var(--cpd-space-6x) 0;
        color: var(--cpd-color-text-secondary);
        text-align: center;
    }
}

/*
 * Contacts in the room list's column, so it fills it: the header is the only fixed part and the lists
 * below take the rest, which is what lets their own scroller reach the bottom of the screen.
 */
.mx_ContactsView {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1;
    /*
     * The panel is the thing that is narrow, not the window: this column can be a phone's width inside a
     * wide desktop window, and a rule that asks the window what size it is gets the wrong answer in the
     * one case it exists for. Named, as _HomePage.pcss and _RoomView.pcss name theirs.
     */
    container: contactspanel / inline-size;
}

/* Back at one edge, the menu at the other, and nothing in between claiming to be a title. */
.mx_ContactsView_header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--cpd-space-2x);
    padding: var(--cpd-space-2x) var(--mx-contacts-gutter);
}

.mx_ContactsView_title {
    margin: 0;
    font: var(--cpd-font-heading-sm-semibold);
}

/*
 * Fills the column, rather than the 60vh a dialog could afford to stop at, and ends above the bar.
 *
 * The bar floats over this column, so without the room for it at the foot the last row scrolls to a stop
 * underneath it - which on a phone is the row nearest the thumb.
 */
.mx_ContactsView .mx_Contacts_list {
    max-height: none;
    flex: 1;
    /*
     * Room at the end for the bar floating over this column: the names pass under it while scrolling,
     * which is what its glass is for, and the last row can still be brought clear of it.
     */
    padding-bottom: var(--mx-room-list-toast-bottom, 6rem);
}

/*
 * The contact card: face and name, what you can do, then what is known.
 *
 * Sectioned as iOS does it - grouped inset blocks with a label beside each value - because the point of
 * the card is that one person has several of these, and a flat list of rows would not say so.
 */
/*
 * The card scrolls, and everything in it keeps the list's gutter.
 *
 * It is a column of sections whose length depends on how many networks somebody is on, how many groups you
 * share and how many calls there have been - so on a phone the foot of it was simply unreachable. The
 * header stays put and the rest scrolls under it.
 */
.mx_ContactCard {
    display: flex;
    flex-direction: column;
    min-height: 0;
    flex: 1;
    overflow: hidden;
}

.mx_ContactCard_scroll {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding-bottom: var(--mx-room-list-toast-bottom, var(--cpd-space-8x));
}

.mx_ContactCard_edit {
    margin-inline-start: auto;
}

.mx_ContactCard_head {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--cpd-space-2x);
    padding: var(--cpd-space-4x) 0;
}

.mx_ContactCard_name {
    margin: 0;
    text-align: center;
    font: var(--cpd-font-heading-md-semibold);
}

/* What the network calls them, once the reader has called them something else. */
.mx_ContactCard_alias {
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
}

.mx_ContactCard_rename {
    width: 100%;
}

.mx_ContactCard_renameActions {
    display: flex;
    justify-content: flex-end;
    gap: var(--cpd-space-2x);
    margin-top: var(--cpd-space-2x);
}

/*
 * The four actions as equal tiles across the card, the way a phone lays them out: a filled round mark with
 * its name under it, every tile the same width, so the row is read at a glance instead of icon by icon.
 */
.mx_ContactCard_actions {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 1fr;
    gap: var(--cpd-space-2x);
    padding: 0 var(--mx-contacts-gutter) var(--cpd-space-4x);
}

.mx_ContactCard_action {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--cpd-space-1x);
    min-width: 0;
    padding: 0;
    border: none;
    background: none;
    color: var(--cpd-color-text-primary);
    font: var(--cpd-font-body-xs-medium);
    cursor: pointer;

    &:disabled {
        color: var(--cpd-color-text-disabled);
        cursor: default;
    }
}

.mx_ContactCard_actionMark {
    display: flex;
    align-items: center;
    justify-content: center;
    /* The platform's smallest target, and the shape a phone gives these. */
    width: var(--mx-contacts-row-height);
    height: var(--mx-contacts-row-height);
    border-radius: 50%;
    background: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-icon-accent-primary);
    transition: background-color 120ms ease;

    .mx_ContactCard_action:hover:not(:disabled) &,
    .mx_ContactCard_action:focus-visible & {
        background: var(--cpd-color-bg-subtle-primary);
    }

    .mx_ContactCard_action:disabled & {
        color: var(--cpd-color-icon-disabled);
    }
}

/* Taking one account back out of a merged person, beside the row it belongs to. */
.mx_ContactCard_accountUnlink {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-width: var(--mx-contacts-row-height);
    border: none;
    background: none;
    color: var(--cpd-color-icon-secondary);
    cursor: pointer;

    &:hover,
    &:focus-visible {
        color: var(--cpd-color-icon-critical-primary);
        background: var(--cpd-color-bg-subtle-primary);
    }
}

/* A grouped block, inset from the edge by the same gutter the rows use. */
.mx_ContactCard_section {
    display: flex;
    flex-direction: column;
    margin: 0 var(--mx-contacts-gutter) var(--cpd-space-4x);
    border-radius: var(--mx-contacts-inset-radius);
    background: var(--cpd-color-bg-subtle-secondary);
    overflow: hidden;
}

.mx_ContactCard_fact,
.mx_ContactCard_account {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 100%;
    box-sizing: border-box;
    min-height: var(--mx-contacts-row-height);
    justify-content: center;
    padding: var(--mx-contacts-row-padding-block) var(--mx-contacts-gutter);
    border: none;
    background: transparent;
    color: var(--cpd-color-text-primary);
    text-align: start;
    font: inherit;

    /* A hairline between rows, as the grouped lists have, but not under the last. */
    & + & {
        border-top: 1px solid var(--cpd-color-bg-subtle-primary);
    }
}

.mx_ContactCard_account {
    cursor: pointer;

    &:disabled {
        cursor: default;
        opacity: 0.6;
    }

    &:hover:not(:disabled),
    &:focus-visible {
        background: var(--cpd-color-bg-subtle-primary);
    }
}

.mx_ContactCard_factLabel {
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
}

.mx_ContactCard_factValue {
    font: var(--cpd-font-body-md-regular);
}

.mx_ContactCard_foot {
    display: flex;
    justify-content: center;
    padding-bottom: var(--cpd-space-6x);
}

/*
 * One section per letter, so its heading sticks within it.
 *
 * Bare headings sharing the list as their containing block all pin to the same top and overlap, which
 * both looks wrong and makes them unmeasurable: an earlier letter reports itself at the top while a
 * later one covers it, so the index could scroll forwards and never back.
 */
.mx_Contacts_section {
    display: flex;
    flex-direction: column;
}

/* The network's own disambiguating line, under what it calls them. */
.mx_ContactCard_factNote {
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-xs-regular);
}

/* The favourite star sits with the card's own chrome, beside the edit control. */
.mx_ContactCard_favourite {
    margin-inline-start: auto;
}

/* With a star present, the edit control no longer needs to claim the space itself. */
.mx_ContactCard_favourite + .mx_ContactCard_edit {
    margin-inline-start: 0;
}

/* The account row: the chat it opens, and the way out to the network's own app beside it. */
.mx_ContactCard_accountRow {
    display: flex;
    align-items: stretch;

    & + & {
        border-top: 1px solid var(--mx-contacts-hairline);
    }

    .mx_ContactCard_account {
        flex: 1;
        min-width: 0;
    }
}

.mx_ContactCard_accountLink {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    /* The platform's smallest target, so a link out is as easy to hit as the row it sits on. */
    min-width: var(--mx-contacts-row-height);
    color: var(--cpd-color-icon-secondary);

    &:hover,
    &:focus-visible {
        color: var(--cpd-color-icon-primary);
        background: var(--cpd-color-bg-subtle-primary);
    }
}

/* A name typed into the menu, which is where merging and renaming happen now. */
.mx_PersonMenu_find {
    padding: var(--cpd-space-1x) var(--cpd-space-2x);
}

/*
 * Touch and pointer, narrow and wide.
 *
 * The same screen is used with a finger on a phone and with a mouse on a desktop, and the two want
 * different things: a finger needs the platform's 44px of target and cannot hover to reveal anything, a
 * mouse can hover but is pixel-accurate and wants the chrome out of the way until it is wanted. Split on
 * `hover`/`pointer` rather than on width, because a narrow window on a desktop is still a mouse and a
 * tablet is neither.
 */
@media (hover: none), (pointer: coarse) {
    /* Every control on a row gets a finger's worth of target, not an icon's worth. */
    .mx_Contacts_rowWith .mx_Contacts_more,
    .mx_Contacts_rowWith > .mx_IconButton,
    .mx_ContactCard_accountLink {
        min-width: var(--mx-contacts-row-height);
        min-height: var(--mx-contacts-row-height);
    }

    /* Nothing reveals on hover here, so the row's own menu control is simply always there. */
    .mx_Contacts_more {
        opacity: 1;
    }

    /* The strip is wider to be draggable with a thumb, and its letters stay legible while it is. */
    .mx_Contacts_index {
        padding: 0 var(--cpd-space-2x);
    }
}

/*
 * A narrow panel, where a row cannot hold everything.
 *
 * The info button goes: it is the one control with a duplicate, since the menu on the same row carries
 * "Show <name>", and a long press reaches that menu anywhere on the row. The name and what is under it
 * keep the space instead, which is what the row is for.
 */
@container contactspanel (max-width: 420px) {
    .mx_Contacts_rowWith > .mx_IconButton:not(.mx_Contacts_more) {
        display: none;
    }

    .mx_Contacts_batch {
        flex-wrap: wrap;
    }

    .mx_Contacts_batchCount {
        flex-basis: 100%;
    }

    /* Three faces and two answers do not fit beside a sentence, so the question takes its own line. */
    .mx_Contacts_suggestion {
        flex-wrap: wrap;
    }
}

/* A press should look pressed on touch, where there is no hover to show anything is happening. */
.mx_Contacts_row:active {
    background: var(--cpd-color-bg-subtle-secondary);
}

/* Element draws its own press states; the platform's grey flash on top of them is not wanted. */
.mx_Contacts,
.mx_ContactCard {
    -webkit-tap-highlight-color: transparent;
}

/* Nothing moves for a reader who asked for nothing to move. */
@media (prefers-reduced-motion: reduce) {
    .mx_Contacts_tabs button,
    .mx_Contacts_tick,
    .mx_Contacts_more {
        transition: none;
    }
}

/*
 * The presence mark is the room list's, placed by the room list's own rules (_RoomAvatarView.pcss): the
 * avatar is masked and the indicator sits in the gap. Nothing here positions it - doing so would be a
 * second answer to a question that file already answers, and the two would drift.
 */

/* In the card the same dot sits beside the words, where there is room for both. */
.mx_ContactCard_presence {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
}

/* The filters for the calls, in one place: what to show, and what the date in the search was taken to be. */
.mx_Contacts_filterBar {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
}

.mx_Contacts_dateChip {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-1x);
    align-self: flex-start;
    min-height: 32px;
    padding: 0 var(--cpd-space-3x);
    margin: 0 var(--mx-contacts-gutter) var(--cpd-space-2x);
    border: none;
    border-radius: 99px;
    background: var(--cpd-color-bg-accent-subtle, var(--cpd-color-bg-subtle-secondary));
    color: var(--cpd-color-text-primary);
    font: var(--cpd-font-body-sm-medium);
    cursor: pointer;
}

/*
 * The colour the reader gave somebody, and the swatches to choose it from.
 *
 * Compound's decorative palette rather than colours of this screen's own: they are what the client already
 * draws avatars in, and they carry their own light and dark forms.
 */
.mx_ContactCard_colours {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--cpd-space-2x);
    padding: 0 var(--mx-contacts-gutter) var(--cpd-space-4x);
}

.mx_ContactCard_colour {
    width: 28px;
    height: 28px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 50%;
    cursor: pointer;

    &[aria-checked="true"] {
        border-color: var(--cpd-color-border-interactive-primary);
    }
}

.mx_ContactCard_colour[data-colour="1"] {
    background: var(--cpd-color-bg-decorative-1);
}
.mx_ContactCard_colour[data-colour="2"] {
    background: var(--cpd-color-bg-decorative-2);
}
.mx_ContactCard_colour[data-colour="3"] {
    background: var(--cpd-color-bg-decorative-3);
}
.mx_ContactCard_colour[data-colour="4"] {
    background: var(--cpd-color-bg-decorative-4);
}
.mx_ContactCard_colour[data-colour="5"] {
    background: var(--cpd-color-bg-decorative-5);
}
.mx_ContactCard_colour[data-colour="6"] {
    background: var(--cpd-color-bg-decorative-6);
}

/*
 * The head takes the chosen colour as a wash behind the face and the name, which is the part of the card
 * the reader sees first and the thing that tells two people of the same name apart at a glance.
 */
.mx_ContactCard_head[data-colour="1"] {
    background: var(--cpd-color-bg-decorative-1);
}
.mx_ContactCard_head[data-colour="2"] {
    background: var(--cpd-color-bg-decorative-2);
}
.mx_ContactCard_head[data-colour="3"] {
    background: var(--cpd-color-bg-decorative-3);
}
.mx_ContactCard_head[data-colour="4"] {
    background: var(--cpd-color-bg-decorative-4);
}
.mx_ContactCard_head[data-colour="5"] {
    background: var(--cpd-color-bg-decorative-5);
}
.mx_ContactCard_head[data-colour="6"] {
    background: var(--cpd-color-bg-decorative-6);
}

/* A file input that is clicked by something else: it is never the control the reader sees. */
.mx_Contacts_file {
    display: none;
}

/*
 * The tags, spaced as the room list spaces its filters: the chips are Compound's own ChatFilter, so the
 * only thing this adds is where the strip sits and how it scrolls when there are more than fit.
 */
.mx_Contacts_tags {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    padding: var(--cpd-space-1x) var(--mx-contacts-gutter) var(--cpd-space-3x);
    overflow-x: auto;
    scrollbar-width: none;

    > * {
        flex-shrink: 0;
    }
}

/* Naming a new tag, in the column rather than in a dialog over it. */
.mx_Contacts_naming {
    display: flex;
    gap: var(--cpd-space-2x);
    padding: 0 var(--mx-contacts-gutter) var(--cpd-space-2x);

    input {
        flex: 1;
        min-width: 0;
        min-height: var(--mx-contacts-row-height);
        padding: 0 var(--cpd-space-4x);
        border: none;
        border-radius: 99px;
        background: var(--cpd-color-bg-subtle-secondary);
        color: var(--cpd-color-text-primary);
        font: var(--cpd-font-body-md-regular);
    }
}

/* What an import did, said once and dismissable. */
.mx_Contacts_imported {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    margin: 0 var(--mx-contacts-gutter) var(--cpd-space-2x);
    padding: var(--cpd-space-2x) var(--cpd-space-3x);
    border: none;
    border-radius: var(--mx-contacts-inset-radius);
    background: var(--cpd-color-bg-success-subtle, var(--cpd-color-bg-subtle-secondary));
    color: var(--cpd-color-text-primary);
    font: var(--cpd-font-body-sm-medium);
    cursor: pointer;
}

/* Choosing a picture, under the face it replaces. */
.mx_ContactCard_photoPick {
    order: 2;
    padding: 0;
    border: none;
    background: none;
    color: var(--cpd-color-text-action-accent);
    font: var(--cpd-font-body-sm-medium);
    cursor: pointer;
}

/*
 * The editor: grouped blocks of compact rows, with the two answers pinned at the top.
 *
 * It used to be a column of captioned boxes, every field of every kind shown at once, and the buttons at
 * the foot of something taller than the screen - so saving meant scrolling past thirty empty inputs to
 * find the control, and so did giving up. Now: the answers are always there, the three fields nearly every
 * card has are open, and everything else is a line you press.
 */
.mx_ContactEditor {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-3x);
    padding: 0 var(--mx-contacts-gutter) var(--cpd-space-6x);
}

.mx_ContactEditor_bar {
    position: sticky;
    inset-block-start: 0;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--cpd-space-2x);
    padding: var(--cpd-space-2x) 0;
    background: var(--cpd-color-bg-canvas-default);
}

.mx_ContactEditor_group {
    display: flex;
    flex-direction: column;
    border-radius: var(--mx-contacts-inset-radius);
    background: var(--cpd-color-bg-subtle-secondary);
    overflow: hidden;
}

.mx_ContactEditor_groupHead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--mx-contacts-row-height);
    padding: 0 var(--cpd-space-3x);
    border: none;
    background: none;
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-semibold);
    cursor: pointer;

    svg {
        color: var(--cpd-color-icon-secondary);
        transition: transform 160ms ease;
    }

    &[aria-expanded="true"] svg {
        transform: rotate(180deg);
    }
}

.mx_ContactEditor_groupBody {
    display: flex;
    flex-direction: column;
    padding: var(--cpd-space-1x) 0 var(--cpd-space-2x);
}

/*
 * A row, not a boxed field: the field's own name is its placeholder and the hairline between rows is what
 * separates them, which is how a phone writes a form of thirty facts without being thirty boxes tall.
 */
.mx_ContactEditor_input,
.mx_ContactEditor_row input,
.mx_ContactEditor_row select,
.mx_ContactEditor_label {
    box-sizing: border-box;
    min-height: 36px;
    padding: var(--cpd-space-1x) var(--cpd-space-3x);
    border: none;
    background: transparent;
    color: var(--cpd-color-text-primary);
    font: var(--cpd-font-body-md-regular);
}

.mx_ContactEditor_input:not(:last-child),
.mx_ContactEditor_row:not(:last-child) {
    border-bottom: 1px solid var(--mx-contacts-hairline);
}

.mx_ContactEditor_field {
    display: flex;
    flex-direction: column;
}

.mx_ContactEditor_fieldLabel {
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-xs-regular);
}

.mx_ContactEditor_row {
    display: flex;
    align-items: center;

    input:not(.mx_ContactEditor_label) {
        flex: 1;
        min-width: 0;
    }
}

/* Narrow enough to read as the label of the value beside it rather than as a field of its own. */
.mx_ContactEditor_label {
    flex: 0 0 auto;
    width: 8rem;
    max-width: 38%;
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
}

.mx_ContactEditor_address {
    display: flex;
    flex-direction: column;
    padding: var(--cpd-space-1x) 0;

    & + & {
        border-top: 1px solid var(--mx-contacts-hairline);
    }
}

.mx_ContactEditor_remove {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-width: 36px;
    min-height: 36px;
    border: none;
    background: none;
    color: var(--cpd-color-icon-secondary);
    cursor: pointer;

    &:hover,
    &:focus-visible {
        color: var(--cpd-color-icon-critical-primary);
    }
}

.mx_ContactEditor_notes {
    min-height: 5rem;
    margin: 0 var(--cpd-space-3x);
    padding: var(--cpd-space-2x);
    border: none;
    border-radius: var(--mx-contacts-inset-radius);
    background: var(--cpd-color-bg-canvas-default);
    color: var(--cpd-color-text-primary);
    font: var(--cpd-font-body-md-regular);
    resize: vertical;
}

/* What a lookup would disclose, before it happens, and what it found after. */
.mx_Contacts_discover {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    margin: 0 var(--mx-contacts-gutter) var(--cpd-space-2x);
    padding: var(--cpd-space-3x);
    border-radius: var(--mx-contacts-inset-radius);
    background: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-text-primary);
    font: var(--cpd-font-body-sm-regular);

    span {
        flex: 1;
        min-width: 0;
    }
}

/*
 * One line about the duplicates, above the names, opening the screen that holds them.
 *
 * A phone puts this here and the cards themselves elsewhere: deciding who is who is a job you sit down to,
 * and a stack of unanswered questions in front of the address book makes it harder to use every time.
 */
.mx_Contacts_duplicates {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
    box-sizing: border-box;
    min-height: var(--mx-contacts-row-height);
    padding: var(--cpd-space-3x) var(--mx-contacts-gutter);
    margin: 0 var(--mx-contacts-gutter) var(--cpd-space-3x);
    border: none;
    border-radius: var(--mx-contacts-inset-radius);
    background: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-text-primary);
    text-align: start;
    cursor: pointer;

    svg {
        flex-shrink: 0;
        color: var(--cpd-color-icon-secondary);
    }
}

/* Merge all, or ignore all: the two answers to the whole screen. */
.mx_Contacts_reviewActions {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
    padding: var(--cpd-space-4x) var(--mx-contacts-gutter);
    padding-bottom: var(--mx-room-list-toast-bottom, var(--cpd-space-8x));
}

/* The column's own contents, which a layer covers: laid out as if this wrapper were not there. */
.mx_Contacts_under {
    display: contents;
}

/*
 * A screen over the column rather than in place of it.
 *
 * What is underneath keeps its scroll, which is the whole reason for the layer: swapping the list out for
 * a card unmounted it, and a list that unmounts comes back at the top - so opening somebody near the
 * bottom and pressing back put the reader at A again.
 */
.mx_Contacts_layer,
.mx_Contacts_adding {
    position: absolute;
    inset: 0;
    z-index: 4;
    display: flex;
    flex-direction: column;
    background: var(--cpd-color-bg-canvas-default);
    /*
     * In from the side and back out again, on the animation a chat already uses when it takes over a
     * handheld screen (mx_TgSheet_in/out in _TgHandheld.pcss and _TgPanes.pcss). The same motion and the
     * same timings, because this is the same gesture: something covers the column, and back returns it.
     */
    animation: mx_TgSheet_in var(--tg-transition-standard-in, 200ms ease);
}

/* Going back: the layer leaves the way it came, and stops taking presses while it does. */
.mx_Contacts_layer[data-leaving],
.mx_Contacts_adding[data-leaving] {
    animation: mx_TgSheet_out var(--tg-transition-standard-out, 150ms ease) forwards;
    pointer-events: none;
}

@media (prefers-reduced-motion: reduce) {
    .mx_Contacts_layer,
    .mx_Contacts_adding {
        animation: none;
    }
}

.mx_Contacts_adding {
    overflow-y: auto;
}

/* Whether the client has checked who they are: the one line on a card only Matrix can write. */
.mx_ContactCard_verification {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-1x);
    padding: 2px var(--cpd-space-2x);
    border: none;
    border-radius: 99px;
    background: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-medium);
    cursor: pointer;

    &:disabled {
        cursor: default;
    }

    &[data-state="verified"] {
        color: var(--cpd-color-text-success-primary);
    }

    &[data-state="changed"] {
        color: var(--cpd-color-text-critical-primary);
    }
}

/*
 * A card in the duplicates view: the tick that keeps it in the merge, and the rest of the row that opens
 * the person. Two controls because there are two things to do, and doing one must not do the other.
 */
.mx_Contacts_suggestionCard {
    display: flex;
    align-items: center;

    & + & {
        border-top: 1px solid var(--mx-contacts-hairline);
    }
}

.mx_Contacts_suggestionTick {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    min-width: var(--mx-contacts-row-height);
    min-height: var(--mx-contacts-row-height);
    border: none;
    background: none;
    cursor: pointer;

    .mx_Contacts_tick {
        position: static;
        border: none;
    }
}

.mx_Contacts_suggestionOpen {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
    flex: 1;
    min-width: 0;
    min-height: var(--mx-contacts-row-height);
    padding: var(--cpd-space-1x) var(--cpd-space-3x) var(--cpd-space-1x) 0;
    border: none;
    background: none;
    color: var(--cpd-color-text-primary);
    text-align: start;
    cursor: pointer;

    &:hover:not(:disabled),
    &:focus-visible {
        background: var(--cpd-color-bg-subtle-primary);
    }

    svg {
        flex-shrink: 0;
        color: var(--cpd-color-icon-secondary);
    }
}

/* What publishing to a Matrix profile means, said before anything is published. */
.mx_Contacts_publishWhy {
    margin: 0;
    padding: var(--cpd-space-3x) var(--mx-contacts-gutter);
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
}

.mx_Contacts_publishRow {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-3x);
    min-height: var(--mx-contacts-row-height);
    padding: 0 var(--mx-contacts-gutter);
    cursor: pointer;

    & + & {
        border-top: 1px solid var(--mx-contacts-hairline);
    }
}

/* A section that needs saying what it is: the others are recognised by what is in them. */
.mx_ContactCard_sectionTitle {
    margin: 0;
    padding: var(--mx-contacts-row-padding-block) var(--mx-contacts-gutter);
    border-bottom: 1px solid var(--cpd-color-bg-subtle-primary);
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-semibold);
}

/*
 * The versions of a card, as a password manager lists an entry's history.
 *
 * Rows of "when, and what changed", each opening that version; the version itself is the same grouped block
 * of labelled lines the card uses, with the lines that differ from the current card marked.
 */
.mx_ContactHistory {
    display: flex;
    flex-direction: column;
}

.mx_ContactHistory_row {
    display: flex;
    flex-direction: column;
    gap: 2px;
    width: 100%;
    box-sizing: border-box;
    min-height: var(--mx-contacts-row-height);
    justify-content: center;
    padding: var(--mx-contacts-row-padding-block) var(--mx-contacts-gutter);
    border: none;
    background: transparent;
    color: var(--cpd-color-text-primary);
    text-align: start;
    font: inherit;
    cursor: pointer;

    & + & {
        border-top: 1px solid var(--cpd-color-bg-subtle-primary);
    }

    &:hover,
    &:focus-visible {
        background: var(--cpd-color-bg-subtle-primary);
    }
}

.mx_ContactHistory_stamp {
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
}

.mx_ContactHistory_changed {
    font: var(--cpd-font-body-md-regular);
    /* One line of it: the list of changed fields can be long, and it is a hint, not the content. */
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
}

.mx_ContactHistory_footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--cpd-space-2x);
    padding: var(--mx-contacts-row-padding-block) var(--mx-contacts-gutter);
    border-top: 1px solid var(--cpd-color-bg-subtle-primary);
}

.mx_ContactHistory_kept {
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-xs-regular);
}

.mx_ContactHistory_versionHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--cpd-space-2x);
    padding: var(--mx-contacts-row-padding-block) var(--mx-contacts-gutter);
    border-bottom: 1px solid var(--cpd-color-bg-subtle-primary);
}

.mx_ContactHistory_back {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-1x);
    /* The same negative start inset the chevron gets elsewhere, so the glyph lines up with the text under it
       rather than the text box does. */
    margin-inline-start: calc(-1 * var(--cpd-space-1x));
    padding: 0;
    border: none;
    background: none;
    color: var(--cpd-color-text-action-accent);
    font: var(--cpd-font-body-sm-semibold);
    cursor: pointer;
}

.mx_ContactHistory_lines {
    display: flex;
    flex-direction: column;
}

.mx_ContactHistory_line {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: var(--mx-contacts-row-padding-block) var(--mx-contacts-gutter);

    & + & {
        border-top: 1px solid var(--cpd-color-bg-subtle-primary);
    }

    /*
     * A line that differs from what the card says now, marked with a bar in the margin rather than a colour
     * over the text: the values are what is being read, and tinting them would make an old address look like
     * a warning about the address rather than a note about the version.
     */
    &[data-changed] {
        box-shadow: inset 2px 0 0 0 var(--cpd-color-icon-accent-primary);
    }
}

.mx_ContactHistory_lineLabel {
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
}

.mx_ContactHistory_lineValue {
    font: var(--cpd-font-body-md-regular);
    /* Notes are the one field that can be a paragraph, so lines wrap rather than run off the block. */
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}

.mx_ContactHistory_none {
    padding: var(--mx-contacts-row-padding-block) var(--mx-contacts-gutter);
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-regular);
}

.mx_ContactHistory_actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cpd-space-2x);
    padding: var(--mx-contacts-row-padding-block) var(--mx-contacts-gutter);
    border-top: 1px solid var(--cpd-color-bg-subtle-primary);
}
