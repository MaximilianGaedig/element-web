/*
 * The model's answer in the timeline (TgAiNote.tsx): an incoming message, because that is the shape a
 * chat is read in and anything else in the middle of it reads as an advert.
 *
 * So it takes the incoming bubble exactly - the same surface, the same corner radius, the same indent
 * from the avatar column - and earns its difference with one thing instead of a frame: a sparkle, lit by
 * a slow gradient, and a sheen that crosses the bubble only while the words are still arriving. The
 * "only you" line is what says it is not a message everyone can see; the chrome does not need to shout it.
 */
.mx_TgAiNote {
    position: relative;
    box-sizing: border-box;
    width: fit-content;
    max-width: min(30rem, 78%);
    margin: var(--cpd-space-1x) 0 var(--cpd-space-1x) calc(var(--TgSenderRun-inset, 8px) + 2.875rem);
    padding: var(--cpd-space-2x) var(--cpd-space-3x);
    border-radius: var(--event-tile-bubble-corner-radius, 12px);
    background: var(--event-tile-bubble-other-background, var(--cpd-color-bg-subtle-secondary));
    color: var(--cpd-color-text-primary);
    font: var(--cpd-font-body-md-regular);
    /* The sheen is painted over the bubble, so it has to be cut to the bubble's corners. */
    overflow: hidden;

    .mx_TgAiNote_head {
        display: flex;
        flex-wrap: wrap;
        align-items: baseline;
        gap: var(--cpd-space-2x);
        margin-block-end: var(--cpd-space-1x);
    }

    /*
     * The one magical thing: the sparkle is painted with the gradient rather than a flat accent, and it
     * drifts. Everything else in here is an ordinary message.
     */
    .mx_TgAiNote_spark {
        width: 1em;
        height: 1em;
        color: #7a5cff;
        animation: mx_TgAiNote_spark 4s ease-in-out infinite;
    }

    .mx_TgAiNote_who {
        font: var(--cpd-font-body-xs-medium);
        color: var(--cpd-color-text-secondary);
    }

    .mx_TgAiNote_question {
        font: var(--cpd-font-body-sm-medium);
        color: var(--cpd-color-text-primary);
    }

    .mx_TgAiNote_text {
        margin: 0;

        /* Markdown, rendered by the message pipeline: its lists and paragraphs need sane spacing. */
        :is(p, ul, ol) {
            margin: 0 0 var(--cpd-space-1x);
        }

        :is(ul, ol) {
            padding-inline-start: var(--cpd-space-5x);
        }

        > :last-child {
            margin-block-end: 0;
        }
    }

    .mx_TgAiNote_looking {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-1x);
        margin: 0 0 var(--cpd-space-1x);
        font: var(--cpd-font-body-sm-regular);
        color: var(--cpd-color-text-secondary);

        svg {
            width: 1em;
            height: 1em;
        }
    }

    /* The info button: the smallest thing in the header, and the only new affordance. */
    .mx_TgAiNote_info {
        margin-inline-start: auto;
        color: var(--cpd-color-text-secondary);

        svg {
            display: block;
            width: 16px;
            height: 16px;
        }

        &:hover {
            color: var(--cpd-color-text-primary);
        }
    }

    /*
     * What was sent, opened: the messages themselves, inset from the answer so it reads as a footnote to
     * it rather than more of it. Each row is the sender and the start of what they said, and pressing it
     * goes there - the quickest way to check an answer is to look at what it was given.
     */
    .mx_TgAiNote_sentPanel {
        margin-block-start: var(--cpd-space-2x);
        padding-block-start: var(--cpd-space-2x);
        border-block-start: 1px solid var(--cpd-color-border-interactive-secondary);
    }

    .mx_TgAiNote_sentWhat {
        margin: 0;
        font: var(--cpd-font-body-xs-regular);
        color: var(--cpd-color-text-secondary);
    }

    .mx_TgAiNote_sentList {
        margin: var(--cpd-space-1x) 0 0;
        padding: 0;
        list-style: none;
        max-height: 12rem;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .mx_TgAiNote_sentOne {
        display: flex;
        gap: var(--cpd-space-2x);
        width: 100%;
        padding: 2px 0;
        font: var(--cpd-font-body-xs-regular);
        color: var(--cpd-color-text-secondary);
        text-align: start;

        &:hover {
            color: var(--cpd-color-text-primary);
        }
    }

    .mx_TgAiNote_sentWho {
        flex: 0 0 auto;
        max-width: 8rem;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font: var(--cpd-font-body-xs-medium);
    }

    .mx_TgAiNote_sentBody {
        flex: 1 1 auto;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .mx_TgAiNote_unsure {
        margin: var(--cpd-space-1x) 0 0;
        font: var(--cpd-font-body-sm-regular);
        color: var(--cpd-color-text-secondary);
    }

    .mx_TgAiNote_cites {
        display: flex;
        flex-wrap: wrap;
        gap: var(--cpd-space-2x);
        margin: var(--cpd-space-2x) 0 0;
    }

    .mx_TgAiNote_cite {
        font: var(--cpd-font-body-sm-medium);
        color: var(--cpd-color-text-action-accent);
    }

    /* Below the words, the way a message's own footer sits: small, quiet, no buttons shouting. */
    .mx_TgAiNote_actions {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-3x);
        margin-block-start: var(--cpd-space-2x);
    }

    .mx_TgAiNote_action {
        display: inline-flex;
        align-items: center;
        gap: var(--cpd-space-1x);
        font: var(--cpd-font-body-sm-medium);
        color: var(--cpd-color-text-secondary);

        &:hover {
            color: var(--cpd-color-text-primary);
        }

        svg {
            width: 1em;
            height: 1em;
        }
    }
}

/*
 * Being written: a sheen crosses the bubble, once every pass, and stops the moment the answer is whole.
 * It is the only motion, it is behind the words, and it never moves the layout.
 */
.mx_TgAiNote_writing {
    &::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(110deg, transparent 30%, rgb(122 92 255 / 22%) 50%, transparent 70%);
        background-size: 250% 100%;
        animation: mx_TgAiNote_sheen 1.8s linear infinite;
        pointer-events: none;
    }

    > * {
        position: relative;
        z-index: 1;
    }
}

@keyframes mx_TgAiNote_sheen {
    from {
        background-position-x: 150%;
    }

    to {
        background-position-x: -150%;
    }
}

@keyframes mx_TgAiNote_spark {
    0%,
    100% {
        color: #7a5cff;
    }

    35% {
        color: #2bb3ff;
    }

    70% {
        color: #ff7ac0;
    }
}

/* Somebody who has asked not to be moved should not be: no sheen, no drift. */
@media (prefers-reduced-motion: reduce) {
    .mx_TgAiNote_writing::after,
    .mx_TgAiNote .mx_TgAiNote_spark {
        animation: none;
    }
}
