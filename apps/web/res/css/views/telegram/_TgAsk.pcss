/*
 * Asking about the chat: a pill floating over the conversation (TgAsk.tsx).
 *
 * It stays a pill. The answer does not appear in here - it arrives in the timeline, as a message, where
 * an answer belongs; this only says what is happening while it happens. A floating card repeating the
 * same words in a different shape was two things to read, and the one over the conversation was the one
 * that looked like an advert.
 *
 * It floats rather than pushing the timeline down, because a conversation that jumps every time you ask
 * something is a conversation you stop asking about.
 */
.mx_TgAsk {
    position: relative;
    z-index: 3;
    display: flex;
    align-self: center;
    align-items: center;
    gap: var(--cpd-space-2x);
    width: fit-content;
    max-width: min(46rem, calc(100% - var(--cpd-space-8x)));
    margin: 0 auto calc(var(--cpd-space-1x) * -1);
    padding: var(--cpd-space-1x) var(--cpd-space-2x);
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    border-radius: 99px;
    background: var(--tg-glass-background, var(--cpd-color-bg-canvas-default));
    backdrop-filter: var(--tg-glass-backdrop, blur(24px));
    box-shadow: 0 2px 12px rgb(0 0 0 / 8%);
    font: var(--cpd-font-body-sm-regular);
    /* The morph itself: the same curve the rest of the Telegram layout moves on. */
    transition:
        max-width var(--tg-transition-standard-out),
        padding var(--tg-transition-standard-out),
        background-color var(--tg-transition-standard-out);

    .mx_TgAsk_catchUp {
        display: inline-flex;
        align-items: center;
        gap: var(--cpd-space-1x);
        padding: var(--cpd-space-1x) var(--cpd-space-3x);
        border: none;
        border-radius: 99px;
        background: none;
        font: var(--cpd-font-body-sm-medium);
        white-space: nowrap;

        svg {
            width: 1em;
            height: 1em;
        }
    }

    .mx_TgAsk_open_button {
        color: var(--cpd-color-text-secondary);
        white-space: nowrap;
    }

    .mx_TgAsk_form {
        display: flex;
        flex: 1;
        align-items: center;
        gap: var(--cpd-space-2x);
        min-width: 0;
    }

    .mx_TgAsk_input {
        flex: 1;
        min-width: 0;
        padding: var(--cpd-space-1x) var(--cpd-space-2x);
        border: none;
        background: none;
        font: var(--cpd-font-body-md-regular);
        color: var(--cpd-color-text-primary);

        &:focus {
            outline: none;
        }
    }

    .mx_TgAsk_send {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        padding: 0;
        border-radius: 99px;

        svg {
            width: 1em;
            height: 1em;
        }
    }

    .mx_TgAsk_failed {
        margin: 0;
        color: var(--cpd-color-text-critical-primary);
    }
}

/* Asked: room for a question, still a pill. */
.mx_TgAsk_asking {
    max-width: min(46rem, calc(100% - var(--cpd-space-8x)));
    width: min(34rem, calc(100% - var(--cpd-space-8x)));
}

/* While it is working: the pill says what is happening, with the sparkle lit the way the answer's is. */
.mx_TgAsk_doing {
    display: inline-flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    margin: 0;
    padding: var(--cpd-space-1x) var(--cpd-space-2x);
    font: var(--cpd-font-body-sm-medium);
    color: var(--cpd-color-text-secondary);

    svg {
        width: 1em;
        height: 1em;
        color: #7a5cff;
        animation: mx_TgAiNote_spark 4s ease-in-out infinite;
    }
}

@media (prefers-reduced-motion: reduce) {
    .mx_TgAsk {
        transition: none;
    }

    .mx_TgAsk_doing svg {
        animation: none;
    }
}
