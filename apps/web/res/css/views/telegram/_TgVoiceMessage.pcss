/*
 * A voice message in a bubble, laid out like Telegram Web K's (GPL-3.0, https://github.com/morethanwords/tweb,
 * src/scss/partials/_audio.scss): a round accent play button at the start, the waveform beside it, and
 * under the waveform the time (and a dot while nobody has played it). The speed button joins the time while
 * the message plays. The elements are Element's own (RecordingPlayback.tsx); only the grid they sit in and
 * their looks are changed here.
 *
 * The seek bar is Element's range input laid over the waveform, so a press or a drag anywhere on the
 * waveform moves the playing position, and the arrow keys skip five seconds.
 */

[data-bubble-timeline="true"] .mx_EventTile .mx_MVoiceMessageBody {
    display: block;
    min-width: 0;
    max-width: 100%;

    /* The bubble is the box: no panel of its own inside it. */
    .mx_VoiceMessagePrimaryContainer.mx_MediaBody {
        --TgVoice-button-size: 2.75rem;

        display: grid;
        grid-template-columns: var(--TgVoice-button-size) minmax(0, 1fr);
        grid-template-areas:
            "play wave"
            "play meta";
        align-items: center;
        column-gap: var(--cpd-space-3x);
        row-gap: 0;
        box-sizing: border-box;
        /* As wide as the bubble, which is never narrower than a waveform needs, and grows with a transcript. */
        width: 100%;
        min-width: min(16.5rem, 70vw);
        max-width: 100%;
        margin: 0;
        padding: var(--cpd-space-1x) 0 0;
        border: 0;
        border-radius: 0;
        background: none;
        contain: none;
        /* Beats the end padding every media body in a bubble is given for the time (_TelegramMessages.pcss). */
        padding-inline-end: 0 !important;
        padding-block-end: 0;
    }

    .mx_PlayPauseButton {
        grid-area: play;
        align-self: start;
        width: var(--TgVoice-button-size);
        height: var(--TgVoice-button-size);
        min-width: 0;
        min-height: 0;
        padding: 0;
        border-radius: 50%;
        background-color: var(--cpd-color-bg-accent-rest);
        color: var(--cpd-color-icon-on-solid-primary);
        transition: background-color 0.15s;

        &:hover:not([disabled]) {
            background-color: var(--cpd-color-bg-accent-hovered);
        }

        svg {
            width: 1.75rem;
            height: 1.75rem;
        }
    }

    .mx_RecordingPlayback_timelineLayoutMiddle {
        grid-area: wave;
        position: relative;
        display: block;
        min-width: 0;
        height: 1.75rem;
        margin: 0;

        .mx_Waveform {
            position: absolute;
            inset: 0;
            top: 0;
            height: 100%;
            justify-content: space-between;
            overflow: visible;
        }

        /* Rounded bars of a fixed width spread over the whole width, as tweb draws them. */
        .mx_Waveform_bar {
            flex: 0 0 3px;
            width: 3px;
            height: 100%;
            margin: 0;
            border: 0;
            border-radius: 3px;
            /* Never thinner than a dot, so silence still shows where the message is. */
            transform: scaleY(max(0.14, var(--barHeight)));
            background-color: color-mix(in srgb, var(--cpd-color-text-secondary) 40%, transparent);
            transition: background-color 0.1s;

            &.mx_Waveform_bar_100pct {
                background-color: var(--cpd-color-bg-accent-rest);
            }
        }

        /* Over the whole waveform and a little beyond it, so the ends are easy to hit. */
        .mx_SeekBar {
            inset: -0.25rem -0.125rem;
            width: calc(100% + 0.25rem);
            height: calc(100% + 0.5rem);
            margin: 0;
            opacity: 0;
            cursor: pointer;
        }
    }

    .mx_RecordingPlayback_meta {
        grid-area: meta;
        display: flex;
        align-items: center;
        gap: var(--cpd-space-1x);
        min-width: 0;
        font: var(--cpd-font-body-sm-regular);
        color: var(--cpd-color-text-secondary);

        .mx_Clock {
            width: auto;
            min-width: 0;
            padding: 0;
            font-variant-numeric: tabular-nums;
            text-align: start;
        }
    }

    /* Nothing under the message: the bubble's time sits at the end of this row. */
    &:not(:has(.mx_TgTranscript, .mx_TgTranscript_button)) .mx_RecordingPlayback_meta {
        padding-inline-end: calc(var(--TgTime-width, 0px) + 0.1875rem);
    }

    /* Telegram's "not listened to yet" dot: an accent circle after the time. */
    .mx_RecordingPlayback_unplayed {
        flex: 0 0 auto;
        width: 0.4375rem;
        height: 0.4375rem;
        border-radius: 50%;
        background-color: var(--cpd-color-bg-accent-rest);
    }

    /* The speed: a small chip that is there while the message plays or is paused part way. */
    .mx_RecordingPlayback_speed {
        margin-inline-start: auto;
        padding: 0 var(--cpd-space-1-5x);
        border: 0;
        border-radius: 0.625rem;
        background-color: color-mix(in srgb, var(--cpd-color-bg-accent-rest) 18%, transparent);
        color: var(--cpd-color-text-action-accent);
        font: var(--cpd-font-body-xs-semibold);
        line-height: 1.25rem;
        font-variant-numeric: tabular-nums;
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transition:
            opacity 0.15s,
            visibility 0.15s;

        &:hover {
            background-color: color-mix(in srgb, var(--cpd-color-bg-accent-rest) 28%, transparent);
        }
    }

    .mx_VoiceMessagePrimaryContainer:is([data-playback-phase="playing"], [data-playback-phase="paused"]) {
        .mx_RecordingPlayback_speed {
            opacity: 1;
            visibility: visible;
        }
    }
}
