/*
 * Chat info laid out like Telegram Web K's profile tab (TgProfile.tsx). Ported from tweb (GPL-3.0):
 *   src/scss/partials/_profile.scss  .profile-avatar / -name / -subtitle
 *   src/scss/partials/_row.scss      .row, .row-grid, .row-icon ($row-border-radius 16px)
 *   src/scss/partials/_section.scss  .sidebar-left-section (.5rem block padding)
 *   src/scss/partials/_slider.scss   .menu-horizontal-div(-item) and its sliding background
 */
.mx_TgProfile {
    display: flex;
    flex-direction: column;
    color: var(--cpd-color-text-primary);
}

.mx_TgProfile_header {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 0 var(--cpd-space-4x);
}

.mx_TgProfile_avatar {
    margin: 0.5rem auto 10px;
    flex: 0 0 auto;
}

.mx_TgProfile_name {
    text-align: center;
    font-size: 20px;
    line-height: 24px;
    font-weight: var(--cpd-font-weight-semibold);
    max-width: 21.25rem;
    min-width: 0;
    margin: 0 auto;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

.mx_TgProfile_subtitle {
    text-align: center;
    color: var(--tg-secondary-text-color);
    font-size: 14px;
    line-height: 20px;
    margin-top: 1px;
    margin-bottom: 0.875rem;

    .mx_LastSeen {
        font: inherit;
    }
}

.mx_TgProfile_online {
    color: var(--tg-primary-color);
}

.mx_TgProfile_section {
    padding: 0.5rem;
    border-top: 1px solid var(--cpd-color-border-disabled);
    border-bottom: 1px solid var(--cpd-color-border-disabled);
}

.mx_TgRow {
    display: grid;
    grid-template-columns: 3.5rem 1fr auto;
    grid-template-areas:
        "left title right"
        "left subtitle right";
    align-items: center;
    width: 100%;
    min-height: 3.5rem;
    padding: 0.375rem 1rem 0.375rem 0;
    border: none;
    border-radius: var(--tg-border-radius-medium);
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    box-sizing: border-box;
    transition: opacity var(--tg-transition-standard-in);

    &.mx_TgRow--noSubtitle {
        grid-template-areas: "left title right";
    }
}

button.mx_TgRow {
    cursor: pointer;

    &:hover {
        background-color: var(--cpd-color-bg-action-tertiary-hovered);
    }
}

.mx_TgRow_icon {
    grid-area: left;
    display: flex;
    justify-content: center;
    align-items: center;
    color: var(--tg-secondary-text-color);

    > svg {
        width: 1.5rem;
        height: 1.5rem;
    }
}

.mx_TgRow_title {
    grid-area: title;
    font-size: var(--cpd-font-size-body-lg);
    line-height: 1.3125;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_TgRow_preWrap {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}

.mx_TgRow_subtitle {
    grid-area: subtitle;
    font-size: 14px;
    line-height: 18px;
    color: var(--tg-secondary-text-color);
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_TgRow_right {
    grid-area: right;
    margin-inline-start: 0.5rem;
}

.mx_TgTabs {
    display: flex;
    flex-direction: column;
    padding-top: 0.5rem;
}

/* tweb .menu-horizontal-scrollable: the tabs keep their width and the strip scrolls sideways. */
.mx_TgTabs_menu {
    position: relative;
    display: flex;
    padding: 0 0.25rem;
    margin-bottom: 0.5rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scrollbar-width: none;

    &::-webkit-scrollbar {
        display: none;
    }
}

.mx_TgTabs_item {
    position: relative;
    z-index: 2;
    flex: 1 0 auto;
    height: 2.5rem;
    margin: 0 0.25rem;
    padding: 0 1rem;
    border: none;
    border-radius: 1.25rem;
    background: none;
    color: var(--tg-secondary-text-color);
    font: inherit;
    font-size: 1rem;
    font-weight: var(--cpd-font-weight-semibold);
    cursor: pointer;
    white-space: nowrap;
    transition: background-color var(--tg-tabs-transition);

    &[aria-selected="true"] {
        color: var(--tg-primary-color);
    }
}

.mx_TgTabs_pill {
    position: absolute;
    left: 0;
    top: 0;
    height: 2.5rem;
    z-index: 1;
    border-radius: 1.25rem;
    /* tweb --light-filled-primary-color: a light fill of the primary colour. */
    background-color: color-mix(in srgb, var(--tg-primary-color) 12%, transparent);
    pointer-events: none;

    &[data-animate] {
        transition:
            transform var(--tg-tabs-transition),
            width var(--tg-tabs-transition);
    }
}

.mx_TgProfile_mediaPlaceholder {
    padding: 0 0.5rem;

    > p {
        margin: 1rem;
        color: var(--tg-secondary-text-color);
        text-align: center;
    }
}

.mx_TgProfile_members {
    padding: 0 0.5rem;
}

.mx_TgProfile_member .mx_TgRow_icon {
    padding-inline-start: 0.5rem;
}

html[data-tg-screen="mobile"] .mx_TgProfile_avatar {
    width: 100px !important;
    height: 100px !important;
}

.mx_TgStats {
    border-top: none;
}

.mx_TgStats_sender {
    min-height: 2.75rem;
}

.mx_TgStats_bar {
    display: block;
    height: 0.25rem;
    margin-top: 0.25rem;
    border-radius: 0.125rem;
    background: var(--cpd-color-bg-subtle-primary);
    overflow: hidden;
}

.mx_TgStats_barFill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--tg-primary-color);
}

.mx_TgStats_count {
    font: var(--cpd-font-body-md-regular);
    color: var(--cpd-color-text-secondary);
    font-variant-numeric: tabular-nums;
}

.mx_TgStats_more {
    color: var(--cpd-color-text-secondary);
}

/* ---- Chat history: card, header line, pill ---------------------------------------------------- */

@keyframes mx_History_spin {
    to {
        transform: rotate(360deg);
    }
}

@keyframes mx_History_indeterminate {
    0% {
        transform: translateX(-100%);
    }

    100% {
        transform: translateX(250%);
    }
}

/* A ring that turns while the import runs; other phases use an icon in the same slot. */
.mx_HistoryPhaseIcon {
    flex: 0 0 auto;
    width: 1.5rem;
    height: 1.5rem;
    color: var(--cpd-color-icon-secondary);
}

.mx_HistoryPhaseIcon--spin {
    box-sizing: border-box;
    border: 2.5px solid color-mix(in srgb, var(--tg-primary-color) 25%, transparent);
    border-top-color: var(--tg-primary-color);
    border-radius: 50%;
    animation: mx_History_spin 0.9s linear infinite;
}

.mx_HistoryCard {
    margin: 0.75rem 0.75rem 0;
    padding: 1rem;
    border-radius: 1rem;
    background: var(--cpd-color-bg-subtle-secondary);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.mx_HistoryCard_header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.mx_HistoryCard_text {
    flex: 1 1 auto;
    min-width: 0;
}

.mx_HistoryCard_title {
    margin: 0;
    font: var(--cpd-font-body-lg-semibold);
    color: var(--cpd-color-text-primary);
}

.mx_HistoryCard_subtitle {
    margin: 0.125rem 0 0;
    font: var(--cpd-font-body-md-regular);
    color: var(--cpd-color-text-secondary);
}

.mx_HistoryCard_badge {
    flex: 0 0 auto;
    padding: 0.125rem 0.625rem;
    border-radius: 1rem;
    font: var(--cpd-font-body-sm-semibold);
    color: var(--cpd-color-text-secondary);
    background: var(--cpd-color-bg-canvas-default);
}

.mx_HistoryCard--importing .mx_HistoryCard_badge {
    color: var(--tg-primary-color);
    background: color-mix(in srgb, var(--tg-primary-color) 14%, transparent);
}

.mx_HistoryCard--complete {
    .mx_HistoryCard_badge,
    .mx_HistoryPhaseIcon {
        color: var(--cpd-color-text-success-primary);
    }

    .mx_HistoryCard_badge {
        background: color-mix(in srgb, var(--cpd-color-text-success-primary) 14%, transparent);
    }
}

.mx_HistoryCard--paused {
    .mx_HistoryCard_badge,
    .mx_HistoryPhaseIcon {
        color: var(--cpd-color-text-critical-primary);
    }

    .mx_HistoryCard_badge {
        background: color-mix(in srgb, var(--cpd-color-text-critical-primary) 12%, transparent);
    }
}

.mx_HistoryCard_progress {
    display: flex;
    align-items: center;
    gap: 0.75rem;
}

.mx_HistoryBar {
    position: relative;
    flex: 1 1 auto;
    height: 0.5rem;
    overflow: hidden;
    border-radius: 0.25rem;
    background: color-mix(in srgb, var(--cpd-color-text-secondary) 20%, transparent);
}

.mx_HistoryBar_fill {
    display: block;
    height: 100%;
    border-radius: inherit;
    background: var(--tg-primary-color);
    transition: width 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
}

.mx_HistoryCard--complete .mx_HistoryBar_fill {
    background: var(--cpd-color-text-success-primary);
}

.mx_HistoryCard--queued .mx_HistoryBar_fill {
    background: var(--cpd-color-text-secondary);
}

.mx_HistoryBar--indeterminate .mx_HistoryBar_fill {
    width: 40%;
    animation: mx_History_indeterminate 1.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

.mx_HistoryCard_percent {
    flex: 0 0 auto;
    min-width: 2.5rem;
    text-align: end;
    font: var(--cpd-font-body-md-semibold);
    font-variant-numeric: tabular-nums;
    color: var(--cpd-color-text-primary);
}

.mx_HistoryCard_stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7.5rem, 1fr));
    gap: 0.75rem 1rem;
    margin: 0;
}

.mx_HistoryCard_stat {
    dt {
        font: var(--cpd-font-body-sm-regular);
        color: var(--cpd-color-text-secondary);
    }

    dd {
        margin: 0.125rem 0 0;
        font: var(--cpd-font-body-md-semibold);
        font-variant-numeric: tabular-nums;
        color: var(--cpd-color-text-primary);
    }
}

/* A filled, full-width button: the one action, and a 48px target on a phone. */
.mx_HistoryCard_action {
    all: unset;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    min-height: 3rem;
    border-radius: 0.875rem;
    background: var(--tg-primary-color);
    color: var(--cpd-color-text-on-solid-primary, #fff);
    font: var(--cpd-font-body-md-semibold);
    cursor: pointer;

    &:hover:not(:disabled) {
        filter: brightness(1.08);
    }

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        outline-offset: 2px;
    }

    &:disabled {
        opacity: 0.6;
        cursor: default;
    }
}

@media (prefers-reduced-motion: reduce) {
    .mx_HistoryPhaseIcon--spin,
    .mx_HistoryBar--indeterminate .mx_HistoryBar_fill {
        animation-duration: 3s;
    }

    .mx_HistoryBar_fill {
        transition: none;
    }
}

/* Handhelds: the card runs edge to edge inside the sheet with a little more air. */
html[data-tg-screen="mobile"] .mx_HistoryCard {
    margin: 0.75rem 1rem 0;
    padding: 1.125rem 1rem;
}

/* A settled history (all imported, skipped, nothing to import) is one line, a verification. */
.mx_HistoryCompact {
    margin: 0.5rem 0.75rem 0;
    border-radius: 0.875rem;
    background: var(--cpd-color-bg-subtle-secondary);

    details[open] .mx_HistoryCompact_chevron {
        transform: rotate(180deg);
    }
}

.mx_HistoryCompact_summary {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.875rem;
    list-style: none;
    cursor: pointer;
    font: var(--cpd-font-body-md-semibold);
    color: var(--cpd-color-text-primary);

    &::-webkit-details-marker {
        display: none;
    }

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        border-radius: 0.875rem;
    }
}

.mx_HistoryCompact_text {
    flex: 1 1 auto;
    min-width: 0;
}

.mx_HistoryCompact_chevron {
    flex: 0 0 auto;
    width: 1.25rem;
    height: 1.25rem;
    color: var(--cpd-color-icon-secondary);
    transition: transform 0.2s ease;
}

.mx_HistoryCompact--complete .mx_HistoryPhaseIcon {
    color: var(--cpd-color-text-success-primary);
}

.mx_HistoryCompact_details {
    padding: 0 0.875rem 0.75rem 2.75rem;
}

.mx_HistoryCompact .mx_HistoryCard_action {
    margin: 0 0.875rem 0.875rem;
}

.mx_HistoryCard_secondary {
    all: unset;
    align-self: flex-start;
    min-height: 2.25rem;
    padding: 0 0.25rem;
    font: var(--cpd-font-body-md-semibold);
    color: var(--cpd-color-text-secondary);
    cursor: pointer;

    &:hover:not(:disabled) {
        color: var(--cpd-color-text-primary);
    }

    &:disabled {
        opacity: 0.5;
        cursor: default;
    }

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        border-radius: 0.5rem;
    }
}

/* ---- The import banner: a plate like the pinned messages, under them --------------------------- */

.mx_TgImport {
    position: relative;
    display: flex;
    align-items: center;
    box-sizing: border-box;
    min-height: 3rem;
    width: 100%;
    overflow: hidden;
    background: var(--cpd-color-bg-canvas-default);
    border-bottom: 1px solid var(--cpd-color-border-disabled);
    flex: 0 0 auto;
}

.mx_TgImport_main {
    all: unset;
    box-sizing: border-box;
    display: flex;
    flex: 1 1 auto;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    min-height: 3rem;
    padding: 0.375rem 1rem;
    cursor: pointer;

    &:hover {
        background: var(--cpd-color-bg-action-tertiary-hovered);
    }

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        outline-offset: -2px;
    }
}

.mx_TgImport_text {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.mx_TgImport_title {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: var(--cpd-font-body-md-semibold);
    color: var(--tg-primary-color);
}

.mx_TgImport--queued .mx_TgImport_title,
.mx_TgImport--paused .mx_TgImport_title {
    color: var(--cpd-color-text-primary);
}

.mx_TgImport_detail {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: var(--cpd-font-body-sm-regular);
    font-variant-numeric: tabular-nums;
    color: var(--cpd-color-text-secondary);
}

.mx_TgImport_action {
    all: unset;
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    min-width: 3.5rem;
    min-height: 2.75rem;
    padding: 0 1rem;
    font: var(--cpd-font-body-md-semibold);
    color: var(--tg-primary-color);
    cursor: pointer;

    &:disabled {
        opacity: 0.5;
        cursor: default;
    }

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        border-radius: 0.5rem;
    }
}

.mx_TgImport_bar {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    height: 0.1875rem;
    background: color-mix(in srgb, var(--cpd-color-text-secondary) 18%, transparent);

    > span {
        display: block;
        height: 100%;
        background: var(--tg-primary-color);
        transition: width 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
    }
}

.mx_TgImport--queued .mx_TgImport_bar > span {
    background: var(--cpd-color-text-secondary);
}

.mx_TgImport_bar--indeterminate > span {
    width: 40%;
    animation: mx_History_indeterminate 1.4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
}

/* Telegram layout: a floating glass plate under the pinned one, like tweb's topbar plates. */
html[data-tg-screen] .mx_RoomView_body[data-telegram-layout="true"] > .mx_TgImport {
    position: absolute;
    top: calc(var(--tg-plates-bottom, var(--tg-header-bottom, 64px)) + var(--tg-plates-gap));
    left: 0;
    right: 0;
    z-index: 3;
    width: calc(100% - 2 * var(--tg-page-chats-padding));
    max-width: 696px;
    margin: 0 auto;
    border: none;
    border-radius: var(--tg-border-radius-big);
    background-color: var(--tg-glass-background);
    backdrop-filter: var(--tg-glass-backdrop);
    box-shadow: var(--tg-topbar-box-shadow);
}

/* The chip above the chat list: bridges that aren't connected, else the import's progress. */
.mx_TgHistoryChip {
    all: unset;
    box-sizing: border-box;
    flex: 0 0 auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0.25rem 0.75rem 0.25rem;
    min-height: 2.5rem;
    padding: 0.375rem 0.875rem;
    border-radius: 1.25rem;
    background: var(--cpd-color-bg-subtle-secondary);
    font: var(--cpd-font-body-sm-semibold);
    color: var(--tg-primary-color);
    cursor: pointer;

    &:hover {
        background: var(--cpd-color-bg-subtle-primary);
    }

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
    }
}

.mx_TgHistoryChip--problem {
    color: var(--cpd-color-text-critical-primary);
    background: color-mix(in srgb, var(--cpd-color-text-critical-primary) 10%, transparent);
}

.mx_TgHistoryChip_text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_TgHistoryChip_spinner {
    width: 0.875rem;
    height: 0.875rem;
    border-width: 2px;
}

.mx_TgHistoryChip_dot {
    flex: 0 0 auto;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: currentcolor;
}

[data-collapsed] .mx_TgHistoryChip_text {
    display: none;
}

/* Activity charts: when the messages were sent. */
.mx_ActivitySection {
    padding: 0.25rem 1rem 0.5rem 3.5rem;

    > summary {
        display: flex;
        flex-direction: column;
        min-height: 2.75rem;
        justify-content: center;
        cursor: pointer;
        list-style: none;

        &::-webkit-details-marker {
            display: none;
        }
    }
}

.mx_ActivitySection_title {
    font: var(--cpd-font-body-md-regular);
}

.mx_ActivitySection_hint,
.mx_ActivitySection_label {
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
}

.mx_ActivitySection_block {
    margin: 0.5rem 0 0.75rem;
}

.mx_ActivityChart {
    display: flex;
    align-items: flex-end;
    gap: 2px;
    margin-top: 0.25rem;
}

.mx_ActivityChart_bar {
    flex: 1 1 0;
    min-width: 2px;
    border-radius: 2px 2px 0 0;
    background: var(--tg-primary-color);
    opacity: 0.85;

    &:hover {
        opacity: 1;
    }
}

.mx_ActivityChart_axis {
    display: flex;
    justify-content: space-between;
    margin-top: 0.125rem;
    font: var(--cpd-font-body-xs-regular);
    color: var(--cpd-color-text-secondary);
    font-variant-numeric: tabular-nums;
}
