/*
 * Telegram Web K's floating "plates" (GPL-3.0) for the chat's header and footer, in the
 * Telegram-style layout (TgColumns marks <html> with data-tg-screen while it is on):
 *   src/scss/partials/_chatTopbar.scss  .topbar: 3rem tall, $border-radius-big (24px), surface
 *                                       colour, 0 1px 5px -1px rgba(0,0,0,.21), --chat-width wide
 *   src/scss/partials/_chat.scss        .chat-input-wrapper: 24px radius, min-height 3rem,
 *                                       $chat-input-box-shadow; .bubbles-go-down / .chat-secondary-button:
 *                                       round, surface colour, same shadow, fading with --layer-transition;
 *                                       .bubbles-corner-button .badge at -.25rem
 *   helpers/updateColumnWidths.ts       --page-chats-padding: 16px desktop, 8px handheld
 */

html[data-tg-screen] .mx_RoomHeader {
    box-sizing: border-box;
    width: calc(100% - 2 * var(--tg-page-chats-padding));
    max-width: var(--tg-chat-width);
    height: var(--tg-chat-topbar-height);
    /* Clear of the notch/status bar where the page draws under it (a PWA). */
    margin: max(var(--tg-page-chats-padding), var(--tg-safe-top)) auto 0;
    padding-inline: 0.25rem 0.5rem;
    border-bottom: none;
    border-radius: var(--tg-border-radius-big);
    background-color: var(--tg-glass-background);
    backdrop-filter: var(--tg-glass-backdrop);
    box-shadow: var(--tg-topbar-box-shadow);
    flex: 0 0 auto;
    transition:
        transform var(--tg-transition-standard-in),
        background-color var(--tg-transition-standard-in);

    &:hover {
        background-color: var(--tg-glass-background);
    }

    .mx_RoomHeader_info {
        padding-right: 0;
    }

    /* Telegram: the status line (typing, last seen) sits under the name, not beside it. */
    .mx_RoomHeader_infoWrapper {
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: 0;
        /* A flex item won't shrink below its content unless told to, so without this a long room name
           grows the header instead of ending in an ellipsis. */
        min-width: 0;

        > * {
            max-width: 100%;
            min-width: 0;
        }
    }

    /* tweb .btn-icon: 2.5rem round buttons. */
    > button,
    .mx_TgBackButton {
        border-radius: 50%;
    }
}

/* The composer: a floating pill above the bottom edge. */
html[data-tg-screen] .mx_RoomView_body[data-telegram-layout="true"] {
    .mx_MessageComposer {
        box-sizing: border-box;
        width: calc(100% - 2 * var(--tg-page-chats-padding));
        max-width: var(--tg-chat-width);
        /* Above the home indicator where the page draws under it (a PWA), except while the keyboard is up. */
        margin: 0 auto max(var(--tg-page-chats-padding), var(--tg-safe-bottom));
        /* Element pads the composer's bottom by 15px; the page padding alone matches the header's gap. */
        padding-bottom: 0;
    }

    /* Translucent like Telegram iOS: the timeline scrolls behind and shows through, blurred. */
    .mx_MessageComposer_wrapper {
        min-height: var(--tg-chat-input-height);
        border-top: none;
        border-radius: var(--tg-border-radius-big);
        background-color: var(--tg-glass-background);
        backdrop-filter: var(--tg-glass-backdrop);
        box-shadow: var(--tg-chat-input-box-shadow);
    }

    /*
     * tweb .rows-wrapper-row: attach (and "more") at the start, the input, then the smiley that opens the
     * emoticons dropdown and the send capsule. The composer's own input layout is left alone; only the
     * buttons are ordered (the actions container dissolves into the row). Buttons sit at the bottom as
     * the input grows, with tweb's .25rem gap.
     */
    /*
     * Telegram iOS composer: the + island, the input pill and the microphone island side by side,
     * bottom-aligned, .5rem apart. The islands are 3rem circles in the pill's colour and shadow.
     */
    .mx_MessageComposer.mx_MessageComposer_tg {
        display: flex;
        align-items: flex-end;
        gap: 0.5rem;

        > .mx_MessageComposer_wrapper {
            flex: 1 1 auto;
            min-width: 0;
        }
    }

    .mx_TgComposerIsland {
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        width: var(--tg-chat-input-height);
        height: var(--tg-chat-input-height);
        overflow: hidden;
        border-radius: 50%;
        background-color: var(--tg-glass-background);
        backdrop-filter: var(--tg-glass-backdrop);
        box-shadow: var(--tg-chat-input-box-shadow);
        transition:
            width var(--tg-transition-standard-in),
            margin var(--tg-transition-standard-in),
            opacity var(--tg-transition-standard-in),
            transform var(--tg-transition-standard-in);

        .mx_TgAttachButton,
        .mx_TgSendButton {
            width: 100%;
            height: 100%;
            margin: 0;
            border-radius: 50%;
            background: none;
            color: var(--cpd-color-icon-secondary);

            &:hover {
                background-color: var(--cpd-color-bg-subtle-secondary);
                color: var(--cpd-color-icon-primary);
            }
        }
    }

    /* The in-input sticker button morphs into the emoji button (and back) with tweb's grow-icon. */
    .mx_TgEmoticonsButton_icon {
        display: flex;
        animation: mx_TgSendButton_grow 0.4s ease-in-out;
    }

    /* The microphone slides away (and gives its gap back) while the input has text. */
    .mx_TgComposerIsland_hidden {
        width: 0;
        margin-inline-start: -0.5rem;
        opacity: 0;
        transform: scale(0.1);
        pointer-events: none;
    }

    .mx_MessageComposer_tg {
        /* tweb .rows-wrapper: 3rem tall with .25rem padding (Element reserves 42px for the encryption badge). */
        .mx_MessageComposer_wrapper {
            box-sizing: border-box;
            padding: 0.25rem;
        }

        .mx_MessageComposer_row {
            align-items: flex-end;
            gap: 0.25rem;
        }

        /* tweb .input-message-container: at least 2.5rem, text padded .5rem vertically. */
        .mx_SendMessageComposer {
            order: 0;
            margin: 0;
        }

        .mx_BasicMessageComposer {
            justify-content: center;
            min-height: 2.5rem;
        }

        /* No button left of the text inside the pill any more (the + is its own island): inset the text like iOS. */
        .mx_BasicMessageComposer_input {
            min-height: 0;
            margin: 0;
            padding: 0.5rem 0 0.5rem 0.5rem;
        }

        /* tweb .btn-icon: 2.5rem round buttons; icons a little bigger than tweb's 1.5rem (asked for). */
        .mx_MessageComposer_button {
            box-sizing: border-box;
            display: flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            width: 2.5rem;
            height: 2.5rem;
            padding: 0.375rem;
            border-radius: 50%;

            svg {
                width: 1.75rem;
                height: 1.75rem;
            }
        }

        .mx_MessageComposer_actions {
            display: contents;
        }

        .mx_TgEmoticonsButton {
            order: 1;
        }

        .mx_TgSendButton {
            order: 2;
        }
    }

    /* tweb .btn-send: min-width 3rem, 2.5rem tall, 1.25rem radius, accent colour, white icon. */
    .mx_TgSendButton {
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        min-width: 3rem;
        height: 2.5rem;
        border-radius: 1.25rem;
        color: #fff;
        background-color: var(--cpd-color-bg-accent-rest);
        cursor: pointer;

        &:hover {
            background-color: var(--cpd-color-bg-accent-hovered);
        }

        .mx_TgSendButton_icon {
            display: flex;
            animation: mx_TgSendButton_grow 0.4s ease-in-out forwards;
        }

        svg {
            width: 1.5rem;
            height: 1.5rem;
        }
    }

    /* Status bar and the "jump" corner buttons above the composer. */
    .mx_RoomView_statusArea {
        border-top: none;
    }
}

/* .bubbles-go-down: a round 3rem button in the corner above the composer. */
html[data-tg-screen] {
    /* helpers/updateColumnWidths.ts CHAT_WIDTH_MAX */
    --tg-chat-width: 696px;

    .mx_JumpToBottomButton {
        width: var(--tg-chat-input-height);
        height: var(--tg-chat-input-height);
        bottom: 0.5rem;
        animation: mx_TgFade_in var(--tg-layer-transition);
    }

    .mx_JumpToBottomButton_scrollDown,
    .mx_TopUnreadMessagesBar_scrollUp {
        width: var(--tg-chat-input-height);
        height: var(--tg-chat-input-height);
        border: none;
        border-radius: 50%;
        /* Glass like the header and composer islands. */
        background-color: var(--tg-glass-background);
        backdrop-filter: var(--tg-glass-backdrop);
        box-shadow: var(--tg-chat-input-box-shadow);
        transition: background-color var(--tg-layer-transition);

        svg {
            color: var(--tg-secondary-text-color);
        }

        &:hover {
            background-color: color-mix(in srgb, var(--cpd-color-bg-subtle-primary) 70%, transparent);
        }
    }

    .mx_JumpToBottomButton_scrollDown svg {
        padding: 12px;
    }

    .mx_TopUnreadMessagesBar_scrollUp svg {
        width: 100%;
        height: 100%;
        padding: 12px;
        box-sizing: border-box;
    }

    /* .bubbles-corner-button .badge */
    .mx_JumpToBottomButton_badge {
        position: absolute;
        top: -0.25rem;
        inset-inline-end: -0.25rem;
        z-index: 1;
        min-width: 1.375rem;
        height: 1.375rem;
        box-sizing: border-box;
        padding: 0 0.4375rem;
        border-radius: 0.6875rem;
        line-height: 1.375rem;
        font-size: 14px;
        background-color: var(--tg-primary-color);
    }

    .mx_JumpToBottomButton_highlight .mx_JumpToBottomButton_badge {
        background-color: var(--cpd-color-icon-critical-primary);
    }

    .mx_TopUnreadMessagesBar {
        width: var(--tg-chat-input-height);
        animation: mx_TgFade_in var(--tg-layer-transition);

        &::after {
            display: none;
        }
    }

    .mx_TopUnreadMessagesBar_markAsRead {
        border: none;
        background-color: var(--tg-glass-background);
        backdrop-filter: var(--tg-glass-backdrop);
        box-shadow: var(--tg-chat-input-box-shadow);
    }
}

/* Handhelds: 8px around the plates and no width cap (declared after the defaults above). */
html[data-tg-screen="mobile"] {
    --tg-page-chats-padding: 8px;
    --tg-chat-width: 100%;
}

@keyframes mx_TgFade_in {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

/* tweb base.scss @keyframes grow-icon. */
@keyframes mx_TgSendButton_grow {
    0% {
        transform: scale(0.5);
        opacity: 0.8;
    }

    50% {
        transform: scale(1.1);
        opacity: 1;
    }

    100% {
        transform: scale(1);
    }
}

/*
 * tweb .emoji-dropdown (scss/partials/_emojiDropdown.scss): 23.875rem x 26.25rem, 1.25rem radius, the
 * dropdown shadow, anchored above the input's inline end and scaling in from .85 with
 * --btn-menu-transition (.2s cubic-bezier(.4, 0, .2, 1)); .emoji-tabs along the bottom with a top border.
 */
.mx_TgEmoticonsDropdown {
    position: fixed;
    z-index: 4000;
    display: flex;
    flex-direction: column;
    width: 23.875rem;
    height: 26.25rem;
    max-width: calc(100vw - 1rem);
    max-height: calc(100vh - 6rem);
    overflow: hidden;
    border-radius: 1.25rem;
    background-color: var(--cpd-color-bg-canvas-default);
    box-shadow: 0 5px 10px 5px rgb(16 35 47 / 14%);
    transform-origin: 100% 100%;
    animation: mx_TgEmoticonsDropdown_in 0.2s cubic-bezier(0.4, 0, 0.2, 1) both;

    .mx_TgEmoticonsDropdown_body {
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
        display: flex;

        > * {
            flex: 1 1 auto;
            width: 100%;
            height: 100%;
            min-width: 0;
        }
    }

    .mx_TgEmoticonsDropdown_tabs {
        display: flex;
        flex: 0 0 3.0625rem;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        border-top: 1px solid var(--cpd-color-border-interactive-secondary);
    }

    /* tweb .emoji-tabs .menu-horizontal-div-item: icon tabs, .75rem apart. */
    .mx_TgEmoticonsDropdown_tab {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        margin: 0 0.25rem;
        border-radius: 50%;
        color: var(--cpd-color-icon-secondary);

        svg {
            width: 1.5rem;
            height: 1.5rem;
        }

        &:hover {
            background-color: var(--cpd-color-bg-subtle-secondary);
        }
    }

    .mx_TgEmoticonsDropdown_tab_active {
        color: var(--cpd-color-icon-accent-primary);
    }
}

@keyframes mx_TgEmoticonsDropdown_in {
    from {
        transform: scale(0.85);
        opacity: 0;
    }

    to {
        transform: scale(1);
        opacity: 1;
    }
}

/*
 * tweb stickers tab (scss/partials/_emojiDropdown.scss, base.scss .super-stickers): search field
 * (2.375rem, faint background), the pack icon row (3.0625rem, border below, active icon on a 6% tint),
 * then every pack in one list: centred bold 16px titles at 42% text colour over 72px stickers.
 */
.mx_TgStickersPanel {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-height: 0;

    .mx_TgStickersPanel_search {
        flex: 0 0 auto;
        height: 2.375rem;
        margin: 0.5rem 0.5rem 0.25rem;
        border-radius: 16px;
        background-color: color-mix(in srgb, var(--cpd-color-text-primary) 6%, transparent);

        input {
            box-sizing: border-box;
            width: 100%;
            height: 100%;
            padding: 0 1rem;
            border: none;
            border-radius: inherit;
            background: none;
            font: var(--cpd-font-body-md-regular);
            color: var(--cpd-color-text-primary);
            outline: none;
        }
    }

    .mx_TgStickersPanel_menu {
        display: flex;
        flex: 0 0 3.0625rem;
        align-items: center;
        padding: 0 0.3125rem;
        overflow-x: auto;
        scrollbar-width: none;
        border-bottom: 1px solid var(--cpd-color-border-interactive-secondary);

        > div {
            flex: 0 0 auto;
        }

        .mx_PackStickerPicker_tab {
            box-sizing: border-box;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 2.375rem;
            height: 2.375rem;
            margin: 0 0.3125rem;
            padding: 0.25rem;
            border: none;
            border-radius: 0.25rem;
            background: none;
            cursor: pointer;

            img,
            video {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }
        }

        .mx_PackStickerPicker_tab_selected {
            background-color: color-mix(in srgb, var(--cpd-color-text-primary) 6%, transparent);
        }
    }

    /* tweb's scrollable overlays its scrollbar, so the grid keeps its 5 columns. */
    .mx_TgStickersPanel_list {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-width: none;
    }

    .mx_TgStickersPanel_title {
        padding: 0.75rem 0.875rem 0.375rem;
        font: var(--cpd-font-body-md-semibold);
        font-size: 16px;
        font-weight: 700;
        line-height: 1.1875rem;
        text-align: center;
        color: color-mix(in srgb, var(--cpd-color-text-primary) 42%, transparent);
    }

    .mx_TgStickersPanel_grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, 72px);
        justify-content: space-between;
        gap: 4px;
        padding: 0 0.1875rem;

        .mx_PackStickerPicker_sticker {
            width: 72px;
            height: 72px;
        }
    }

    .mx_TgStickersPanel_status {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: var(--cpd-color-text-secondary);
    }
}

/* TgTweaksPanel: on-screen sliders for tuning values (?tweaks). */
.mx_TgTweaksPanel {
    position: fixed;
    right: 12px;
    top: 80px;
    z-index: 5000;
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 240px;
    padding: 10px;
    border-radius: 12px;
    background-color: var(--cpd-color-bg-canvas-default);
    box-shadow: 0 4px 16px rgb(0 0 0 / 20%);
    font: var(--cpd-font-body-sm-regular);

    .mx_TgTweaksPanel_row {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .mx_TgTweaksPanel_preview {
        display: flex;
        gap: 24px;
        padding: 8px 4px 10px;
    }

    .mx_TgTweaksPanel_avatar {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: linear-gradient(135deg, #7a9cff, #3e5fd8);
    }

    .mx_TgTweaksPanel_values {
        white-space: pre;
        font-size: 10px;
        user-select: all;
    }
}
