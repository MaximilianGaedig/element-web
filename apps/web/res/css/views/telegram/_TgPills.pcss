/*
 * Telegram Web K's floating "plates" (GPL-3.0) for the chat's header and footer, in the
 * Telegram-style layout (TgColumns marks <html> with data-tg-screen while it is on):
 *   src/scss/partials/_chatTopbar.scss  .topbar: 3rem tall, $border-radius-big (24px), surface
 *                                       colour, 0 1px 5px -1px rgba(0,0,0,.21), --chat-width wide
 *   src/scss/partials/_chat.scss        .chat-input-wrapper: 24px radius, min-height 3rem,
 *                                       $chat-input-box-shadow; .bubbles-go-down / .chat-secondary-button:
 *                                       round, surface colour, same shadow, fading with --layer-transition;
 *                                       .bubbles-corner-button .badge at -.25rem
 *   helpers/updateColumnWidths.ts       --page-chats-padding: 16px desktop, 8px handheld
 */

html[data-floating-bars] .mx_RoomHeader {
    box-sizing: border-box;
    width: calc(100% - 2 * var(--tg-page-chats-padding));
    max-width: var(--tg-chat-width, 100%);
    height: var(--tg-chat-topbar-height);
    /*
     * Below the status bar, not against it: where the page draws under it (a PWA), the header keeps its
     * usual gap underneath the inset rather than taking whichever of the two is larger, which left it
     * touching the clock. With no inset this is the plain gap it has always had.
     */
    margin: calc(var(--tg-safe-top) + var(--tg-page-chats-padding)) auto 0;
    padding-inline: 0.25rem 0.5rem;
    border-bottom: none;
    border-radius: var(--tg-border-radius-big);
    background-color: var(--tg-glass-background);
    backdrop-filter: var(--tg-glass-backdrop);
    box-shadow: var(--tg-glass-border), var(--tg-topbar-box-shadow);
    flex: 0 0 auto;
    transition:
        transform var(--tg-transition-standard-in),
        background-color var(--tg-transition-standard-in);

    &:hover {
        background-color: var(--tg-glass-background);
    }

    .mx_RoomHeader_info {
        padding-right: 0;
    }

    /* Telegram: the status line (typing, last seen) sits under the name, not beside it. */
    .mx_RoomHeader_infoWrapper {
        flex-direction: column;
        align-items: flex-start;
        justify-content: center;
        gap: 0;
        /* A flex item won't shrink below its content unless told to, so without this a long room name
           grows the header instead of ending in an ellipsis. */
        min-width: 0;

        > * {
            max-width: 100%;
            min-width: 0;
        }
    }

    /* tweb .btn-icon: 2.5rem round buttons. */
    > button,
    .mx_TgBackButton {
        border-radius: 50%;
    }
}

/* The composer: a floating pill above the bottom edge. */
html[data-floating-bars] .mx_RoomView_body {
    .mx_MessageComposer {
        box-sizing: border-box;
        width: calc(100% - 2 * var(--tg-page-chats-padding));
        max-width: var(--tg-chat-width, 100%);
        /* Above the home indicator where the page draws under it (a PWA), except while the keyboard is up. */
        margin: 0 auto calc(var(--tg-safe-bottom) + var(--tg-page-chats-padding));
        /* Element pads the composer's bottom by 15px; the page padding alone matches the header's gap. */
        padding-bottom: 0;
    }

    /* Translucent like Telegram iOS: the timeline scrolls behind and shows through, blurred. */
    .mx_MessageComposer_wrapper {
        min-height: var(--tg-chat-input-height);
        border-top: none;
        border-radius: var(--tg-border-radius-big);
        background-color: var(--tg-glass-background);
        backdrop-filter: var(--tg-glass-backdrop);
        box-shadow: var(--tg-glass-border), var(--tg-chat-input-box-shadow);
    }

    /*
     * Telegram iOS composer: the + island, the input pill and the microphone island side by side,
     * bottom-aligned, 8px apart. Each island matches the single-line input height as the font changes.
     */
    .mx_MessageComposer.mx_MessageComposer_tg {
        --tg-composer-font-size: var(--cpd-font-size-body-md);
        --tg-composer-height: max(48px, calc(var(--tg-composer-font-size) * 1.25 + 18px));
        --tg-composer-control-size: calc(var(--tg-composer-height) - 4px);
        --tg-composer-gap: 8px;
        --tg-composer-motion: 260ms cubic-bezier(0.22, 0.8, 0.25, 1);

        display: flex;
        align-items: flex-end;
        gap: var(--tg-composer-gap);
        font-size: var(--tg-composer-font-size);
        line-height: 1.25;

        > .mx_MessageComposer_wrapper {
            flex: 1 1 auto;
            min-width: 0;
            min-height: var(--tg-composer-height);
            margin: 0;
            border-radius: calc(var(--tg-composer-height) / 2);
            /* Keep Send anchored to the composer, not the expanding input surface. */
            position: static;
            transition: border-radius 160ms ease;
        }
    }

    .mx_TgComposerIsland {
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        width: var(--tg-composer-height);
        height: var(--tg-composer-height);
        overflow: hidden;
        border-radius: 50%;
        background-color: var(--tg-glass-background);
        backdrop-filter: var(--tg-glass-backdrop);
        box-shadow: var(--tg-glass-border), var(--tg-chat-input-box-shadow);
        transition:
            width var(--tg-composer-motion),
            margin var(--tg-composer-motion),
            opacity var(--tg-composer-motion),
            transform var(--tg-composer-motion),
            border-radius var(--tg-composer-motion);

        .mx_TgAttachButton,
        .mx_TgSendButton {
            min-width: 0;
            width: 100%;
            height: 100%;
            margin: 0;
            border-radius: 50%;
            background: none;
            color: var(--cpd-color-icon-secondary);

            &:hover {
                background-color: var(--cpd-color-bg-subtle-secondary);
                color: var(--cpd-color-icon-primary);
            }
        }
    }

    /* The two shapes share a centre throughout the transition, including when typing is reversed. */
    .mx_TgEmoticonsButton_icon {
        display: grid;
        place-items: center;

        svg {
            grid-area: 1 / 1;
            transition:
                opacity var(--tg-composer-motion),
                transform var(--tg-composer-motion);
        }

        .mx_TgEmoticonsButton_emoji {
            opacity: 0;
            transform: scale(0.7) rotate(-35deg);
        }

        &[data-has-text="true"] {
            .mx_TgEmoticonsButton_sticker {
                opacity: 0;
                transform: scale(0.7) rotate(35deg);
            }

            .mx_TgEmoticonsButton_emoji {
                opacity: 1;
                transform: none;
            }
        }
    }

    /* The microphone slides away (and gives its gap back) while the input has text. */
    .mx_TgComposerIsland_hidden {
        width: 0;
        margin-inline-start: calc(-1 * var(--tg-composer-gap));
        opacity: 0;
        transform: scale(0.1);
        pointer-events: none;
    }

    .mx_MessageComposer_tg {
        /* One sizing model for the plain and rich-text editors; no inherited 55px minimum. */
        .mx_MessageComposer_wrapper {
            box-sizing: border-box;
            padding: 2px;
        }

        .mx_MessageComposer_row {
            align-items: flex-end;
            gap: 0;
        }

        /* Both editors inherit the same font metrics and grow naturally for multiline drafts. */
        .mx_SendMessageComposer,
        .mx_SendWysiwygComposer {
            order: 0;
            margin: 0;
            min-width: 0;
            font-size: inherit;
            line-height: inherit;
        }

        .mx_BasicMessageComposer {
            justify-content: center;
            min-height: var(--tg-composer-control-size);
        }

        /* No button left of the text inside the pill any more (the + is its own island): inset the text like iOS. */
        .mx_BasicMessageComposer_input {
            box-sizing: border-box;
            min-height: 0;
            margin: 0;
            padding: 7px 0 7px 10px;
            max-height: min(10lh, 35dvh);
            line-height: inherit;
            font-size: inherit;
        }

        .mx_SendWysiwygComposer .mx_WysiwygComposer_Editor {
            min-height: var(--tg-composer-control-size);
            box-sizing: border-box;
            padding: 7px 0 7px 10px;
            border: 0;
            border-radius: 0;

            .mx_WysiwygComposer_Editor_container {
                min-height: 0;
                margin: auto 0;

                .mx_WysiwygComposer_Editor_content {
                    line-height: inherit;
                    font-size: inherit;
                    max-height: min(10lh, 35dvh);

                    p {
                        min-height: 1lh;
                    }
                }
            }
        }

        .mx_SendWysiwygComposer .mx_FormattingButtons {
            min-width: 0;
            max-width: 100%;
            overflow-x: auto;

            .mx_FormattingButtons_Button {
                flex: 0 0 auto;
            }
        }

        /* Controls fit inside the pill's 2px inset and remain bottom-aligned for multiline drafts. */
        .mx_MessageComposer_button {
            box-sizing: border-box;
            display: flex;
            flex: 0 0 auto;
            align-items: center;
            justify-content: center;
            width: var(--tg-composer-control-size);
            height: var(--tg-composer-control-size);
            min-width: 0;
            min-height: 0;
            padding: 6px;
            margin: 0;
            border-radius: 50%;

            svg {
                width: 1.75rem;
                height: 1.75rem;
            }
        }

        .mx_MessageComposer_actions {
            display: contents;
        }

        .mx_TgEmoticonsButton {
            order: 1;
            margin-inline-start: 4px;
        }

        /* This reservation grows by EXACTLY the width the mic and its gap give back. The editor
           and sticker/emoji button therefore keep their positions for every animation frame. */
        .mx_TgSendSlot {
            order: 2;
            flex: 0 0 auto;
            width: 0;
            pointer-events: none;
            transition: width var(--tg-composer-motion);

            .mx_TgSendButton {
                position: absolute;
                inset-inline-end: 2px;
                bottom: 2px;
                width: var(--tg-composer-control-size);
                min-width: 0;
                height: var(--tg-composer-control-size);
                opacity: 0;
                transform: scale(0.35);
                transition:
                    opacity var(--tg-composer-motion),
                    transform var(--tg-composer-motion);
            }
        }

        &.mx_MessageComposer_tgSend .mx_TgSendSlot {
            width: calc(var(--tg-composer-height) + var(--tg-composer-gap));
            pointer-events: auto;

            .mx_TgSendButton {
                opacity: 1;
                transform: scale(1);
            }
        }
    }

    /* tweb .btn-send: min-width 3rem, 2.5rem tall, 1.25rem radius, accent colour, white icon. */
    .mx_TgSendButton {
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        min-width: 3rem;
        height: 2.5rem;
        border-radius: 1.25rem;
        color: #fff;
        background-color: var(--cpd-color-bg-accent-rest);
        cursor: pointer;

        &:hover {
            background-color: var(--cpd-color-bg-accent-hovered);
        }

        .mx_TgSendButton_icon {
            display: flex;
        }

        svg {
            width: 1.5rem;
            height: 1.5rem;
        }
    }

    /* Status bar and the "jump" corner buttons above the composer. */
    .mx_RoomView_statusArea {
        border-top: none;
    }
}

/*
 * How wide the chat is allowed to get. It belongs to the columns rather than to the plates: with the
 * columns off the timeline fills the window, and plates capped at the column width would float in
 * the middle of nothing. Every use falls back to 100% for exactly that case.
 */
html[data-chat-columns] {
    /* helpers/updateColumnWidths.ts CHAT_WIDTH_MAX */
    --tg-chat-width: 696px;
}

/*
 * .bubbles-go-down: round 3rem buttons in the corner above the composer, stacked as in Telegram iOS: scroll
 * down at the bottom, the unread mentions and the unread reactions above it, 0.5rem apart.
 */
html[data-floating-bars] {
    /* The old timeline's lone button positions itself; in the new timeline's stack, the stack does. */
    .mx_JumpToBottomButton:not(.mx_JumpButton) {
        width: var(--tg-chat-input-height);
        height: var(--tg-chat-input-height);
        bottom: 0.5rem;
    }

    .mx_TimelineJumpStack {
        --mx-jump-gap: 0.5rem;

        bottom: 0.5rem;
    }

    /* Through variables: a button that is away sets its own height (to nothing), which must still win. */
    .mx_JumpButton {
        --mx-jump-item-width: var(--tg-chat-input-height);
        --mx-jump-item-height: var(--tg-chat-input-height);
    }

    /*
     * The icon is centred by the button's flex box and nothing else. It used to carry 12px of padding as
     * well as a size of its own from two other stylesheets, which the cascade decided between in an order
     * that was not the same everywhere, so the glyph sat off-centre in its circle. One size, no padding,
     * and the same for every button.
     */
    .mx_JumpToBottomButton_scrollDown,
    .mx_JumpButton_button,
    .mx_TopUnreadMessagesBar_scrollUp {
        /* Element's own stylesheet makes the down button a block, which put its icon at the left edge. */
        display: flex;
        align-items: center;
        justify-content: center;
        width: var(--tg-chat-input-height);
        height: var(--tg-chat-input-height);
        /* The browser's own padding would push a centred icon off to one side. */
        padding: 0;
        border: none;
        border-radius: 50%;
        /* Glass like the header and composer islands. */
        background-color: var(--tg-glass-background);
        backdrop-filter: var(--tg-glass-backdrop);
        box-shadow: var(--tg-glass-border), var(--tg-chat-input-box-shadow);
        transition: background-color var(--tg-layer-transition);

        &:hover {
            background-color: color-mix(in srgb, var(--cpd-color-bg-subtle-primary) 70%, transparent);
        }

        svg {
            display: block;
            flex: none;
            box-sizing: content-box;
            width: 1.5rem;
            height: 1.5rem;
            padding: 0;
            margin: 0;
            color: var(--tg-secondary-text-color);
        }
    }

    /* .bubbles-corner-button .badge */
    .mx_JumpToBottomButton_badge,
    .mx_JumpButton_badge {
        position: absolute;
        top: -0.25rem;
        inset-inline-end: -0.25rem;
        z-index: 1;
        min-width: 1.375rem;
        height: 1.375rem;
        box-sizing: border-box;
        padding: 0 0.4375rem;
        border-radius: 0.6875rem;
        line-height: 1.375rem;
        font-size: 14px;
        background-color: var(--tg-primary-color);
    }

    .mx_JumpToBottomButton_highlight .mx_JumpToBottomButton_badge {
        background-color: var(--cpd-color-icon-critical-primary);
    }

    .mx_TopUnreadMessagesBar {
        width: var(--tg-chat-input-height);

        &::after {
            display: none;
        }
    }

    /* Big enough to hit with a finger: 18px read as a dot under the button rather than a control. */
    .mx_TopUnreadMessagesBar_markAsRead {
        width: 1.75rem;
        height: 1.75rem;
        margin: 0.375rem auto 0;
        border-radius: 50%;

        svg {
            width: 1rem;
            height: 1rem;
        }

        border: none;
        background-color: var(--tg-glass-background);
        backdrop-filter: var(--tg-glass-backdrop);
        box-shadow: var(--tg-glass-border), var(--tg-chat-input-box-shadow);
    }
}

/* Handhelds: 8px around the plates and no width cap (declared after the defaults above). */
html[data-tg-screen="mobile"] {
    --tg-page-chats-padding: 8px;
    --tg-chat-width: 100%;

    .mx_RoomView_body[data-bubble-timeline="true"] .mx_MessageComposer.mx_MessageComposer_tg {
        --tg-page-chats-padding: 8px;
        /* 40px at the normal text size, growing with the font rather than clipping it.
           16px is Safari's minimum editable font size before it zooms the viewport. */
        --tg-composer-font-size: max(16px, 1.0625rem);
        --tg-composer-height: max(40px, calc(var(--tg-composer-font-size) * 1.25 + 18px));
        /*
         * In from the screen's edges as far as the messages are. At the page's 8px the composer
         * reached well past the bubbles on either side - they sit a message-list padding in - and
         * read as wider than the chat it belongs to.
         */
        width: calc(100% - 2 * var(--RoomView_MessageList-padding, 18px));

        .mx_TgAttachButton {
            width: 100%;
            height: 100%;
        }

        .mx_TgComposerIsland_attach {
            transform-origin: left center;
        }

        .mx_TgComposerIsland_mic {
            transform-origin: right center;
        }

        .mx_TgComposerIsland:not(.mx_TgComposerIsland_hidden):has([role="button"]:active) {
            transform: scale(1.12, 1.06);
            border-radius: 44%;
        }

        &:has(.mx_TgComposerIsland_attach [role="button"]:active) > .mx_MessageComposer_wrapper {
            border-start-start-radius: calc(var(--tg-composer-height) * 0.4);
            border-end-start-radius: calc(var(--tg-composer-height) * 0.4);
        }

        &:has(.mx_TgComposerIsland_mic [role="button"]:active) > .mx_MessageComposer_wrapper {
            border-start-end-radius: calc(var(--tg-composer-height) * 0.4);
            border-end-end-radius: calc(var(--tg-composer-height) * 0.4);
        }

        .mx_TgEmoticonsButton_icon,
        .mx_TgSendButton_icon {
            transition: transform 160ms ease;
        }

        .mx_TgEmoticonsButton:active .mx_TgEmoticonsButton_icon,
        .mx_TgSendButton:active .mx_TgSendButton_icon {
            transform: scale(1.12);
        }

        &:dir(rtl) {
            .mx_TgComposerIsland_attach {
                transform-origin: right center;
            }

            .mx_TgComposerIsland_mic {
                transform-origin: left center;
            }
        }
    }
}

@media (prefers-reduced-motion: reduce) {
    html[data-floating-bars] .mx_RoomView_body .mx_MessageComposer.mx_MessageComposer_tg {
        --tg-composer-motion: 0s linear;

        .mx_MessageComposer_wrapper,
        .mx_TgEmoticonsButton_icon,
        .mx_TgSendButton_icon {
            transition: none;
        }
    }
}

@keyframes mx_TgFade_in {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

/*
 * tweb .emoji-dropdown (scss/partials/_emojiDropdown.scss): 23.875rem x 26.25rem, 1.25rem radius, the
 * dropdown shadow, anchored above the input's inline end and scaling in from .85 with
 * --btn-menu-transition (.2s cubic-bezier(.4, 0, .2, 1)); .emoji-tabs along the bottom with a top border.
 */
.mx_TgEmoticonsDropdown {
    position: fixed;
    z-index: var(--mx-z-overlay-picker);
    display: flex;
    flex-direction: column;
    width: 23.875rem;
    height: 26.25rem;
    max-width: calc(100vw - 1rem);
    max-height: calc(100vh - 6rem);
    overflow: hidden;
    border-radius: 1.25rem;
    background-color: var(--cpd-color-bg-canvas-default);
    box-shadow: 0 5px 10px 5px rgb(16 35 47 / 14%);
    transform-origin: 100% 100%;
    animation: mx_TgEmoticonsDropdown_in 0.2s cubic-bezier(0.4, 0, 0.2, 1) both;

    .mx_TgEmoticonsDropdown_body {
        flex: 1 1 auto;
        min-height: 0;
        overflow: hidden;
        display: flex;

        > * {
            flex: 1 1 auto;
            width: 100%;
            height: 100%;
            min-width: 0;
        }
    }

    .mx_TgEmoticonsDropdown_tabs {
        display: flex;
        flex: 0 0 3.0625rem;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        border-top: 1px solid var(--cpd-color-border-interactive-secondary);
    }

    /* tweb .emoji-tabs .menu-horizontal-div-item: icon tabs, .75rem apart. */
    .mx_TgEmoticonsDropdown_tab {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        margin: 0 0.25rem;
        border-radius: 50%;
        color: var(--cpd-color-icon-secondary);

        svg {
            width: 1.5rem;
            height: 1.5rem;
        }

        &:hover {
            background-color: var(--cpd-color-bg-subtle-secondary);
        }
    }

    .mx_TgEmoticonsDropdown_tab_active {
        color: var(--cpd-color-icon-accent-primary);
    }
}

@keyframes mx_TgEmoticonsDropdown_in {
    from {
        transform: scale(0.85);
        opacity: 0;
    }

    to {
        transform: scale(1);
        opacity: 1;
    }
}

/*
 * tweb stickers tab (scss/partials/_emojiDropdown.scss, base.scss .super-stickers): search field
 * (2.375rem, faint background), the pack icon row (3.0625rem, border below, active icon on a 6% tint),
 * then every pack in one list: centred bold 16px titles at 42% text colour over 72px stickers.
 */
.mx_TgStickersPanel {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
    min-height: 0;

    .mx_TgStickersPanel_search {
        flex: 0 0 auto;
        height: 2.375rem;
        margin: 0.5rem 0.5rem 0.25rem;
        border-radius: 16px;
        background-color: color-mix(in srgb, var(--cpd-color-text-primary) 6%, transparent);

        input {
            box-sizing: border-box;
            width: 100%;
            height: 100%;
            padding: 0 1rem;
            border: none;
            border-radius: inherit;
            background: none;
            font: var(--cpd-font-body-md-regular);
            color: var(--cpd-color-text-primary);
            outline: none;
        }
    }

    .mx_TgStickersPanel_menu {
        display: flex;
        flex: 0 0 3.0625rem;
        align-items: center;
        padding: 0 0.3125rem;
        overflow-x: auto;
        scrollbar-width: none;
        border-bottom: 1px solid var(--cpd-color-border-interactive-secondary);

        > div {
            flex: 0 0 auto;
        }

        .mx_PackStickerPicker_tab {
            box-sizing: border-box;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 2.375rem;
            height: 2.375rem;
            margin: 0 0.3125rem;
            padding: 0.25rem;
            border: none;
            border-radius: 0.25rem;
            background: none;
            cursor: pointer;

            img,
            video {
                width: 100%;
                height: 100%;
                object-fit: contain;
            }
        }

        .mx_PackStickerPicker_tab_selected {
            background-color: color-mix(in srgb, var(--cpd-color-text-primary) 6%, transparent);
        }
    }

    /* tweb's scrollable overlays its scrollbar, so the grid keeps its 5 columns. */
    .mx_TgStickersPanel_list {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        scrollbar-width: none;
    }

    .mx_TgStickersPanel_title {
        padding: 0.75rem 0.875rem 0.375rem;
        font: var(--cpd-font-body-md-semibold);
        font-size: 16px;
        font-weight: 700;
        line-height: 1.1875rem;
        text-align: center;
        color: color-mix(in srgb, var(--cpd-color-text-primary) 42%, transparent);
    }

    .mx_TgStickersPanel_grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, 72px);
        justify-content: space-between;
        gap: 4px;
        padding: 0 0.1875rem;

        .mx_PackStickerPicker_sticker {
            width: 72px;
            height: 72px;
        }
    }

    .mx_TgStickersPanel_status {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        color: var(--cpd-color-text-secondary);
    }
}

/*
 * TgMetricsPanel: what the layout thinks the screen is, shown on the screen (?metrics). It sits under
 * the status bar and above everything else, because the things it explains are exactly the ones that go
 * wrong at the screen's edges.
 */
.mx_TgMetricsPanel {
    position: fixed;
    inset-inline: 8px;
    top: calc(var(--tg-safe-top) + 4px);
    z-index: 6000;
    padding: 8px 10px;
    border-radius: 10px;
    background-color: color-mix(in srgb, var(--cpd-color-bg-canvas-default) 92%, transparent);
    box-shadow: 0 4px 16px rgb(0 0 0 / 25%);
    font: var(--cpd-font-body-xs-regular);
    font-variant-numeric: tabular-nums;

    dl {
        display: grid;
        grid-template-columns: auto 1fr;
        gap: 1px 10px;
        margin: 6px 0 0;
    }

    dt {
        color: var(--cpd-color-text-secondary);
    }

    dd {
        margin: 0;
        text-align: end;
    }

    .mx_TgMetricsPanel_toggle {
        color: var(--cpd-color-text-action-accent);
    }
}

/* TgTweaksPanel: on-screen sliders for tuning values (?tweaks). */
.mx_TgTweaksPanel {
    position: fixed;
    right: 12px;
    top: 80px;
    z-index: 5000;
    display: flex;
    flex-direction: column;
    gap: 6px;
    width: 240px;
    padding: 10px;
    border-radius: 12px;
    background-color: var(--cpd-color-bg-canvas-default);
    box-shadow: 0 4px 16px rgb(0 0 0 / 20%);
    font: var(--cpd-font-body-sm-regular);

    .mx_TgTweaksPanel_row {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .mx_TgTweaksPanel_preview {
        display: flex;
        gap: 24px;
        padding: 8px 4px 10px;
    }

    .mx_TgTweaksPanel_avatar {
        width: 100%;
        height: 100%;
        border-radius: 50%;
        background: linear-gradient(135deg, #7a9cff, #3e5fd8);
    }

    .mx_TgTweaksPanel_values {
        white-space: pre;
        font-size: 10px;
        user-select: all;
    }
}
