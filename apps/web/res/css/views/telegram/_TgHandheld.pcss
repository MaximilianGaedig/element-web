/*
 * The handheld Telegram-style layout outside the columns themselves. TgColumns marks <html> with
 * data-tg-screen while the layout is on, so overlays rendered outside it follow too. Ported from
 * Telegram Web K (GPL-3.0):
 *   src/scss/partials/_chatTopbar.scss  respond-to(handhelds): utility buttons hidden in the topbar,
 *                                       the back button (.sidebar-close-button) shown instead
 *   src/scss/partials/_rightSidebar.scss #column-right on handhelds: full width, slides from 100vw
 *   src/scss/partials/_slider.scss      settings tabs slide in with --transition-standard-in
 *   src/scss/partials/_chat.scss        .chat-input-wrapper --button-size: 2.5rem
 */

html[data-tg-screen="mobile"] {
    /* The chat list and the chat info sheet clear the notch and the home indicator (a PWA draws under them). */
    .mx_TgColumns_left,
    .mx_RightPanel_ResizeWrapper {
        box-sizing: border-box;
        padding-top: var(--tg-safe-top);
        padding-bottom: var(--tg-safe-bottom);
    }

    /* Compact chat header: back, avatar, title; everything else lives in the chat info sheet. */
    .mx_RoomHeader {
        gap: var(--cpd-space-2x);

        > button:not(.mx_TgBackButton, .mx_RoomHeader_join_button, .mx_BaseAvatar),
        > div:has(> .mx_RoomHeader_members) {
            display: none;
        }

        .mx_RoomHeader_info {
            padding-right: 0;
        }

        .mx_RoomHeaderPath {
            display: none;
        }
    }

    /*
     * Telegram iOS header: three islands instead of one bar - the back button (round, left), the name
     * and status (a centred pill) and the avatar (round, right) - each its own glass like the composer's.
     */
    .mx_RoomView_body[data-telegram-layout="true"] > .mx_RoomHeader {
        gap: 0.5rem;
        padding: 0;
        background: none;
        backdrop-filter: none;
        box-shadow: none;

        &:hover {
            background: none;
        }

        > .mx_TgBackButton {
            order: 0;
            flex: 0 0 auto;
            width: var(--tg-chat-input-height);
            height: var(--tg-chat-input-height);
            border-radius: 50%;
            background-color: var(--tg-glass-background);
            backdrop-filter: var(--tg-glass-backdrop);
            box-shadow: var(--tg-chat-input-box-shadow);
        }

        > .mx_RoomHeader_info {
            order: 1;
            flex: 1 1 auto;
            min-width: 0;
            height: var(--tg-chat-input-height);
            padding: 0 1rem;
            border-radius: var(--tg-border-radius-big);
            background-color: var(--tg-glass-background);
            backdrop-filter: var(--tg-glass-backdrop);
            box-shadow: var(--tg-chat-input-box-shadow);
        }

        .mx_RoomHeader_infoWrapper {
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 0;
            text-align: center;
        }

        > .mx_BaseAvatar {
            order: 2;
            flex: 0 0 auto;
            /* The avatar sizes its photo/initial from --cpd-avatar-size (inline 40px); grow both with the box. */
            --cpd-avatar-size: var(--tg-chat-input-height) !important;
            width: var(--tg-chat-input-height) !important;
            height: var(--tg-chat-input-height) !important;
            box-shadow: var(--tg-chat-input-box-shadow);

            > img {
                width: 100%;
                height: 100%;
            }
        }
    }

    /* Touch targets: tweb's 2.5rem composer buttons. */
    .mx_MessageComposer_button,
    .mx_MessageComposer_sendMessage {
        min-width: 40px;
        min-height: 40px;
    }

    /* A long press opens the message menu; keep iOS from also offering its text callout. */
    .mx_RoomView_MessageList {
        -webkit-touch-callout: none;
    }

    /* Chat info / member info: a full-screen sheet over the chat. */
    .mx_RightPanel_ResizeWrapper {
        position: fixed !important;
        inset: 0;
        z-index: 10;
        width: 100% !important;
        max-width: none !important;
        height: calc(var(--tg-vh) * 100) !important;
        background-color: $background;

        .mx_ResizeHandle--horizontal {
            display: none;
        }
    }

    /* Settings: full-screen sheets that slide in like tweb's sidebar tabs. */
    .mx_Dialog:has(> .mx_UserSettingsDialog, > .mx_RoomSettingsDialog, > .mx_SpaceSettingsDialog) {
        width: 100vw;
        height: calc(var(--tg-vh) * 100);
        max-width: none;
        max-height: none;
        border-radius: 0;
        padding: var(--cpd-space-4x);
        animation: mx_TgSheet_in var(--tg-transition-standard-in);

        > .mx_UserSettingsDialog,
        > .mx_RoomSettingsDialog,
        > .mx_SpaceSettingsDialog {
            width: 100%;
            height: 100%;
            max-width: none;
        }
    }
}

@keyframes mx_TgSheet_in {
    from {
        transform: translate3d(100%, 0, 0);
    }

    to {
        transform: translateZ(0);
    }
}

/*
 * Handhelds: dialogs, the settings and the emoji/sticker pickers are bottom drawers (Telegram iOS's
 * sheets) rather than centred windows or popups: full width, rounded at the top, sliding up from the
 * bottom edge, with a grabber, clearing the home indicator.
 */
@keyframes mx_TgDrawer_in {
    from {
        transform: translateY(100%);
    }

    to {
        transform: translateY(0);
    }
}

html[data-tg-screen="mobile"] {
    .mx_Dialog_wrapper:not(.mx_Dialog_lightbox, .mx_Dialog_staticWrapper) {
        align-items: flex-end;

        .mx_Dialog_border {
            width: 100%;
            max-width: 100%;
            max-height: calc(100dvh - var(--tg-safe-top, 0px) - 1.5rem);
            border-radius: 1.25rem 1.25rem 0 0;
            overflow: hidden;
            animation: mx_TgDrawer_in 0.28s cubic-bezier(0.2, 0.8, 0.2, 1) both;

            /* The grabber. */
            &::before {
                content: "";
                position: absolute;
                z-index: 2;
                top: 0.375rem;
                left: 50%;
                width: 2.25rem;
                height: 0.25rem;
                border-radius: 0.125rem;
                background: var(--cpd-color-border-interactive-secondary);
                transform: translateX(-50%);
                pointer-events: none;
            }
        }

        .mx_Dialog {
            width: 100%;
            max-width: 100%;
            box-sizing: border-box;
            border-radius: inherit;
            padding: var(--cpd-space-6x) var(--cpd-space-4x) calc(var(--cpd-space-4x) + var(--tg-safe-bottom, 0px));
        }

        .mx_CompoundDialog_header {
            padding: var(--cpd-space-5x) var(--cpd-space-4x) var(--cpd-space-2x);
        }
    }

    /* Settings: a tall drawer whose section list is a strip of tabs above the section. */
    .mx_UserSettingsDialog,
    .mx_RoomSettingsDialog,
    .mx_SpaceSettingsDialog,
    .mx_SpacePreferencesDialog {
        width: 100%;
        max-width: 100%;
        height: calc(100dvh - var(--tg-safe-top, 0px) - 1.5rem);
        padding: 0;

        .mx_TabbedView {
            position: relative;
            top: 0;
            inset: auto;
            height: 100%;
            margin: 0;
            padding: 0;
        }

        .mx_TabbedView_tabsOnLeft {
            position: relative;
            flex-direction: column;

            .mx_TabbedView_tabLabels {
                position: static;
                display: flex;
                flex: 0 0 auto;
                flex-direction: row;
                width: 100%;
                max-width: none;
                gap: var(--cpd-space-1x);
                padding: var(--cpd-space-4x) var(--cpd-space-3x) var(--cpd-space-2x);
                overflow-x: auto;
                scrollbar-width: none;

                .mx_TabbedView_tabLabel {
                    flex: 0 0 auto;
                    white-space: nowrap;
                    border-radius: 1rem;
                }
            }

            .mx_TabbedView_tabPanel {
                flex: 1 1 auto;
                min-height: 0;
                margin-left: 0;
                overflow-y: auto;
            }
        }

        .mx_TabbedView .mx_SettingsTab {
            min-width: 0;
            padding: 0 var(--cpd-space-4x) calc(var(--cpd-space-8x) + var(--tg-safe-bottom, 0px));
        }
    }

    /* The emoji and sticker picker slides up from the bottom instead of floating above the input. */
    .mx_TgEmoticonsDropdown {
        right: 0 !important;
        bottom: 0 !important;
        left: 0 !important;
        width: 100%;
        max-width: 100%;
        height: min(52dvh, 26.25rem);
        max-height: none;
        padding-bottom: var(--tg-safe-bottom, 0px);
        border-radius: 1.25rem 1.25rem 0 0;
        transform-origin: 50% 100%;
        animation: mx_TgDrawer_in 0.26s cubic-bezier(0.2, 0.8, 0.2, 1) both;
    }

    /* The reaction picker (an emoji picker in a popup menu) likewise. */
    .mx_ContextualMenu_wrapper:has([data-testid="mx_EmojiPicker"], .mx_EmojiPicker) {
        inset: auto 0 0 0 !important;
        transform: none !important;
        width: 100%;

        .mx_ContextualMenu {
            position: static;
            width: 100%;
            max-height: 55dvh;
            border-radius: 1.25rem 1.25rem 0 0;
            padding-bottom: var(--tg-safe-bottom, 0px);
            animation: mx_TgDrawer_in 0.26s cubic-bezier(0.2, 0.8, 0.2, 1) both;
        }
    }
}
