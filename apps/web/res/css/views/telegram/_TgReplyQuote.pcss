/*
 * tweb .reply.quote-like.quote-like-border(.quote-like-hoverable): _quote.scss + _chatPinned.scss.
 * The colour comes from the sender's mx_Username_colorN class (it sets `color`), so the bar, the tint
 * and the title are all currentColor-based; the subtitle sets its own colour.
 */
.mx_TgReplyQuote {
    --TgReplyQuote-radius: 0.25rem;
    /* .reply --font-size-14; in bubbles --messages-secondary-text-size (the message size - 1px). */
    --TgReplyQuote-font-size: 0.875rem;
    --TgReplyQuote-line-height: calc(var(--TgReplyQuote-font-size) + 4px);

    position: relative;
    display: flex;
    align-items: flex-start;
    box-sizing: border-box;
    min-width: 0;
    max-width: 100%;
    /* .reply: two lines + .875rem */
    min-height: calc(var(--TgReplyQuote-line-height) * 2 + 0.375rem);
    margin: 0;
    padding: 0;
    overflow: hidden;
    border: none;
    border-radius: var(--TgReplyQuote-radius);
    /* .quote-like: rgba(peer, .1) */
    background-color: color-mix(in srgb, currentColor 10%, transparent);
    font: inherit;
    font-size: var(--TgReplyQuote-font-size);
    text-align: start;
    white-space: initial;

    /* .quote-like-border:before: the 3px bar */
    &::before {
        content: "";
        position: absolute;
        inset-block: 0;
        inset-inline-start: 0;
        width: 0.1875rem;
        background: currentColor;
        z-index: 1;
    }

    &:is(button) {
        cursor: pointer;

        /* .quote-like-hoverable:hover: rgba(peer, .2) */
        &:hover {
            background-color: color-mix(in srgb, currentColor 20%, transparent);
        }
    }
}

/* .reply-media: 2rem, floated at the start, .125rem radius */
.mx_TgReplyQuote_media {
    flex: none;
    width: 2rem;
    height: 2rem;
    margin: 0.1875rem 0 0.1875rem 0.5rem;
    overflow: hidden;
    border-radius: 0.125rem;

    > img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
}

/* .reply-content: 3px block padding, .375rem end, .5rem start */
.mx_TgReplyQuote_content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 0;
    flex: 1 1 auto;
    padding: 3px 0.375rem 3px 0;
    margin-inline-start: 0.5rem;
}

.mx_TgReplyQuote_title,
.mx_TgReplyQuote_subtitle {
    display: block;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    font-size: var(--TgReplyQuote-font-size);
    line-height: var(--TgReplyQuote-line-height);
}

/* .reply-title in the peer colour; .peer-title bold */
.mx_TgReplyQuote_title {
    color: currentColor;
    font-weight: var(--cpd-font-weight-semibold);
}

/* In a bubble the text reads in the message colour. */
.mx_TgReplyQuote_subtitle {
    color: var(--cpd-color-text-primary);
}

/* tweb .bubble .reply: margin 0 0 .5rem inside the bubble. */
.mx_TgReplyQuote_bubble {
    --TgReplyQuote-font-size: calc(var(--cpd-font-size-body-md) - 1px);

    width: 100%;
    margin-block-end: 0.375rem;
}

/* tweb .bubble.is-out: replies take the outgoing accent, whoever is quoted. */
.mx_EventTile_tgOwn .mx_TgReplyQuote_bubble {
    color: var(--cpd-color-text-success-primary);
}

/* tweb .reply-wrapper .reply: .5rem radius, min-height 2.5rem, grey text (textColor secondary). */
.mx_TgReplyQuote_composer {
    --TgReplyQuote-radius: 0.5rem;

    flex: 1 1 auto;
    min-height: 2.5rem;

    .mx_TgReplyQuote_content {
        padding-block: 0.125rem;
    }

    .mx_TgReplyQuote_title {
        font-weight: var(--cpd-font-weight-regular);
    }

    .mx_TgReplyQuote_subtitle {
        color: var(--tg-secondary-text-color);
    }
}

/*
 * tweb .reply-wrapper: a 3rem row in the composer plate above the input, [reply icon][reply][cancel],
 * the icon and cancel button in the replied-to sender's colour.
 */
.mx_TgReplyRow {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    height: 3rem;
    padding-block-end: 0.25rem;
    box-sizing: border-box;
}

.mx_TgReplyRow_icon,
.mx_TgReplyRow_cancel {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0.5rem;
    box-sizing: border-box;
    border: none;
    border-radius: 50%;
    background: none;
    color: currentColor;

    svg {
        width: 1.5rem;
        height: 1.5rem;
    }
}

.mx_TgReplyRow_cancel {
    cursor: pointer;

    &:hover {
        background-color: color-mix(in srgb, currentColor 8%, transparent);
    }
}
