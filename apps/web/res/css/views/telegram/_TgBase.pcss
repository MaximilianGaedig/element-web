/*
 * Motion and shape tokens of Telegram Web K (GPL-3.0), src/scss/base.scss and
 * src/scss/partials/_chatVariables.scss. The Telegram-style layout reads only these, so every
 * duration and curve stays tweb's. Like tweb, layout transitions do not switch off for
 * prefers-reduced-motion (tweb gates them on its own "animations" lite-mode setting instead).
 *
 * Declared on the theme element too: Element puts `cpd-theme-*` on <body>, while compound's :root
 * tokens follow the OS prefers-color-scheme, so colours resolved only on :root ignore the chosen theme.
 */
:root,
[class*="cpd-theme-"] {
    --tg-transition-standard-easing: cubic-bezier(0.4, 0, 0.2, 1);
    --tg-transition-standard-in: 0.3s var(--tg-transition-standard-easing);
    --tg-transition-standard-out: 0.25s var(--tg-transition-standard-easing);
    --tg-layer-transition: 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    --tg-tabs-transition: 0.2s ease-in-out;
    --tg-pm-transition: 0.2s ease-in-out;
    --tg-input-transition-time: 0.2s;
    --tg-border-radius: 12px;
    --tg-border-radius-medium: 16px;
    --tg-border-radius-big: 24px;
    --tg-sidebar-collapsed-width: 80px;
    --tg-chat-topbar-height: 3rem;
    --tg-chat-input-height: 3rem;
    --tg-chat-helper-size: 3rem;
    --tg-plates-gap: 0.5rem;
    --tg-page-chats-padding: 16px;
    --tg-topbar-box-shadow: 0px 1px 5px -1px rgb(0, 0, 0, 0.21);
    --tg-chat-input-box-shadow: 0px 1px 8px 1px rgb(0 0 0 / 12%);
    --tg-surface-color: var(--cpd-color-bg-canvas-default);
    --tg-primary-color: var(--cpd-color-text-action-accent);
    --tg-secondary-text-color: var(--cpd-color-text-secondary);
    /* src/index.ts setVH: 1% of the visual viewport height, written by JS (viewportHeight.ts). */
    --tg-vh: 1vh;
    /*
     * The app's height. The dynamic viewport is the screen the app actually has, and already accounts for
     * a browser's own toolbars coming and going. The visual viewport is not the same thing: drawing under
     * the system bars makes iOS report it as the *safe* area, short by the status bar and the home
     * indicator, which left that much of the screen unused at the bottom of every screen. Only the
     * keyboard makes the two differ in a way we must follow, and the rule that does so is below.
     */
    --tg-app-height: 100dvh;
    /* Floating bars are translucent glass (see below; low power mode makes them solid). */
    --tg-glass-background: color-mix(in srgb, var(--tg-surface-color) 50%, transparent);
    --tg-glass-backdrop: blur(24px) saturate(180%);
    /*
     * The screen's unsafe edges (notch/status bar, home indicator): viewport-fit=cover draws under them,
     * which a home-screen app (PWA) does. The keyboard covers the bottom one, so it's 0 while that's up.
     */
    --tg-safe-top: env(safe-area-inset-top, 0px);
    --tg-safe-bottom: env(safe-area-inset-bottom, 0px);
}

/*
 * The keyboard covers the home indicator, so its inset must not hold the composer up off the visible
 * edge. The variables above sit on the theme element inside <html>, which would shadow this if it named
 * <html> alone - the same trap the glass overrides below carry a note about.
 */
html[data-tg-keyboard],
html[data-tg-keyboard] [class*="cpd-theme-"] {
    --tg-safe-bottom: 0px;
    /* The keyboard is the one thing the dynamic viewport does not shrink for, so follow the visual one. */
    --tg-app-height: min(calc(var(--tg-vh) * 100), 100dvh);
}

/* Nothing scrolls the page while the keyboard is up: the app is pinned to the visual viewport instead. */
html[data-tg-keyboard] {
    &,
    body {
        overflow: hidden;
    }
}

/* Set by viewportHeight.ts: how far iOS has panned the visual viewport (0 unless the keyboard is up). */
:root {
    --tg-vv-top: 0px;
}

/*
 * The floating bars are translucent glass: the timeline scrolls behind them and shows through, blurred.
 * Low power mode (html[data-low-power], see ROADMAP wave 6) turns every backdrop blur off: solid bars.
 * The fade towards the timeline's edges (.mx_TgFadeEdge) is a plain gradient, so it stays on throughout.
 */

/*
 * The variables above are set on the theme element inside <html>, so overriding them on <html> alone
 * would be shadowed by it: match both.
 */
html[data-low-power],
html[data-no-glass],
html[data-scrolling],
html[data-low-power] [class*="cpd-theme-"],
html[data-no-glass] [class*="cpd-theme-"],
html[data-scrolling] [class*="cpd-theme-"] {
    --tg-glass-background: var(--tg-surface-color);
    --tg-glass-backdrop: none;
}
