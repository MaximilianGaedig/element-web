/*
 * The little point at the bottom of the last bubble in a run.
 *
 * Telegram's is Telegram Web K's `#message-tail-filled` symbol (GPL-3.0,
 * https://github.com/morethanwords/tweb, index.html), hung off the corner by -8.4px and mirrored for
 * outgoing messages exactly as `_chatBubble.scss` does with `--reflect`. iMessage's is the rounder wing
 * Apple draws; that path is written to look like it rather than copied from Apple.
 *
 * Each is a mask over a box that inherits the bubble's background, so a tail is always exactly the colour
 * of the bubble it belongs to, in either theme, with no colours repeated here.
 */

html[data-tg-tail="telegram"] {
    --tg-tail-shape: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 11 20"><g transform="translate(9 -14)" fill-rule="evenodd"><path d="M-6 16h6v17c-.193-2.84-.876-5.767-2.05-8.782-.904-2.325-2.446-4.485-4.625-6.48A1 1 0 01-6 16z" transform="matrix(1 0 0 -1 0 49)"/></g></svg>');
    /* The same shape mirrored, for the outgoing side. Flipping the element instead would flip
       whatever is painted in it, which shows a media tail's picture backwards. */
    --tg-tail-shape-end: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 11 20"><g transform="translate(11 0) scale(-1 1)"><g transform="translate(9 -14)" fill-rule="evenodd"><path d="M-6 16h6v17c-.193-2.84-.876-5.767-2.05-8.782-.904-2.325-2.446-4.485-4.625-6.48A1 1 0 01-6 16z" transform="matrix(1 0 0 -1 0 49)"/></g></g></svg>');
    --tg-tail-width: 11px;
    --tg-tail-height: 20px;
    /* tweb _chatBubble.scss: the tail overlaps the bubble's squared corner by this much. */
    --tg-tail-offset: -8.4px;
    /* Telegram squares the corner the tail grows out of, so the two read as one shape. */
    --tg-tail-corner: 0;
}

html[data-tg-tail="imessage"] {
    --tg-tail-shape: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 11 20"><path d="M11 7c0 6.2-3.4 10.6-8.6 12.6-.9.3-.6 1 .3.9 3.4-.4 6.2-1.6 8.3-3.6z"/></svg>');
    --tg-tail-shape-end: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 11 20"><g transform="translate(11 0) scale(-1 1)"><path d="M11 7c0 6.2-3.4 10.6-8.6 12.6-.9.3-.6 1 .3.9 3.4-.4 6.2-1.6 8.3-3.6z"/></g></svg>');
    --tg-tail-width: 11px;
    --tg-tail-height: 20px;
    /* Apple keeps the bubble's corner round and hangs the tail outside it. */
    --tg-tail-corner: var(--event-tile-bubble-corner-radius, 12px);
    --tg-tail-offset: -6px;
}

/*
 * The last bubble of a run carries the tail. Which message that is, is a fact the timeline already
 * works out (TimelineItem.lastInSection) and the tile states as data-last-in-section; reading it
 * from the DOM instead - "no bubble from the same side straight after me" - held only while the
 * messages were siblings. The virtualised timeline gives each one its own list row, so nothing is
 * anything's sibling and every bubble looked like the last of its run.
 *
 * A message that is only big emoji has no bubble to hang a tail on.
 */
html:is([data-tg-tail="telegram"], [data-tg-tail="imessage"]) .mx_RoomView_body[data-layout="bubble"] {
    .mx_EventTile_tgBubble[data-last-in-section="true"]:not(:has(.mx_EventTile_bigEmoji))
        > [data-testid="event-tile-line"] {
        position: relative;

        &::after {
            content: "";
            position: absolute;
            bottom: 0;
            width: var(--tg-tail-width);
            height: var(--tg-tail-height);
            background: inherit;
            mask-image: var(--tg-tail-shape);
            mask-repeat: no-repeat;
            mask-size: 100% 100%;
            pointer-events: none;
        }

        /*
         * A picture bubble is one silhouette, the way Telegram and iMessage draw it: the photo runs
         * into the tail instead of the tail being a coloured triangle stuck on its corner. The tail
         * hangs outside the picture's box and a mask can only hide, never extend, so the tail is
         * painted with the picture rather than cut out of it - EventTile hands it down as
         * --tg-media-tail (utils/telegram/mediaTail.ts). Unset, the shorthand above still applies
         * and the tail keeps the bubble's colour, which is right for everything that is not a
         * picture, and for encrypted media whose URL does not exist until it is decrypted.
         */
        &.mx_EventTile_tgMediaLine::after {
            background-image: var(--tg-media-tail, none);
            /*
             * At the size the bubble is showing the picture, so the tail holds the few pixels next
             * to the corner rather than the whole picture shrunk into an 11x20 box. Falls back to
             * cover for media whose event did not say how big it is.
             */
            background-size: var(--tg-media-tail-size, cover);
        }
    }

    /* Incoming hangs off the start edge, mirrored; our own off the end. */
    .mx_EventTile_tgBubble:not(.mx_EventTile_tgOwn, :has(.mx_EventTile_bigEmoji))[data-last-in-section="true"]
        > [data-testid="event-tile-line"] {
        border-end-start-radius: var(--tg-tail-corner);

        &::after {
            inset-inline-start: var(--tg-tail-offset);
            transform: translateY(1px);
            /* Grows out of the picture's bottom start corner, so that is the part it continues. */
            background-position: bottom left;
        }

        /* Square the picture there too, or a rounded notch shows where the tail meets it. */
        :is(.mx_MediaBody, .mx_MImageBody, .mx_MVideoBody, .mx_ImageBody_container) {
            border-end-start-radius: var(--tg-tail-corner);
        }
    }

    .mx_EventTile_tgBubble.mx_EventTile_tgOwn:not(:has(.mx_EventTile_bigEmoji))[data-last-in-section="true"]
        > [data-testid="event-tile-line"] {
        border-end-end-radius: var(--tg-tail-corner);

        &::after {
            inset-inline-end: var(--tg-tail-offset);
            transform: translateY(1px);
            /* The mirrored shape rather than a flipped element: flipping would mirror the picture
               painted in it as well, and a photo does not survive being shown backwards. */
            mask-image: var(--tg-tail-shape-end, var(--tg-tail-shape));
            /* Mirrored with the tail, so the picture reads the right way round in it. */
            background-position: bottom right;
        }

        :is(.mx_MediaBody, .mx_MImageBody, .mx_MVideoBody, .mx_ImageBody_container) {
            border-end-end-radius: var(--tg-tail-corner);
        }
    }
}
