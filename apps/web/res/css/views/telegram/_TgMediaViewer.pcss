/*
 * tweb mediaViewer.scss (.media-viewer-whole, -mover, -switcher, -topbar), with --open-duration .2s and
 * --move-duration .35s. The backdrop is translucent + blurred instead of tweb's rgba(0,0,0,.88), and
 * both its dim and its blur fade in with the morph.
 */
.mx_TgMediaViewer {
    --TgMediaViewer-open-duration: 0.2s;
    --TgMediaViewer-move-duration: 0.35s;
    --TgMediaViewer-dim: rgb(0 0 0 / 55%);
    --TgMediaViewer-blur: 24px;

    position: fixed;
    inset: 0;
    /* Under the dialog wrapper (4000), so Forward / Delete open on top of the viewer like tweb's popups. */
    z-index: calc(var(--dialog-zIndex-wrapper-default) - 1);
    user-select: none;
    touch-action: none;
    color: #fff;

    @media (prefers-reduced-motion: reduce) {
        --TgMediaViewer-open-duration: 0s;
        --TgMediaViewer-move-duration: 0s;
    }
}

html[data-low-power] .mx_TgMediaViewer {
    --TgMediaViewer-blur: 0px;
    --TgMediaViewer-dim: rgb(0 0 0 / 88%);
}

.mx_TgMediaViewer_backdrop {
    position: absolute;
    inset: 0;
    background-color: var(--TgMediaViewer-dim);
    opacity: 0;
    backdrop-filter: blur(0);
    -webkit-backdrop-filter: blur(0);
    transition:
        opacity var(--TgMediaViewer-open-duration) ease-in-out,
        backdrop-filter var(--TgMediaViewer-open-duration) ease-in-out,
        -webkit-backdrop-filter var(--TgMediaViewer-open-duration) ease-in-out;

    .mx_TgMediaViewer_active & {
        opacity: 1;
        backdrop-filter: blur(var(--TgMediaViewer-blur));
        -webkit-backdrop-filter: blur(var(--TgMediaViewer-blur));
    }
}

/* The zoom/pan transform lives here (tweb moversContainer, origin 0 0). */
.mx_TgMediaViewer_movers {
    position: absolute;
    inset: 0;
    transform-origin: 0 0;
    transition: transform var(--TgMediaViewer-open-duration);

    &.mx_TgMediaViewer_noTransition,
    &.mx_TgMediaViewer_noTransition .mx_TgMediaViewer_mover {
        transition: none !important;
    }
}

.mx_TgMediaViewer_mover {
    position: absolute;
    left: 0;
    top: 0;
    overflow: hidden;
    transform-origin: 0 0;
    will-change: transform;

    &.mx_TgMediaViewer_mover_active {
        transition:
            transform var(--TgMediaViewer-open-duration),
            border-radius var(--TgMediaViewer-open-duration),
            opacity var(--TgMediaViewer-open-duration);
    }

    &.mx_TgMediaViewer_mover_moving {
        transition: transform var(--TgMediaViewer-move-duration) ease;
    }

    > img,
    > video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    > video {
        object-fit: contain;
        background: #000;
    }
}

.mx_TgMediaViewer_zoomed {
    cursor: grab;
}

/* Chrome: fades in with the backdrop (tweb .media-viewer-appear). */
.mx_TgMediaViewer_chrome {
    opacity: 0;
    transition: opacity var(--TgMediaViewer-open-duration);

    .mx_TgMediaViewer_active & {
        opacity: 1;
    }
}

.mx_TgMediaViewer_topbar {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 0.75rem 0 1.5rem;
    padding-top: env(safe-area-inset-top);
    z-index: 2;
}

/* tweb .media-viewer-author: userpic 44 (hidden on handhelds), name bold, date .875rem. */
.mx_TgMediaViewer_author {
    display: flex;
    align-items: center;
    min-width: 0;
    height: 100%;
    padding: 0;
    border: none;
    background: none;
    color: inherit;
    font: inherit;
    text-align: start;
    cursor: pointer;
}

.mx_TgMediaViewer_userpic {
    flex: none;
    margin-inline-end: 1rem;

    html[data-tg-screen="mobile"] & {
        display: none;
    }
}

.mx_TgMediaViewer_authorText {
    display: flex;
    flex-direction: column;
    min-width: 0;
}

.mx_TgMediaViewer_name {
    font-weight: var(--cpd-font-weight-semibold);
    line-height: 1.3125;
    margin: 0.0625rem 0 0.125rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_TgMediaViewer_date {
    font-size: 0.875rem;
    opacity: 0.7;
}

.mx_TgMediaViewer_buttons {
    display: flex;
    gap: 0.25rem;

    button {
        width: 2.5rem;
        height: 2.5rem;
        padding: 0.5rem;
        border: none;
        border-radius: 50%;
        background: none;
        color: rgb(255 255 255 / 70%);
        cursor: pointer;
        transition:
            color var(--TgMediaViewer-open-duration),
            background-color var(--TgMediaViewer-open-duration);

        &:hover {
            color: #fff;
            background-color: rgb(255 255 255 / 8%);
        }

        svg {
            width: 100%;
            height: 100%;
        }
    }
}

/* tweb .media-viewer-switcher: 7rem side zones, the arrow shows on hover; none on handhelds (swipe). */
.mx_TgMediaViewer_switcher {
    position: absolute;
    top: 3.75rem;
    left: 0;
    width: 7rem;
    height: calc(100% - 3.75rem);
    cursor: pointer;
    z-index: 1;

    &.mx_TgMediaViewer_switcher_right {
        left: auto;
        right: 0;
    }

    html[data-tg-screen="mobile"] & {
        display: none;
    }
}

.mx_TgMediaViewer_sibling {
    position: absolute;
    left: 1rem;
    top: 50%;
    width: 2.5rem;
    height: 2.5rem;
    transform: translateY(-50%);
    color: #fff;
    opacity: 0;
    transition: opacity var(--TgMediaViewer-open-duration);

    .mx_TgMediaViewer_switcher_right & {
        left: auto;
        right: 1rem;
    }

    .mx_TgMediaViewer_switcher:hover & {
        opacity: 1;
    }
}

/* tweb .zoom-container: 17.125rem x 3.375rem, rgba(0,0,0,.4), bottom 1.25rem, shown while zoomed. */
.mx_TgMediaViewer_zoom {
    position: absolute;
    bottom: calc(1.25rem + env(safe-area-inset-bottom));
    left: 50%;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    box-sizing: border-box;
    width: 17.125rem;
    height: 3.375rem;
    padding: 0.5rem;
    border-radius: 12px;
    background-color: rgb(0 0 0 / 40%);
    transform: translateX(-50%);

    &:not(.mx_TgMediaViewer_zoom_visible),
    .mx_TgMediaViewer:not(.mx_TgMediaViewer_active) & {
        opacity: 0;
        pointer-events: none;
    }

    button {
        flex: none;
        width: 2.5rem;
        height: 2.5rem;
        padding: 0.5rem;
        border: none;
        border-radius: 50%;
        background: none;
        color: #fff;
        cursor: pointer;

        &:disabled {
            opacity: 0.4;
            pointer-events: none;
        }

        svg {
            width: 100%;
            height: 100%;
        }
    }

    /* tweb .progress-line: 2px white line, filled up to the value. */
    input[type="range"] {
        flex: 1 1 auto;
        height: 1rem;
        margin: 0 1px;
        background: none;
        appearance: none;
        cursor: pointer;

        &::-webkit-slider-runnable-track {
            height: 2px;
            border-radius: 1px;
            background: linear-gradient(to right, #fff var(--TgMediaViewer-zoom), rgb(255 255 255 / 40%) 0);
        }

        &::-moz-range-track {
            height: 2px;
            border-radius: 1px;
            background: linear-gradient(to right, #fff var(--TgMediaViewer-zoom), rgb(255 255 255 / 40%) 0);
        }

        &::-webkit-slider-thumb {
            width: 12px;
            height: 12px;
            margin-top: -5px;
            border: none;
            border-radius: 50%;
            background: #fff;
            appearance: none;
        }

        &::-moz-range-thumb {
            width: 12px;
            height: 12px;
            border: none;
            border-radius: 50%;
            background: #fff;
        }
    }
}
