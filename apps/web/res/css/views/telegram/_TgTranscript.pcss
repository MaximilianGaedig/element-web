/*
 * What a voice message said, under the voice message (TgTranscript.tsx).
 *
 * It is text inside the bubble, set apart from what anyone wrote by the secondary colour, and it shares
 * its last line with the bubble's time the way a text message does: an invisible copy of the time is
 * floated to the end of the text (the same trick as the message text's, _TelegramMessages.pcss), and the
 * "Transcribe" link keeps the time's width free at its end.
 */
.mx_TgTranscript,
.mx_TgTranscript_button {
    display: block;
    box-sizing: border-box;
    max-width: 100%;
    margin: var(--cpd-space-1x) 0 0;
    padding: 0;
    overflow-wrap: anywhere;
    font: var(--cpd-font-body-md-regular);
    color: var(--cpd-color-text-secondary);
}

.mx_TgTranscript {
    white-space: pre-wrap;

    &::after {
        content: "";
        float: right;
        width: var(--TgTime-width, 0);
        height: var(--TgTime-text-size, 0.75rem);
        margin-inline-start: 0.1875rem;
        visibility: hidden;
        pointer-events: none;
    }
}

.mx_TgTranscript_button {
    /* A link rather than a button: it is an offer, not the point of the message. */
    padding-inline-end: calc(var(--TgTime-width, 0px) + 0.1875rem);
    color: var(--cpd-color-text-action-accent);
    text-align: start;

    svg {
        width: 1em;
        height: 1em;
        margin-inline-end: var(--cpd-space-1x);
        vertical-align: -0.125em;
    }
}

.mx_TgTranscript_working {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-1x);
}
