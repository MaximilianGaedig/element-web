/*
 * Telegram-style message behaviour (setting "telegramStyleLayout", bubble layout).
 *
 * In-bubble time, ported from Telegram Web K (GPL-3.0, https://github.com/morethanwords/tweb),
 * src/scss/partials/_chatBubble.scss `.time`, `.time-inner`, `.time.is-floating` and
 * `.time-sending-status`, with the sizes from src/scss/base.scss (--messages-time-text-size is the
 * message text size - 4px; the status glyph is the text size + 3px; --message-time-background is
 * rgba(0, 0, 0, .35)). tweb's trick: an invisible copy of the time is floated to the end of the
 * last text line, so short last lines keep the time beside them and only a full last line makes
 * the bubble one line taller; the visible copy (.time-inner) is absolutely positioned over it.
 * Here the invisible copy is a floated ::after sized by TelegramTime.tsx (--TgTime-width).
 *
 * The tile classes (mx_EventTile_tgTime, ...) are only set by EventTile in that mode, so these
 * rules need no setting selector; the extra `.mx_RoomView_body` is for specificity over the
 * shared EventTileView CSS module.
 */

/*
 * No tint under the cursor: Telegram never highlights the message row on hover (tweb's `.bubble` has no
 * :hover background - the hover affordances are the actions button and the timestamp). The shared
 * EventTileView takes its hover colour from a variable on the tile, so it is switched off there instead of
 * re-stating that module's selectors; selection, highlight and editing keep their own colours.
 */
[data-bubble-timeline="true"] .mx_EventTile {
    --event-tile-state-hover-background: transparent;
    --event-tile-bubble-hover-background: transparent;
}

[data-bubble-timeline="true"] .mx_EventTile[data-testid="event-tile"].mx_EventTile_tgTime {
    --TgTime-text-size: calc(var(--cpd-font-size-body-md) - 4px);
    --TgTime-status-size: calc(var(--cpd-font-size-body-md) + 3px);
    --TgTime-color: var(--cpd-color-text-secondary);
    --TgTime-status-color: var(--cpd-color-text-secondary);
    /* tweb $message-padding-bottom - 6px below the text box, which is the bubble padding in from the edge. */
    --TgTime-inset-block-end: var(
        --event-tile-bubble-padding-block-end,
        calc(var(--event-tile-bubble-gutter, 5px) - 1px)
    );
    --TgTime-inset-inline-end: calc(
        var(--event-tile-bubble-padding-inline, calc(var(--event-tile-bubble-gutter, 5px) - 1px)) + 1px
    );

    /*
     * Read receipts without the 60px gutter: the tile becomes a wrapping flex row, so the avatars sit
     * right after the bubble, at its end like Element's, and only claim a row of their own when the
     * bubble leaves no room. One-to-one chats show ticks only (MessagePanel telegramTicks).
     */
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;

    > * {
        flex-basis: 100%;
        order: 3;
    }

    > [data-testid="event-tile-slot-sender"] {
        order: 0;
    }

    > [data-testid="event-tile-line"] {
        flex-basis: auto;
        order: 1;
    }

    > [data-testid="event-tile-slot-receipt"] {
        position: static;
        flex-basis: auto;
        order: 2;
        margin-inline-start: auto;
        /*
         * The line reaches past its box by Element's negative end margin, which put the readers on the
         * bubble's edge; with the receipt group's own 4px inset this leaves 4px between them.
         */
        padding-inline-start: calc(-4px - var(--event-tile-bubble-line-margin-inline-end, 0px));
    }

    /* The hover-only timestamp kept 60px free at the end of every bubble. */
    > [data-testid="event-tile-line"]:not(.mx_EventTile_tgMediaLine) {
        padding-inline-end: var(--event-tile-bubble-padding-inline, calc(var(--event-tile-bubble-gutter, 5px) - 1px));
    }

    /* tweb `.time` (the in-flow copy): floated to the end of the last line, invisible. */
    :is(.mx_MTextBody, .mx_MNoticeBody, .mx_MEmoteBody)::after {
        content: "";
        float: right;
        width: var(--TgTime-width, 0);
        height: var(--TgTime-text-size);
        margin-inline-start: 0.1875rem;
        visibility: hidden;
        pointer-events: none;
    }

    /* The float has to share the last line box with the text, so the body must not be a block of its own. */
    :is(.mx_MTextBody, .mx_MNoticeBody) > :is(.mx_EventTile_body, [data-textual-body-annotation-wrapper]):last-child {
        display: inline;
    }

    /*
     * Bodies that are a row rather than a paragraph - a deleted message, one that could not be
     * decrypted - keep the time's width free at their end. The floated copy above cannot do it for
     * them: a float has to share a line box with text, and these are a flex row of icon and label, so
     * without this the time sits on top of "Message deleted".
     */
    :is(.mx_RedactedBody, .mx_DecryptionFailureBody) {
        padding-inline-end: calc(var(--TgTime-width, 0px) + 0.1875rem);
    }

    /* Files and voice/audio players: no text to share a line with, so the time gets its own row. */
    .mx_MediaBody {
        padding-inline-end: var(--cpd-space-3x) !important;
        padding-block-end: calc(var(--TgTime-text-size) + var(--cpd-space-1x));
    }
}

/*
 * Someone else's name, inside their bubble above the text (tweb .bubble .name): the peer's colour,
 * bold, two pixels under the message text with four more of line height, cut short rather than wrapped.
 */
.mx_EventTile_tgName {
    /* The slots around it are display: contents, so it is an item of the bubble's flex row: a row of its own. */
    flex-basis: 100%;
    max-width: 100%;
    overflow: hidden;
    font-size: calc(var(--cpd-font-size-body-md) - 2px);
    line-height: calc(var(--cpd-font-size-body-md) + 2px);
    text-overflow: ellipsis;
    white-space: nowrap;
    user-select: none;

    .mx_DisambiguatedProfile {
        display: inline;
        font: inherit;
        font-weight: 500;
    }

    .mx_DisambiguatedProfile .mx_DisambiguatedProfile_displayName {
        font: inherit;
        font-weight: 500;
    }

    [data-testid="event-tile-line"]:has(> * > &) {
        flex-wrap: wrap;
        row-gap: 0;
    }

    /* In a picture's bubble the name keeps the text's padding, as tweb's does above a photo. */
    .mx_EventTile_tgMediaLine & {
        padding: 4px 8px;
    }
}

/*
 * Link previews the way iMessage draws them: a card the width of the message, tinted a shade of the
 * bubble it sits in rather than a panel colour of its own, and clipped to the bubble's own corners
 * instead of carrying a smaller radius and a border inside them.
 *
 * The tint is a wash of black rather than a named colour, so it darkens whichever bubble it lands
 * on - the blue of one's own messages and the grey of everyone else's - the way iMessage's does,
 * without having to know which one it is.
 */
[data-bubble-timeline="true"] .mx_EventTile.mx_EventTile_tgBubble {
    .mx_MediaPreviewGroup {
        --MediaPreview-width: 100%;

        margin-block-end: 0;
    }

    .mx_MediaPreviewTile {
        border: 0;
        /* The card holds an image that would otherwise square off its corners. */
        overflow: clip;
        border-radius: calc(var(--tg-bubble-radius, 12px) - 2px);
        background: rgb(0 0 0 / 12%);
    }
}

/* tweb `.time-inner`: the visible time, in the bubble's bottom inline-end corner. */
[data-bubble-timeline="true"] .mx_EventTile[data-testid="event-tile"].mx_EventTile_tgTime .mx_TelegramTime {
    position: absolute;
    z-index: 3;
    inset-block-end: var(--TgTime-inset-block-end);
    inset-inline: auto var(--TgTime-inset-inline-end);
    display: flex;
    align-items: center;
    gap: 0;
    width: auto;
    max-width: none;
    height: var(--TgTime-text-size);
    padding: 0;
    font-size: var(--TgTime-text-size);
    line-height: 1;
    white-space: nowrap;
    color: var(--TgTime-color);
    direction: ltr;
    user-select: none;

    .mx_MessageTimestamp {
        display: inline;
        padding: 0;
        font-size: inherit;
        line-height: inherit;
        color: inherit;
    }

    .mx_MessageTimestamp_lateIcon {
        position: static;
        width: 1em;
        height: 1em;
        margin-inline-end: 0.125rem;
    }

    /* tweb `.time-part`s before the time: the disappearing timer. */
    .mx_DisappearingMessageBadge {
        margin-inline-end: 0.375rem;
        font-size: inherit;
        color: inherit;
    }
}

/* tweb `.time-sending-status`: order 5 puts it after the time. */
.mx_TelegramTime_status {
    order: 5;
    display: inline-flex;
    align-items: center;
    font-size: var(--TgTime-status-size, 18px);
    color: var(--TgTime-status-color, currentcolor);

    svg {
        /* The glyphs are drawn on tweb's 19x14 status grid. */
        width: 1em;
        height: calc(1em * 14 / 19);
    }
}

/* tweb's sendingerror: red on any bubble, since a failed reaction marks someone else's message too. */
.mx_TelegramTime[data-send-state="error"] {
    --TgTime-status-color: var(--cpd-color-icon-critical-primary);
}

/* The "!" is a button: tapping it offers resend or delete, as in Telegram's apps. */
.mx_TelegramTime_failedButton {
    padding: 0;
    border: none;
    background: none;
    cursor: pointer;
}

/* tweb `.bubble.is-out`: time and ticks in the outgoing accent, the glyph nudged 2px outwards. */
[data-bubble-timeline="true"] .mx_EventTile[data-testid="event-tile"].mx_EventTile_tgOwn {
    --TgTime-color: var(--cpd-color-text-success-primary);
    --TgTime-status-color: var(--cpd-color-icon-success-primary);

    justify-content: flex-end;

    > [data-testid="event-tile-line"] {
        margin-inline-start: 0;
    }

    > [data-testid="event-tile-slot-receipt"] {
        margin-inline: var(--cpd-space-1x) 0;
    }

    .mx_TelegramTime {
        margin-inline-end: -2px;
    }

    /* Delivered and read are both double ticks, so the weight is what tells them apart, not the colour:
       read is drawn bold. (Compound's accent and success tokens are the same green, and a second hue
       would leave anyone who can't tell them apart without a difference.) Telegram itself has no
       delivered state, so on Telegram chats this stays the read mark only. */
    .mx_TelegramTime[data-send-state="read"] .mx_TelegramTime_status path {
        stroke: currentcolor;
        stroke-width: 1px;
        stroke-linejoin: round;
    }
}

/*
 * tweb `.time.is-floating`: media without a caption, stickers and big emoji show the time as a pill
 * over the bottom inline-end corner.
 */
[data-bubble-timeline="true"] .mx_EventTile[data-testid="event-tile"].mx_EventTile_tgTimeFloating,
[data-bubble-timeline="true"] .mx_EventTile[data-testid="event-tile"].mx_EventTile_tgTime:has(.mx_EventTile_bigEmoji) {
    --TgTime-status-color: #fff;

    .mx_TelegramTime {
        inset-block-end: 0.1875rem;
        inset-inline-end: 0.1875rem;
        height: calc(var(--TgTime-text-size) + 0.375rem);
        padding: 0 0.3125rem;
        margin: 0;
        border-radius: 0.75rem;
        background-color: rgb(0 0 0 / 35%);
        color: #fff;
    }

    :is(.mx_MTextBody, .mx_MNoticeBody, .mx_MEmoteBody)::after {
        content: none;
    }
}

/* tweb `.emoji-big`: no bubble behind a message that is only a few emoji. */
[data-bubble-timeline="true"]
    .mx_EventTile[data-testid="event-tile"].mx_EventTile_tgTime:has(.mx_EventTile_bigEmoji)
    > [data-testid="event-tile-line"] {
    padding-block-end: calc(var(--TgTime-text-size) + 0.5rem);
    background: transparent;
}

/* No receipt gutter at the end of the rows (see the flex row above). */
[data-bubble-timeline="true"][data-layout="bubble"] [data-testid="event-tile"] {
    /* With the line's -12px end margin, outgoing bubbles end 1px out like incoming ones start (_TelegramLayout.pcss). */
    --event-tile-bubble-margin-inline-end: 11px;
    --event-tile-read-receipt-inset-inline-end: 0;

    > [data-testid="event-tile-slot-receipt"] {
        inset-inline-end: 0;
    }
}

/*
 * tweb bubble groups (src/scss/partials/_chatBubble.scss .bubbles-group, _chat.scss .is-chat): a
 * sender's run of incoming messages with a 40px avatar in a column spanning the group. The avatar is
 * sticky at the bottom, so it rides along while the group scrolls and rests next to the last bubble;
 * incoming bubbles are indented 2.875rem from the avatar's edge. Element's own per-tile avatar is
 * hidden inside a run.
 */
.mx_TgSenderRun {
    --TgSenderRun-inset: 8px;

    position: relative;
    list-style: none;

    .mx_TgSenderRun_tiles {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    [data-testid="event-tile"] {
        --event-tile-bubble-margin-inline-start: calc(var(--TgSenderRun-inset) + 2.875rem);
    }

    [data-testid="event-tile-slot-avatar"] {
        display: none;
    }
}

.mx_TgSenderRun_avatarColumn {
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--TgSenderRun-inset);
    z-index: 2;
    display: flex;
    flex-direction: column-reverse;
    width: 40px;
    pointer-events: none;
}

.mx_TgSenderRun_avatar {
    position: sticky;
    bottom: calc(var(--event-tile-bubble-gutter, 5px) / 2);
    pointer-events: all;
    cursor: pointer;
}

/* tweb .can-zoom-fade.zoom-fade -> --bubble-transition-in (.3s standard-in). */
.mx_TgSenderRun_avatar_new {
    animation: mx_TgSenderRun_zoomFade 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
}

@keyframes mx_TgSenderRun_zoomFade {
    from {
        transform: scale3d(0.8, 0.8, 1);
        opacity: 0;
    }

    to {
        transform: scale3d(1, 1, 1);
        opacity: 1;
    }
}

/*
 * Media in a bubble, the way Telegram draws it: the picture fills its bubble rather than floating loose,
 * and the corners follow the message's place in its sender's run - the outside corners keep the full
 * radius, the sides facing the messages above and below are tucked in, and the last one squares off the
 * corner its tail grows from (_TgBubbleTail.pcss).
 *
 * Element's own bubble layout leaves a media line transparent and rounds only its top, because it hangs
 * the timestamp underneath; the Telegram layout puts the time over the picture instead.
 */
[data-bubble-timeline="true"][data-layout="bubble"] {
    --tg-bubble-radius: var(--event-tile-bubble-corner-radius, 12px);
    /* tweb's small radius, for the corners where a bubble meets the next one of the same sender. */
    --tg-bubble-radius-join: 0.375rem;

    .mx_EventTile_tgBubble > [data-testid="event-tile-line"] {
        border-radius: var(--tg-bubble-radius);
    }

    /*
     * The picture is the bubble: give the line the bubble's surface back and clip the media to it.
     *
     * The clipping belongs on the media and never on the line, because the line is also what the
     * action bar is positioned against - absolutely, above its top edge (EventTileView.module.css
     * .slotActionBar) - so a line that clips its overflow hides the hover menu of every picture
     * completely, with nothing to hover back into.
     */
    .mx_EventTile_tgBubble > .mx_EventTile_tgMediaLine {
        background: var(--event-tile-bubble-other-background);

        /*
         * The bubble shows as a hairline around the picture, as tweb's does: the picture is inset
         * by a pixel rather than running to the very edge.
         */
        padding: 1px;

        /*
         * The line's height is the picture's height and nothing else. As a block it was four pixels
         * taller than what it held, which showed as a strip of bubble under every photo; as a column
         * it can only be as tall as its content. Everything else in the line - the time, the action
         * bar, the tail - is positioned rather than in flow, so none of it is affected.
         */
        display: flex;
        flex-direction: column;

        :is(.mx_MediaBody, .mx_MImageBody, .mx_MVideoBody) {
            border-radius: inherit;
            overflow: hidden;
        }

        /*
         * The picture is the bubble, so nothing may sit between it and the bubble's edge.
         * ImageBodyView keeps a margin under its root for the file-info row it can show beneath a
         * picture (ImageBodyView.module.css .root), and in a bubble that is nothing but the picture
         * that margin reads as a strip of bubble background under the image.
         */
        .mx_ImageBody {
            margin-bottom: 0;
        }

        /* And it takes the bubble's corners rather than its own flat 8px inside them. */
        .mx_ImageBody_container {
            border-radius: var(--tg-bubble-radius);
        }

        /*
         * A caption is as wide as its picture and wraps to it, as in Telegram. The line is a column as wide
         * as its widest child, so a long caption set the bubble's width and stretched the picture's box with
         * it (a portrait photo went from 266px to 575px); contained, it adds no width of its own. It also
         * keeps a text bubble's inset rather than running to the bubble's edge.
         */
        .mx_EventTile_caption {
            contain: inline-size;
            padding: 0.25rem 0.5rem 0.375rem 0.625rem;
        }
    }

    .mx_EventTile_tgOwn.mx_EventTile_tgBubble > .mx_EventTile_tgMediaLine {
        background: var(--event-tile-bubble-self-background);
    }

    /*
     * Not the first of its sender's run: tuck in the corner facing the message above. Read from the
     * tile's own state rather than from the message before it in the DOM - see _TgBubbleTail.pcss
     * for why nothing is anything's sibling in the virtualised timeline.
     */
    .mx_EventTile_tgBubble:not(.mx_EventTile_tgOwn)[data-continuation="true"] {
        > [data-testid="event-tile-line"] {
            border-start-start-radius: var(--tg-bubble-radius-join);
        }
    }

    .mx_EventTile_tgOwn[data-continuation="true"] > [data-testid="event-tile-line"] {
        border-start-end-radius: var(--tg-bubble-radius-join);
    }

    /* Not the last of its run: tuck in the corner facing the message below. */
    .mx_EventTile_tgBubble:not(.mx_EventTile_tgOwn):not([data-last-in-section="true"]) {
        > [data-testid="event-tile-line"] {
            border-end-start-radius: var(--tg-bubble-radius-join);
        }
    }

    .mx_EventTile_tgOwn:not([data-last-in-section="true"]) > [data-testid="event-tile-line"] {
        border-end-end-radius: var(--tg-bubble-radius-join);
    }
}

/*
 * Dates and "New" as pills, the way Telegram, WhatsApp and Beeper mark them: a small plate centred over the
 * chat rather than a rule across it with the words in the gap.
 *
 * tweb's .bubble.service.is-date .service-msg (src/scss/partials/_chatBubble.scss): padding .28125rem
 * .625rem, a .875rem corner, the service text size (the message size less 1px) at the bold weight, text
 * centred. tweb paints it with --message-highlighting-color, which it averages out of the chat's
 * wallpaper; there is no wallpaper here, so the plate is the same glass as the top bar it hangs under,
 * which is what keeps it readable over bubbles of either colour as it floats.
 *
 * The same rules draw the floating date (mx_NewTimelinePanel_stickyDate, which is also a mx_TimelineDate),
 * so the one pinned under the bar and the ones in the list are one pill.
 */
[data-bubble-timeline="true"] {
    .mx_TimelineDate,
    .mx_TimelineUnread {
        justify-content: center;
        margin-block: var(--cpd-space-2x);
        background: none;
        border: none;

        > hr {
            display: none;
        }
    }

    /* The pill: the separator's label row, or the read marker's line-with-label turned into one. */
    /* Doubled to outrank the floating date's own pill (_NewTimelinePanel.pcss), whatever the file order. */
    .mx_TimelineDate.mx_TimelineDate > :not(hr),
    .mx_TimelineUnread.mx_TimelineUnread > [role="separator"] {
        display: inline-flex;
        align-items: center;
        gap: var(--cpd-space-1x);
        margin-inline: auto;
        padding: 0.28125rem 0.625rem;
        border: none;
        border-radius: 0.875rem;
        background: var(--tg-glass-background, var(--cpd-color-bg-subtle-secondary));
        backdrop-filter: var(--tg-glass-backdrop, none);
        box-shadow: var(--tg-glass-border, 0 0 transparent), var(--tg-topbar-box-shadow, 0 0 transparent);
        color: var(--cpd-color-text-primary);

        h2,
        span {
            font: var(--cpd-font-body-sm-semibold);
            /* tweb's --messages-service-text-size at the default 16px message size, and its line height. */
            font-size: 15px;
            font-weight: 500;
            line-height: 20px;
            letter-spacing: normal;
            text-transform: none;
            color: inherit;
        }

        /* The jump-to-date chevron only shows on hover, and inside the plate it would widen it. */
        svg {
            width: 14px;
            height: 14px;
        }
    }

    /* The read marker's own box is a row the width of the list; the plate sits in its middle. */
    .mx_TimelineUnread {
        display: flex;
        height: auto;
    }

    /* The floating one had its own look (_NewTimelinePanel.pcss); it takes the pill's instead. */
    .mx_NewTimelinePanel_stickyDate > div {
        box-shadow: var(--tg-topbar-box-shadow, none);
    }
}

/*
 * Bubbles with nothing in them, where messages are on their way (TgMessagesSkeleton): over a chat that
 * is slow to open, and in the row where more history is being fetched. Laid out as the chat is - in
 * its column, from the bottom up, a run from one side closer together - so what arrives replaces
 * something of its own shape.
 */
.mx_TgMessagesSkeleton {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    box-sizing: border-box;
    width: 100%;
    max-width: calc(var(--TelegramLayout-chat-width, 100%) + 2 * var(--RoomView_MessageList-padding, 0px));
    margin-inline: auto;
    padding-inline: var(--RoomView_MessageList-padding, 16px);
    overflow: hidden;
}

/* Over the whole timeline while it opens: TimelineView's cover centres what it is given. */
.mx_TgMessagesSkeleton_opening {
    position: absolute;
    inset: 0;
}

/*
 * Each one a bubble as the timeline draws them (EventTileView's bubble geometry as this layout sets it,
 * above and in _TelegramLayout.pcss): the same two surfaces, the same 15px corners tucked in to tweb's
 * small radius where a bubble meets the next of its run, the same 85% of the column at most, 2.5px
 * between the bubbles of a run and Telegram's 8px between runs. Only the words are missing.
 */
.mx_TgMessagesSkeleton_bubble {
    --skeleton-radius: 15px;
    --skeleton-radius-join: 0.375rem;

    flex: none;
    align-self: flex-start;
    max-width: 85%;
    /* The lines of text it stands for, and the bubble's own padding around them. */
    height: calc(var(--lines, 1) * 1.3125rem + 0.75rem);
    margin-top: 0.5rem;
    border-radius: var(--skeleton-radius);
    background: var(--event-tile-bubble-other-background, var(--cpd-color-gray-300));
    animation: mx_TgMessagesSkeleton_pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;

    /* Not the first of its run: the corner facing the bubble above is tucked in. */
    &.mx_TgMessagesSkeleton_continuation {
        margin-top: 2.5px;
        border-start-start-radius: var(--skeleton-radius-join);
    }

    /* Not the last of its run: the corner facing the bubble below is. */
    &:not(.mx_TgMessagesSkeleton_last) {
        border-end-start-radius: var(--skeleton-radius-join);
    }
}

/* Our own: on the other side, on our surface, with the corners of that side tucked in. */
.mx_TgMessagesSkeleton_own {
    align-self: flex-end;
    background: var(--event-tile-bubble-self-background, var(--cpd-color-green-300));

    &.mx_TgMessagesSkeleton_continuation {
        border-start-start-radius: var(--skeleton-radius);
        border-start-end-radius: var(--skeleton-radius-join);
    }

    &:not(.mx_TgMessagesSkeleton_last) {
        border-end-start-radius: var(--skeleton-radius);
        border-end-end-radius: var(--skeleton-radius-join);
    }
}

.mx_NewTimelinePanel_loadingMessages {
    padding-block: 0.25rem;
}

@keyframes mx_TgMessagesSkeleton_pulse {
    50% {
        opacity: 0.5;
    }
}

@media (prefers-reduced-motion: reduce) {
    .mx_TgMessagesSkeleton_bubble {
        animation: none;
    }
}
