/*
 * Telegram-style message behaviour (setting "telegramStyleLayout", bubble layout).
 *
 * In-bubble time, ported from Telegram Web K (GPL-3.0, https://github.com/morethanwords/tweb),
 * src/scss/partials/_chatBubble.scss `.time`, `.time-inner`, `.time.is-floating` and
 * `.time-sending-status`, with the sizes from src/scss/base.scss (--messages-time-text-size is the
 * message text size - 4px; the status glyph is the text size + 3px; --message-time-background is
 * rgba(0, 0, 0, .35)). tweb's trick: an invisible copy of the time is floated to the end of the
 * last text line, so short last lines keep the time beside them and only a full last line makes
 * the bubble one line taller; the visible copy (.time-inner) is absolutely positioned over it.
 * Here the invisible copy is a floated ::after sized by TelegramTime.tsx (--TgTime-width).
 *
 * The tile classes (mx_EventTile_tgTime, ...) are only set by EventTile in that mode, so these
 * rules need no setting selector; the extra `.mx_RoomView_body` is for specificity over the
 * shared EventTileView CSS module.
 */

/*
 * No tint under the cursor: Telegram never highlights the message row on hover (tweb's `.bubble` has no
 * :hover background - the hover affordances are the actions button and the timestamp). The shared
 * EventTileView takes its hover colour from a variable on the tile, so it is switched off there instead of
 * re-stating that module's selectors; selection, highlight and editing keep their own colours.
 */
.mx_RoomView_body[data-telegram-layout="true"] .mx_EventTile {
    --event-tile-state-hover-background: transparent;
    --event-tile-bubble-hover-background: transparent;
}

.mx_RoomView_body .mx_EventTile[data-testid="event-tile"].mx_EventTile_tgTime {
    --TgTime-text-size: calc(var(--cpd-font-size-body-md) - 4px);
    --TgTime-status-size: calc(var(--cpd-font-size-body-md) + 3px);
    --TgTime-color: var(--cpd-color-text-secondary);
    --TgTime-status-color: var(--cpd-color-text-secondary);
    /* tweb $message-padding-bottom - 6px below the text box, which is the bubble padding in from the edge. */
    --TgTime-inset-block-end: calc(var(--event-tile-bubble-gutter, 5px) - 1px);
    --TgTime-inset-inline-end: var(--event-tile-bubble-gutter, 5px);

    /*
     * Read receipts without the 60px gutter: the tile becomes a wrapping flex row, so the avatars sit
     * right after the bubble, at its end like Element's, and only claim a row of their own when the
     * bubble leaves no room. One-to-one chats show ticks only (MessagePanel telegramTicks).
     */
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;

    > * {
        flex-basis: 100%;
        order: 3;
    }

    > [data-testid="event-tile-slot-sender"] {
        order: 0;
    }

    > [data-testid="event-tile-line"] {
        flex-basis: auto;
        order: 1;
    }

    > [data-testid="event-tile-slot-receipt"] {
        position: static;
        flex-basis: auto;
        order: 2;
        margin-inline-start: auto;
    }

    /* The hover-only timestamp kept 60px free at the end of every bubble. */
    > [data-testid="event-tile-line"]:not(.mx_EventTile_tgMediaLine) {
        padding-inline-end: calc(var(--event-tile-bubble-gutter, 5px) - 1px);
    }

    /* tweb `.time` (the in-flow copy): floated to the end of the last line, invisible. */
    :is(.mx_MTextBody, .mx_MNoticeBody, .mx_MEmoteBody)::after {
        content: "";
        float: right;
        width: var(--TgTime-width, 0);
        height: var(--TgTime-text-size);
        margin-inline-start: 0.1875rem;
        visibility: hidden;
        pointer-events: none;
    }

    /* The float has to share the last line box with the text, so the body must not be a block of its own. */
    :is(.mx_MTextBody, .mx_MNoticeBody) > :is(.mx_EventTile_body, [data-textual-body-annotation-wrapper]):last-child {
        display: inline;
    }

    /* Files and voice/audio players: no text to share a line with, so the time gets its own row. */
    .mx_MediaBody {
        padding-inline-end: var(--cpd-space-3x) !important;
        padding-block-end: calc(var(--TgTime-text-size) + var(--cpd-space-1x));
    }
}

/* tweb `.time-inner`: the visible time, in the bubble's bottom inline-end corner. */
.mx_RoomView_body .mx_EventTile[data-testid="event-tile"].mx_EventTile_tgTime .mx_TelegramTime {
    position: absolute;
    z-index: 3;
    inset-block-end: var(--TgTime-inset-block-end);
    inset-inline: auto var(--TgTime-inset-inline-end);
    display: flex;
    align-items: center;
    gap: 0;
    width: auto;
    max-width: none;
    height: var(--TgTime-text-size);
    padding: 0;
    font-size: var(--TgTime-text-size);
    line-height: 1;
    white-space: nowrap;
    color: var(--TgTime-color);
    direction: ltr;
    user-select: none;

    .mx_MessageTimestamp {
        display: inline;
        padding: 0;
        font-size: inherit;
        line-height: inherit;
        color: inherit;
    }

    .mx_MessageTimestamp_lateIcon {
        position: static;
        width: 1em;
        height: 1em;
        margin-inline-end: 0.125rem;
    }

    /* tweb `.time-part`s before the time: the disappearing timer. */
    .mx_DisappearingMessageBadge {
        margin-inline-end: 0.375rem;
        font-size: inherit;
        color: inherit;
    }
}

/* tweb `.time-sending-status`: order 5 puts it after the time. */
.mx_TelegramTime_status {
    order: 5;
    display: inline-flex;
    align-items: center;
    font-size: var(--TgTime-status-size, 18px);
    color: var(--TgTime-status-color, currentcolor);

    svg {
        /* The glyphs are drawn on tweb's 19x14 status grid. */
        width: 1em;
        height: calc(1em * 14 / 19);
    }
}

/* tweb `.bubble.is-out`: time and ticks in the outgoing accent, the glyph nudged 2px outwards. */
.mx_RoomView_body .mx_EventTile[data-testid="event-tile"].mx_EventTile_tgOwn {
    --TgTime-color: var(--cpd-color-text-success-primary);
    --TgTime-status-color: var(--cpd-color-icon-success-primary);

    justify-content: flex-end;

    > [data-testid="event-tile-line"] {
        margin-inline-start: 0;
    }

    > [data-testid="event-tile-slot-receipt"] {
        margin-inline: var(--cpd-space-1x) 0;
    }

    .mx_TelegramTime {
        margin-inline-end: -2px;
    }

    .mx_TelegramTime[data-send-state="error"] {
        --TgTime-status-color: var(--cpd-color-icon-critical-primary);
    }
}

/*
 * tweb `.time.is-floating`: media without a caption, stickers and big emoji show the time as a pill
 * over the bottom inline-end corner.
 */
.mx_RoomView_body .mx_EventTile[data-testid="event-tile"].mx_EventTile_tgTimeFloating,
.mx_RoomView_body .mx_EventTile[data-testid="event-tile"].mx_EventTile_tgTime:has(.mx_EventTile_bigEmoji) {
    --TgTime-status-color: #fff;

    .mx_TelegramTime {
        inset-block-end: 0.1875rem;
        inset-inline-end: 0.1875rem;
        height: calc(var(--TgTime-text-size) + 0.375rem);
        padding: 0 0.3125rem;
        margin: 0;
        border-radius: 0.75rem;
        background-color: rgb(0 0 0 / 35%);
        color: #fff;
    }

    :is(.mx_MTextBody, .mx_MNoticeBody, .mx_MEmoteBody)::after {
        content: none;
    }
}

/* tweb `.emoji-big`: no bubble behind a message that is only a few emoji. */
.mx_RoomView_body
    .mx_EventTile[data-testid="event-tile"].mx_EventTile_tgTime:has(.mx_EventTile_bigEmoji)
    > [data-testid="event-tile-line"] {
    padding-block-end: calc(var(--TgTime-text-size) + 0.5rem);
    background: transparent;
}

/* No receipt gutter at the end of the rows (see the flex row above). */
.mx_RoomView_body[data-telegram-layout="true"][data-layout="bubble"] [data-testid="event-tile"] {
    /* With the line's -12px end margin, outgoing bubbles end 1px out like incoming ones start (_TelegramLayout.pcss). */
    --event-tile-bubble-margin-inline-end: 11px;
    --event-tile-read-receipt-inset-inline-end: 0;

    > [data-testid="event-tile-slot-receipt"] {
        inset-inline-end: 0;
    }
}

/*
 * tweb bubble groups (src/scss/partials/_chatBubble.scss .bubbles-group, _chat.scss .is-chat): a
 * sender's run of incoming messages with a 40px avatar in a column spanning the group. The avatar is
 * sticky at the bottom, so it rides along while the group scrolls and rests next to the last bubble;
 * incoming bubbles are indented 2.875rem from the avatar's edge. Element's own per-tile avatar is
 * hidden inside a run.
 */
.mx_TgSenderRun {
    --TgSenderRun-inset: 8px;

    position: relative;
    list-style: none;

    .mx_TgSenderRun_tiles {
        margin: 0;
        padding: 0;
        list-style: none;
    }

    [data-testid="event-tile"] {
        --event-tile-bubble-margin-inline-start: calc(var(--TgSenderRun-inset) + 2.875rem);
    }

    [data-testid="event-tile-slot-avatar"] {
        display: none;
    }
}

.mx_TgSenderRun_avatarColumn {
    position: absolute;
    inset-block: 0;
    inset-inline-start: var(--TgSenderRun-inset);
    z-index: 2;
    display: flex;
    flex-direction: column-reverse;
    width: 40px;
    pointer-events: none;
}

.mx_TgSenderRun_avatar {
    position: sticky;
    bottom: calc(var(--event-tile-bubble-gutter, 5px) / 2);
    pointer-events: all;
    cursor: pointer;
}

/* tweb .can-zoom-fade.zoom-fade -> --bubble-transition-in (.3s standard-in). */
.mx_TgSenderRun_avatar_new {
    animation: mx_TgSenderRun_zoomFade 0.3s cubic-bezier(0.4, 0, 0.2, 1) both;
}

@keyframes mx_TgSenderRun_zoomFade {
    from {
        transform: scale3d(0.8, 0.8, 1);
        opacity: 0;
    }

    to {
        transform: scale3d(1, 1, 1);
        opacity: 1;
    }
}

/*
 * Media in a bubble, the way Telegram draws it: the picture fills its bubble rather than floating loose,
 * and the corners follow the message's place in its sender's run - the outside corners keep the full
 * radius, the sides facing the messages above and below are tucked in, and the last one squares off the
 * corner its tail grows from (_TgBubbleTail.pcss).
 *
 * Element's own bubble layout leaves a media line transparent and rounds only its top, because it hangs
 * the timestamp underneath; the Telegram layout puts the time over the picture instead.
 */
html[data-tg-screen] .mx_RoomView_body[data-layout="bubble"] {
    --tg-bubble-radius: var(--event-tile-bubble-corner-radius, 12px);
    /* tweb's small radius, for the corners where a bubble meets the next one of the same sender. */
    --tg-bubble-radius-join: 0.375rem;

    .mx_EventTile_tgBubble > [data-testid="event-tile-line"] {
        border-radius: var(--tg-bubble-radius);
    }

    /* The picture is the bubble: give the line the bubble's surface back and clip the media to it. */
    .mx_EventTile_tgBubble > .mx_EventTile_tgMediaLine {
        overflow: hidden;
        background: var(--event-tile-bubble-other-background);

        :is(.mx_MediaBody, .mx_MImageBody, .mx_MVideoBody) {
            border-radius: inherit;
        }
    }

    .mx_EventTile_tgOwn.mx_EventTile_tgBubble > .mx_EventTile_tgMediaLine {
        background: var(--event-tile-bubble-self-background);
    }

    /* Not the first of its sender's run: tuck in the corner facing the message above. */
    .mx_EventTile_tgBubble:not(.mx_EventTile_tgOwn) + .mx_EventTile_tgBubble:not(.mx_EventTile_tgOwn) {
        > [data-testid="event-tile-line"] {
            border-start-start-radius: var(--tg-bubble-radius-join);
        }
    }

    .mx_EventTile_tgOwn + .mx_EventTile_tgOwn > [data-testid="event-tile-line"] {
        border-start-end-radius: var(--tg-bubble-radius-join);
    }

    /* Not the last of its run: tuck in the corner facing the message below. */
    .mx_EventTile_tgBubble:not(.mx_EventTile_tgOwn):has(+ .mx_EventTile_tgBubble:not(.mx_EventTile_tgOwn)) {
        > [data-testid="event-tile-line"] {
            border-end-start-radius: var(--tg-bubble-radius-join);
        }
    }

    .mx_EventTile_tgOwn:has(+ .mx_EventTile_tgOwn) > [data-testid="event-tile-line"] {
        border-end-end-radius: var(--tg-bubble-radius-join);
    }
}
