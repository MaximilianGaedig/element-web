/*
 * What needs you, over the list of chats (TgDigest.tsx).
 *
 * Unasked it is one quiet button; asked it becomes a few lines with the chats it names. It sits above
 * the list rather than in it, because it is about the list rather than part of it.
 *
 * It is a child of a column with a fixed height, so it has to say both of these or it loses: it will not
 * shrink (a tall answer was being squeezed to nothing and read as a blank card), and past a share of the
 * height it scrolls itself rather than pushing the chats off the screen.
 */
/*
 * The button is Element's own (AccessibleButton, Compound tokens): it is placed here, not restyled here.
 * A bespoke glass pill in the middle of the room list looks like something from another app, which is
 * exactly what it looked like.
 */
.mx_TgDigest_ask {
    display: flex;
    align-self: center;
    align-items: center;
    justify-content: center;
    gap: var(--cpd-space-1x);
    width: fit-content;
    margin: var(--cpd-space-2x) auto;

    svg {
        width: 1em;
        height: 1em;
    }
}

.mx_TgDigest {
    /* An Element panel: the app's own surface and radius, not a glass slab of its own. */
    position: relative;
    display: flex;
    flex: 0 0 auto;
    flex-direction: column;
    min-height: 0;
    max-height: min(24rem, 45%);
    overflow: hidden;
    margin: var(--cpd-space-2x) var(--cpd-space-3x);
    padding: var(--cpd-space-3x);
    border-radius: 8px;
    background: var(--cpd-color-bg-subtle-secondary);
    font: var(--cpd-font-body-sm-regular);

    .mx_TgDigest_head {
        flex: 0 0 auto;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--cpd-space-2x);
    }

    /* The one magical thing, the same one the answers in the timeline carry. */
    .mx_TgDigest_spark {
        width: 1em;
        height: 1em;
        margin-inline-end: var(--cpd-space-1x);
        color: #7a5cff;
        animation: mx_TgAiNote_spark 4s ease-in-out infinite;
    }

    /* Everything that can run long, scrolling on its own. */
    .mx_TgDigest_body {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
    }

    .mx_TgDigest_title {
        font: var(--cpd-font-body-sm-medium);
        color: var(--cpd-color-text-secondary);
    }

    .mx_TgDigest_spacer {
        flex: 1 1 auto;
    }

    .mx_TgDigest_info {
        color: var(--cpd-color-text-secondary);

        svg {
            display: block;
            width: 16px;
            height: 16px;
        }
    }

    .mx_TgDigest_close svg {
        width: 16px;
        height: 16px;
    }

    .mx_TgDigest_text {
        margin: var(--cpd-space-1x) 0 0;
        font: var(--cpd-font-body-sm-regular);
        color: var(--cpd-color-text-primary);

        /* Markdown, rendered by the message pipeline: give its lists and paragraphs sane spacing. */
        :is(p, ul, ol) {
            margin: 0 0 var(--cpd-space-1x);
        }

        :is(ul, ol) {
            padding-inline-start: var(--cpd-space-5x);
        }

        > :last-child {
            margin-block-end: 0;
        }
    }

    .mx_TgDigest_doing,
    .mx_TgDigest_failed {
        margin: var(--cpd-space-1x) 0 0;
        color: var(--cpd-color-text-secondary);
    }

    .mx_TgDigest_failed {
        color: var(--cpd-color-text-critical-primary);
    }

    /* A chat that is waiting, and something to send it. */
    .mx_TgDigest_chat {
        margin-block-start: var(--cpd-space-2x);
    }

    .mx_TgDigest_chatName {
        font: var(--cpd-font-body-sm-medium);
        color: var(--cpd-color-text-primary);
    }

    /*
     * The drafts scroll sideways rather than wrapping: three long replies wrapping into six lines is the
     * card growing past what it is worth, for every chat in the list.
     */
    .mx_TgDigest_drafts {
        display: flex;
        gap: var(--cpd-space-2x);
        margin-block-start: var(--cpd-space-1x);
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scrollbar-width: none;

        &::-webkit-scrollbar {
            display: none;
        }
    }

    .mx_TgDigest_draft {
        flex: 0 0 auto;
        max-width: 18rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    /* What was sent, said plainly - the same fact the answers in the timeline state. */
    .mx_TgDigest_sent {
        margin: var(--cpd-space-2x) 0 0;
        font: var(--cpd-font-body-xs-regular);
        color: var(--cpd-color-text-secondary);
    }

    .mx_TgDigest_cites {
        display: flex;
        flex-wrap: wrap;
        gap: var(--cpd-space-2x);
        margin: var(--cpd-space-2x) 0 0;
    }
}

/* Being written: the sheen the answers in the timeline use, behind the words, moving nothing. */
.mx_TgDigest_writing {
    &::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(110deg, transparent 30%, rgb(122 92 255 / 18%) 50%, transparent 70%);
        background-size: 250% 100%;
        animation: mx_TgAiNote_sheen 1.8s linear infinite;
        pointer-events: none;
    }
}

@media (prefers-reduced-motion: reduce) {
    .mx_TgDigest_writing::after,
    .mx_TgDigest .mx_TgDigest_spark {
        animation: none;
    }
}
