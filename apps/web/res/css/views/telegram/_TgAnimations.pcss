/*
 * Telegram Web K's transitions (GPL-3.0) for the Telegram-style layout:
 *   src/scss/partials/_chat.scss   .chat:not(.active): a chat pushed from inside another one comes in
 *                                  from translate3d(200px, 0, 0) and opacity 0 with --tabs-transition;
 *                                  .reply-wrapper: the composer's reply/edit helper grows from 0 to its
 *                                  height with --transition-standard-out.
 * The message "ladder" on opening a chat runs from JS (ladder.ts), the side panel in _TgPanes.pcss,
 * the handheld columns in _TgColumns.pcss and the sheets in _TgHandheld.pcss.
 */

.mx_TgColumns_chat {
    position: relative;
    height: 100%;

    &[data-pushed] {
        animation: mx_TgChat_push var(--tg-tabs-transition);
    }

    /*
     * The pane stays the same element from one chat to the next (the rooms inside it are kept mounted),
     * and an animation only starts again when its name changes: the second of two chats pushed in a row
     * runs the same keyframes under this name.
     */
    &[data-pushed="again"] {
        animation-name: mx_TgChat_pushAgain;
    }
}

@keyframes mx_TgChat_push {
    from {
        transform: translate3d(200px, 0, 0);
        opacity: 0;
    }

    to {
        transform: translateZ(0);
        opacity: 1;
    }
}

@keyframes mx_TgChat_pushAgain {
    from {
        transform: translate3d(200px, 0, 0);
        opacity: 0;
    }

    to {
        transform: translateZ(0);
        opacity: 1;
    }
}

/* The reply helper sits inside the composer plate and opens like tweb's .reply-wrapper. */
html[data-floating-bars] .mx_RoomView_body .mx_ReplyPreview {
    display: grid;
    grid-template-rows: 1fr;
    border: none;
    border-radius: 0;
    background: none;
    box-shadow: none;
    animation: mx_TgHelper_in var(--tg-transition-standard-out);

    .mx_ReplyPreview_section {
        min-height: 0;
        overflow: hidden;
        border-bottom: none;
    }
}

/* Editing happens in the message itself in Element; the editor fades in over the helper's timing. */
html[data-floating-bars] .mx_EditMessageComposer {
    animation: mx_TgFade_in var(--tg-transition-standard-out);
}

@keyframes mx_TgHelper_in {
    from {
        grid-template-rows: 0fr;
        opacity: 0;
    }

    to {
        grid-template-rows: 1fr;
        opacity: 1;
    }
}

/*
 * A new message arriving in the open chat. The timeline adds it below the end of the list and scrolls
 * up to it (TimelineView, `animateNewMessages`), marking its row for the moment that takes; this is
 * the message itself coming in.
 *
 * Someone else's grows in from its own side, fading: Telegram Web's `zoom-fade` (tweb
 * `scss/partials/_chatBubble.scss`: from `scale3d(.8, .8, 1)` and transparent, origin "left center"
 * for an incoming bubble, over `--transition-standard-in`, .3s cubic-bezier(.4, 0, .2, 1)).
 *
 * Our own lands from slightly large with a small bounce, from its side: a quarter of a second, opaque
 * and at size by 80% of it, then 1.05 and back.
 *
 * `backwards`, so nothing of the animation is left on the tile afterwards: a transform would make it
 * the containing block of whatever it positions (menus, the reaction picker).
 */
@media (prefers-reduced-motion: no-preference) {
    [data-bubble-timeline="true"] .mx_TimelineView_tile[data-just-added] .mx_EventTile[data-testid="event-tile"] {
        transform-origin: left center;
        animation: mx_TgMessage_in 0.3s cubic-bezier(0.4, 0, 0.2, 1) backwards;
    }

    [data-bubble-timeline="true"]
        .mx_TimelineView_tile[data-just-added]
        .mx_EventTile[data-testid="event-tile"].mx_EventTile_tgOwn {
        transform-origin: right center;
        animation: mx_TgMessage_sent 0.25s linear backwards;
    }
}

@keyframes mx_TgMessage_in {
    from {
        transform: scale3d(0.8, 0.8, 1);
        opacity: 0;
    }
}

@keyframes mx_TgMessage_sent {
    0% {
        transform: scale(1.3);
        opacity: 0;
    }

    80% {
        transform: scale(1);
        opacity: 1;
    }

    90% {
        transform: scale(1.05);
    }

    100% {
        transform: scale(1);
    }
}
