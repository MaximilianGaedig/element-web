/*
 * Handhelds: every popup is a sheet, as in Telegram iOS. Dialogs are bottom sheets with a grabber and drag to
 * dismiss (the settings are tall ones); menus are action sheets (full-width rows, at least 48px, a rounded
 * card above the home indicator, the page dimmed behind); pickers are sheets too; the footer buttons of a
 * dialog are stacked full-width targets; text fields are 16px so the browser doesn't zoom into them; hover
 * tooltips, which can't be reached by touch, are gone. TgSheets.ts adds the drag gesture.
 */
html[data-tg-screen="mobile"] {
    /* ---- Action sheets: context menus ------------------------------------------------------ */
    .mx_ContextualMenu_background {
        background: rgb(0 0 0 / 32%);
        animation: mx_TgSheet_fade 0.2s ease both;
    }

    /* The quick settings menu stays Element's own popover: it is a panel of controls, not a list of actions. */
    &:has(.mx_QuickSettingsButton_ContextMenuWrapper) .mx_ContextualMenu_background {
        background: transparent;
        animation: none;
    }

    /* Menus are drawers, the profile drawer's twins: a plain surface with a 28px top edge and a grabber, full
       width at the bottom of the screen, the page dimmed behind. */
    .mx_ContextualMenu_wrapper:not(.mx_QuickSettingsButton_ContextMenuWrapper) {
        position: fixed !important;
        inset: auto 0 0 0 !important;
        transform: none !important;
        box-sizing: border-box;
        width: 100%;
        padding: 0;

        > .mx_ContextualMenu,
        > .mx_ContextualMenu_wrapper_inner {
            position: relative !important;
            width: 100% !important;
            max-width: none !important;
            max-height: min(78dvh, 40rem);
            overflow-y: auto;
            overscroll-behavior: contain;
            padding-top: 1.25rem;
            padding-bottom: var(--tg-safe-bottom, 0px);
            border: none;
            border-radius: 1.75rem 1.75rem 0 0;
            background: var(--cpd-color-bg-canvas-default);
            box-shadow: none;
            animation: mx_TgDrawer_in 0.26s cubic-bezier(0.2, 0.8, 0.2, 1) both;
            touch-action: pan-y;

            &::before {
                content: "";
                position: absolute;
                top: 0.5rem;
                inset-inline: 0;
                width: 2.25rem;
                height: 0.3125rem;
                margin-inline: auto;
                border-radius: 0.25rem;
                background: var(--cpd-color-bg-subtle-primary);
            }
        }
    }

    /* Rows: 52px targets, 17px text, hairline separators. */
    .mx_ContextualMenu_wrapper:not(.mx_QuickSettingsButton_ContextMenuWrapper) .mx_IconizedContextMenu {
        min-width: 0 !important;
        width: 100%;

        .mx_IconizedContextMenu_option,
        .mx_IconizedContextMenu_item,
        [role="menuitem"] {
            min-height: 3.25rem;
            padding-block: 0.5rem;
            font-size: 1.0625rem;
            line-height: 1.375rem;
        }

        .mx_IconizedContextMenu_icon {
            width: 1.5rem;
            height: 1.5rem;
        }

        .mx_IconizedContextMenu_optionList + .mx_IconizedContextMenu_optionList {
            border-top: 0.5rem solid var(--cpd-color-bg-subtle-secondary);
        }
    }

    /* The reaction row of the message menu: bigger targets. */
    .mx_MessageMenuReactions {
        justify-content: space-around;
        padding: 0.625rem 0.5rem;
    }

    .mx_MessageMenuReactions_emoji,
    .mx_MessageMenuReactions_more {
        width: 2.75rem;
        height: 2.75rem;
        font-size: 1.625rem;
    }

    /* ---- Dialogs ---------------------------------------------------------------------------- */
    .mx_Dialog_background {
        background: rgb(0 0 0 / 38%);
    }

    /* A drawer, like the user menu's: one plain surface with a 28px top edge. Element's glass frame
       (a tinted 12px border with an outline) is for floating desktop dialogs and looks wrong on a sheet. */
    .mx_Dialog_wrapper:not(.mx_Dialog_lightbox, .mx_Dialog_spinner) {
        .mx_Dialog_border {
            padding: 0 !important;
            background: none !important;
            outline: none !important;
            border: none !important;
            box-shadow: none !important;
            border-radius: 1.75rem 1.75rem 0 0 !important;
        }

        .mx_Dialog {
            background-color: var(--cpd-color-bg-canvas-default);
            border-radius: 1.75rem 1.75rem 0 0;
        }

        /* No grabber: Element's own drawers don't draw one either. */
        .mx_Dialog_border::before {
            display: none !important;
        }
    }

    /* Footer buttons: stacked, full width, primary first. */
    .mx_Dialog_buttons,
    .mx_Dialog_buttons_row {
        display: flex;
        flex-direction: column-reverse;
        align-items: stretch;
        gap: 0.5rem;
        width: 100%;
    }

    .mx_Dialog button.mx_LegacyDialogButton,
    .mx_Dialog input.mx_LegacyDialogButton[type="submit"],
    .mx_Dialog_buttons .mx_Dialog_primary,
    .mx_Dialog_buttons .mx_Dialog_cancelButton,
    .mx_Dialog_buttons button {
        min-height: 3rem;
        margin: 0;
        border-radius: 0.875rem;
        font-size: 1.0625rem;
    }

    /* Search is a full-height sheet. */
    .mx_Dialog_wrapper:has(.mx_SpotlightDialog) .mx_Dialog_border {
        height: calc(100dvh - var(--tg-safe-top, 0px) - 0.5rem);
    }

    /* ---- Fields ------------------------------------------------------------------------------ */
    input:not([type="checkbox"], [type="radio"], [type="range"]),
    textarea,
    select,
    [contenteditable="true"] {
        font-size: 1rem;
    }

    /* ---- The composer's sticker/emoji panel and other panels keep clear of the home indicator -- */
    .mx_TgEmoticonsDropdown {
        padding-bottom: var(--tg-safe-bottom, 0px);
    }
}

@keyframes mx_TgSheet_fade {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

/* Hover tooltips can't be reached by touch. */
@media (hover: none) {
    [role="tooltip"],
    [data-radix-popper-content-wrapper]:has([role="tooltip"]) {
        display: none !important;
    }
}

@media (prefers-reduced-motion: reduce) {
    html[data-tg-screen="mobile"] {
        .mx_ContextualMenu_background,
        .mx_ContextualMenu_wrapper > .mx_ContextualMenu,
        .mx_Dialog_wrapper .mx_Dialog_border {
            animation-duration: 0.01ms;
        }
    }
}

/*
 * Settings on a handheld: a full-height drawer whose first screen is your profile and the list of sections
 * (Element's own menu look: plain rows, secondary-colour icons, hairlines), and whose second screen is the
 * chosen section under a bar with a back arrow. The desktop layout is untouched.
 */
.mx_SettingsNavBar {
    display: none;
}

/* The settings sheet: the profile drawer's twin. Same surface, same 28px edge, same grabber; the dialog's
   own close button is left out because the bar has one. */
:root[data-tg-screen="mobile"] {
    /* The bar carries the close button, so the dialog's own would be the second one. */
    .mx_Dialog_wrapper:has(:is(.mx_UserSettingsDialog, .mx_RoomSettingsDialog, .mx_SpaceSettingsDialog))
        .mx_Dialog_cancelButton {
        display: none;
    }

    .mx_UserSettingsDialog,
    .mx_RoomSettingsDialog,
    .mx_SpaceSettingsDialog {
        position: relative;
        height: calc(100dvh - var(--tg-safe-top, 0px) - 1.5rem);
        background: var(--cpd-color-bg-canvas-default);

        &::before {
            content: "";
            position: absolute;
            top: 0.5rem;
            inset-inline: 0;
            margin-inline: auto;
            width: 2.25rem;
            height: 0.3125rem;
            border-radius: 0.25rem;
            background: var(--cpd-color-bg-subtle-primary);
        }

        /* The navigation bar replaces the dialog's own header wherever one is rendered. */
        .mx_Dialog_header,
        > h2,
        .mx_UserSettingsDialog_title {
            display: none;
        }
    }

    .mx_SettingsDialog_content {
        display: flex;
        flex-direction: column;
        height: 100%;
        min-height: 0;
    }

    .mx_SettingsNavBar {
        display: grid;
        grid-template-columns: 3rem 1fr 3rem;
        align-items: center;
        flex: 0 0 auto;
        min-height: 3.5rem;
        padding: 1rem 0.5rem 0;
    }

    .mx_SettingsNavBar_title {
        text-align: center;
        font: var(--cpd-font-body-lg-semibold);
        color: var(--cpd-color-text-primary);
    }

    .mx_SettingsNavBar_back,
    .mx_SettingsNavBar_done {
        all: unset;
        display: grid;
        place-items: center;
        width: 2.75rem;
        height: 2.75rem;
        border-radius: 50%;
        color: var(--cpd-color-icon-primary);
        cursor: pointer;

        svg {
            width: 1.5rem;
            height: 1.5rem;
        }

        &:hover {
            background: var(--cpd-color-bg-action-tertiary-hovered);
        }

        &:focus-visible {
            outline: 2px solid var(--cpd-color-border-focused);
        }
    }

    .mx_SettingsNavBar_done {
        justify-self: end;
    }

    /* The user settings' sections are listed in the user menu's drawer, so the dialog is only ever a
       page. The room settings carry their own list, and show one screen at a time. */
    .mx_UserSettingsDialog .mx_TabbedView_tabsOnLeft .mx_TabbedView_tabLabels,
    .mx_SettingsDialog_content[data-page="page"] .mx_TabbedView_tabsOnLeft .mx_TabbedView_tabLabels {
        display: none;
    }

    .mx_SettingsDialog_content[data-page="list"] .mx_TabbedView_tabPanel {
        display: none;
    }

    /* The list: plain rows, like the user menu's. */
    .mx_RoomSettingsDialog .mx_TabbedView_tabsOnLeft .mx_TabbedView_tabLabels {
        display: flex;
        flex-direction: column;
        gap: 0;
        width: auto;
        max-width: none;
        margin: 0;
        padding: 0 0 1rem;
        list-style: none;
    }

    .mx_RoomSettingsDialog .mx_TabbedView_tabLabel {
        position: relative;
        display: flex;
        gap: 1rem;
        align-items: center;
        justify-content: flex-start;
        min-height: 3.25rem;
        padding: 0.5rem 2.5rem 0.5rem 1.25rem;
        border-radius: 0;
        font: var(--cpd-font-body-lg-regular);
        color: var(--cpd-color-text-primary);
        white-space: normal;

        > svg {
            flex: 0 0 auto;
            width: 1.5rem;
            height: 1.5rem;
            color: var(--cpd-color-icon-secondary);
            fill: currentcolor;
        }

        &::after {
            content: "›";
            position: absolute;
            inset-inline-end: 1.25rem;
            color: var(--cpd-color-icon-secondary);
            font-size: 1.5rem;
        }

        & + .mx_TabbedView_tabLabel::before {
            content: "";
            position: absolute;
            top: 0;
            inset-inline: 3.75rem 0;
            border-top: 1px solid var(--cpd-color-border-disabled);
        }
    }

    /* The responsive strip hides the words on narrow screens; this list has room and needs them. */
    .mx_RoomSettingsDialog .mx_TabbedView_tabsOnLeft.mx_TabbedView_responsive {
        .mx_TabbedView_tabLabel_text {
            display: inline;
        }

        .mx_TabbedView_tabPanel {
            margin-left: 0;
        }
    }

    .mx_SettingsDialog_content .mx_TabbedView {
        flex: 1 1 auto;
        min-height: 0;
        overflow-y: auto;
        padding: 0;
    }

    .mx_UserSettingsDialog .mx_TabbedView_tabsOnLeft.mx_TabbedView_responsive .mx_TabbedView_tabPanel {
        margin: 0;
        padding: 0 0 1rem;
        overflow-y: auto;
    }

    /* Settings written for a wide pane: on a phone their fixed widths must give way to the screen's. */
    .mx_SettingsDialog_content .mx_TabbedView_tabPanelContent {
        .mx_SettingsSection_newUi {
            align-items: stretch;
        }

        .mx_SettingsSection,
        .mx_SettingsSubsection,
        .mx_SettingsSubsection_dropdown,
        .mx_Dropdown,
        .mx_CopyableText,
        form {
            min-width: 0;
            max-width: 100%;
        }

        /* Its padding and border were added to its 100%. */
        .mx_CopyableText {
            box-sizing: border-box;
        }

        .mx_ImageSizePanel_radios {
            flex-wrap: wrap;

            > label {
                margin-right: 0;
            }
        }

        /* Dropdowns take the width there is, all alike. */
        .mx_Dropdown,
        .mx_SettingsDropdown .mx_Dropdown_input,
        .mx_SettingsSubsection_dropdown .mx_Dropdown_input {
            width: 100%;
        }
    }
}
