/*
 * The text a picture was read to hold (TgLiveText.tsx), laid over the picture where it was read from.
 *
 * Each word is transparent and stretched to its own box, so a selection highlights the words themselves
 * and copies what they say, while the picture underneath is what is actually seen. A word that turned
 * out to be part of a link or a number is underlined, the way iOS marks what it has recognised.
 */
.mx_TgLiveText {
    position: absolute;
    inset: 0;
    /* Only the words take the pointer: the picture keeps its own click, which opens the viewer. */
    pointer-events: none;

    .mx_TgLiveText_word {
        position: absolute;
        display: block;
        margin: 0;
        padding: 0;
        color: transparent;
        /* The box is the word's own; the glyphs inside it are never shown, only selected. */
        font-size: 1px;
        line-height: 1;
        white-space: pre;
        user-select: text;
        cursor: text;
        pointer-events: auto;

        &::selection {
            /* A selection has to be visible over any picture, so it is the accent rather than a tint. */
            background-color: color-mix(in srgb, var(--cpd-color-bg-accent-rest) 45%, transparent);
        }
    }

    .mx_TgLiveText_word--link,
    .mx_TgLiveText_word--marked {
        border-bottom: 2px solid color-mix(in srgb, var(--cpd-color-text-action-accent) 70%, transparent);
        border-radius: 1px;
    }

    .mx_TgLiveText_word--link {
        cursor: pointer;
    }

    /*
     * A code in the picture, marked the way iOS marks one: the code itself keeps its own outline, and
     * what it says sits under it as something to press.
     */
    .mx_TgLiveText_code {
        position: absolute;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        border: 2px solid var(--cpd-color-bg-accent-rest);
        border-radius: 8px;
        background: transparent;
        cursor: pointer;
        pointer-events: auto;

        .mx_TgLiveText_code_label {
            max-width: 100%;
            margin-block-end: -12px;
            padding: 2px 8px;
            overflow: hidden;
            border-radius: 99px;
            background: var(--cpd-color-bg-accent-rest);
            color: var(--cpd-color-text-on-solid-primary);
            font: var(--cpd-font-body-xs-medium);
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    }
}
