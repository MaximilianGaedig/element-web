/*
 * The text a picture was read to hold (TgLiveText.tsx), laid over the picture where it was read from.
 *
 * Each word is transparent and stretched to its own box, so a selection highlights the words themselves
 * and copies what they say, while the picture underneath is what is actually seen. A word that turned
 * out to be part of a link or a number is underlined, the way iOS marks what it has recognised.
 */
.mx_TgLiveText {
    position: absolute;
    inset: 0;
    /* Only the words take the pointer: the picture keeps its own click, which opens the viewer. */
    pointer-events: none;

    /*
     * The glyph that says this picture was read, in its corner the way iOS marks one. Pressing it shows
     * the words it found; pressing again puts them back out of the way. Without it nothing on screen
     * says there is anything to select, which is the difference between a feature and a rumour.
     */
    .mx_TgLiveText_reveal {
        position: absolute;
        inset-block-end: var(--cpd-space-2x);
        inset-inline-end: var(--cpd-space-2x);
        display: flex;
        align-items: center;
        justify-content: center;
        width: 28px;
        height: 28px;
        padding: 0;
        border: none;
        border-radius: 8px;
        background: color-mix(in srgb, var(--cpd-color-bg-canvas-default) 70%, transparent);
        backdrop-filter: blur(12px);
        color: var(--cpd-color-icon-primary);
        cursor: pointer;
        pointer-events: auto;

        svg {
            width: 18px;
            height: 18px;
        }

        &[aria-pressed="true"] {
            background: var(--cpd-color-bg-accent-rest);
            color: var(--cpd-color-text-on-solid-primary);
        }
    }

    /* Asked for: every word it read, tinted where it sits, so the reading can be seen and not guessed. */
    &[data-revealed] .mx_TgLiveText_word {
        border-radius: 3px;
        background: color-mix(in srgb, var(--cpd-color-bg-accent-rest) 22%, transparent);
        box-shadow: 0 0 0 1px color-mix(in srgb, var(--cpd-color-bg-accent-rest) 35%, transparent);
    }

    .mx_TgLiveText_word {
        position: absolute;
        display: block;
        margin: 0;
        padding: 0;
        color: transparent;
        /* The box is the word's own; the glyphs inside it are never shown, only selected. */
        font-size: 1px;
        line-height: 1;
        white-space: pre;
        user-select: text;
        cursor: text;
        pointer-events: auto;

        &::selection {
            /* A selection has to be visible over any picture, so it is the accent rather than a tint. */
            background-color: color-mix(in srgb, var(--cpd-color-bg-accent-rest) 45%, transparent);
        }
    }

    .mx_TgLiveText_word--link,
    .mx_TgLiveText_word--marked {
        border-bottom: 2px solid color-mix(in srgb, var(--cpd-color-text-action-accent) 70%, transparent);
        border-radius: 1px;
    }

    .mx_TgLiveText_word--link {
        cursor: pointer;
    }

    /*
     * A code in the picture, marked the way iOS marks one: the code itself keeps its own outline, and
     * what it says sits under it as something to press.
     */
    .mx_TgLiveText_code {
        position: absolute;
        display: flex;
        align-items: flex-end;
        justify-content: center;
        box-sizing: border-box;
        margin: 0;
        padding: 0;
        border: 2px solid var(--cpd-color-bg-accent-rest);
        border-radius: 8px;
        background: transparent;
        cursor: pointer;
        pointer-events: auto;

        .mx_TgLiveText_code_label {
            max-width: 100%;
            margin-block-end: -12px;
            padding: 2px 8px;
            overflow: hidden;
            border-radius: 99px;
            background: var(--cpd-color-bg-accent-rest);
            color: var(--cpd-color-text-on-solid-primary);
            font: var(--cpd-font-body-xs-medium);
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    }
}

/*
 * In the viewer the reading covers the picture itself, inside the mover that carries it - so it moves,
 * zooms and pans with the picture rather than floating over the screen.
 */
.mx_TgMediaViewer_mover {
    .mx_TgLiveText {
        z-index: 2;
    }

    .mx_TgLiveText_word {
        /* Big enough to put a finger on, which a thumbnail's words never were. */
        font-size: 2px;
    }
}
