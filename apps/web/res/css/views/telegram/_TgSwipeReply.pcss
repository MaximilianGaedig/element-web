/*
 * Swipe a message to the left to reply to it (see swipeReply.ts): the message follows the finger and a
 * round reply glyph grows out of the edge behind it.
 *
 * The message's own movement is an inline transform written by the gesture, not a class here, because
 * React rewrites the tile's class list whenever it re-renders. Nothing here sets `touch-action` either:
 * the gesture cancels the browser's scrolling itself once it has turned horizontal, so a wide code block
 * or table inside a message keeps its sideways drag, and pinching the timeline still zooms.
 */

.mx_TgSwipeReply {
    --tg-swipe-progress: 0;

    position: absolute;
    top: 50%;
    inset-inline-start: calc(100% + 0.25rem);
    display: grid;
    place-items: center;
    width: 1.875rem;
    height: 1.875rem;
    margin-top: -0.9375rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--cpd-color-bg-canvas-default) 55%, rgb(127 127 127 / 60%));
    color: var(--cpd-color-icon-primary);
    opacity: var(--tg-swipe-progress);
    transform: scale(calc(0.4 + 0.6 * var(--tg-swipe-progress)));
    pointer-events: none;

    svg {
        width: 1.125rem;
        height: 1.125rem;
        fill: currentcolor;
    }
}
