/*
 * Telegram-style layout (setting "telegramStyleLayout", on by default). Dimensions follow Telegram
 * Web K (GPL-3.0): chat content at most 696px wide and centred (helpers/updateColumnWidths.ts
 * CHAT_WIDTH_MAX), compact message padding, bubble radius 15px and bubble max width 85%
 * (scss/partials/_chatVariables.scss, _chatBubble.scss). Media sizes live in ImageSize.ts.
 * The IRC layout is left alone.
 */
/*
 * How wide the chat gets and where it sits belongs to the columns, not to the bubbles: someone who
 * turns the bubbles off still wants the readable column, and someone who turns the columns off wants
 * the messages to fill the window whatever shape they are drawn in.
 */
html[data-chat-columns] .mx_RoomView_body:not([data-layout="irc"]) {
    --TelegramLayout-chat-width: 696px;

    /* Let the scroll panel span the room (scrollbar at the edge) and centre its content instead. */
    .mx_RoomView_timeline {
        max-width: none;
    }

    /*
     * Both lists: the labs "improved timeline" replaces TimelinePanel with its own component, whose list
     * is .mx_TimelineView_list. Without it that timeline keeps neither the chat's width nor the room the
     * floating header and composer need, and the composer sits on the last message.
     */
    :is(.mx_RoomView_MessageList, .mx_TimelineView_list) {
        width: 100%;
        max-width: calc(var(--TelegramLayout-chat-width) + 2 * var(--RoomView_MessageList-padding));
        margin-inline: auto;
    }

    .mx_RoomView_statusArea,
    .mx_MessageComposer {
        width: 100%;
        max-width: calc(var(--TelegramLayout-chat-width) + 2 * var(--RoomView_MessageList-padding));
        margin-inline: auto;
    }
}

/*
 * Event tiles are the shared-components EventTileView (a CSS module), which declares its geometry
 * as custom properties on the tile root; the tile root carries data-testid="event-tile".
 * The gutter drives the bubble padding (gutter - 1px, plus 1px around the content), so 5px gives
 * Telegram's ~5px text inset and a 2.5px gap between bubbles.
 */
.mx_RoomView_body[data-bubble-timeline="true"] [data-testid="event-tile"] {
    --event-tile-bubble-corner-radius: 15px;
    --event-tile-bubble-line-max-width: 85%;
    --event-tile-bubble-gutter: 5px;
}

/* Native iOS ChatMessageItemCommon.compact.text.bubbleInsets: 6±UIScreenPixel vertically, 11px
   horizontally. Subtract the text body's existing 1px anti-zalgo padding. These insets do not change
   grouping gaps or media padding. Web K uses _chatVariables.scss's 4px / 8px / 5px message margins. */
html[data-tg-screen="mobile"] .mx_RoomView_body[data-bubble-timeline="true"] [data-testid="event-tile"] {
    --tg-message-pixel: 1px;
    --event-tile-bubble-padding-block-start: calc(5px + var(--tg-message-pixel));
    --event-tile-bubble-padding-block-end: calc(5px - var(--tg-message-pixel));
    --event-tile-bubble-padding-inline: 10px;
}

@media (min-resolution: 2dppx) {
    html[data-tg-screen="mobile"] .mx_RoomView_body[data-bubble-timeline="true"] [data-testid="event-tile"] {
        --tg-message-pixel: 0.5px;
    }
}

@media (min-resolution: 3dppx) {
    html[data-tg-screen="mobile"] .mx_RoomView_body[data-bubble-timeline="true"] [data-testid="event-tile"] {
        --tg-message-pixel: calc(1px / 3);
    }
}

html[data-tg-screen="mobile"][data-tg-message-padding="telegram-web"]
    .mx_RoomView_body[data-bubble-timeline="true"]
    [data-testid="event-tile"] {
    --event-tile-bubble-padding-block-start: 3px;
    --event-tile-bubble-padding-block-end: 4px;
    --event-tile-bubble-padding-inline: 7px;
}

html[data-tg-screen="mobile"][data-tg-message-padding="element"]
    .mx_RoomView_body[data-bubble-timeline="true"]
    [data-testid="event-tile"] {
    /* Element's default 11px gutter, minus the same 1px body padding. */
    --event-tile-bubble-padding-block-start: 10px;
    --event-tile-bubble-padding-block-end: 10px;
    --event-tile-bubble-padding-inline: 10px;
}

/* One-to-one chats: no avatars (and no names), so the bubbles start at the edge like Telegram. */
.mx_RoomView_body[data-bubble-timeline="true"]
    .mx_MessagePanel_noAvatars
    :is(.mx_RoomView_MessageList, .mx_TimelineView_list)
    [data-testid="event-tile"] {
    --event-tile-bubble-margin-inline-start: 8px;
}

.mx_RoomView_body[data-bubble-timeline="true"] .mx_GenericEventListSummary[data-layout="bubble"] {
    --maxWidth: 85%;
}

/*
 * tweb `.bubble-content { box-shadow: 0 1px 2px 0 rgba(16, 35, 47, .15) }` (_chatBubble.scss): every
 * bubble, media included, carries a faint edge, so a photo never blends into the chat background.
 * `.bubble.just-media` (stickers) drops both the background and the shadow. Element's media roots clip
 * their overflow, so the edge is drawn inside the media box as an overlay.
 */
.mx_RoomView_body[data-bubble-timeline="true"] {
    --TelegramLayout-media-edge: rgb(16 35 47 / 15%);

    :is(
        .mx_ImageBody_container,
        .mx_MVideoBody_container,
        .mx_MAlbumBody_grid,
        .mx_AnimatedVideo:not(.mx_AnimatedVideo_sticker)
    ) {
        position: relative;

        &::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 1;
            border-radius: inherit;
            box-shadow:
                inset 0 0 0 1px var(--TelegramLayout-media-edge),
                inset 0 -1px 2px 0 var(--TelegramLayout-media-edge);
            pointer-events: none;
        }
    }

    /* Stickers: no background, no edge. */
    :is(.mx_MStickerBody_wrapper, .mx_AnimatedVideo_sticker) {
        &,
        .mx_MImageBody_thumbnail_container,
        video {
            background: none;
            box-shadow: none;
        }
    }
}

.cpd-theme-dark .mx_RoomView_body[data-bubble-timeline="true"] {
    --TelegramLayout-media-edge: rgb(255 255 255 / 10%);
}

/*
 * The chat's header and composer float over the timeline, which scrolls behind them (tweb's .bubbles
 * spans the whole chat, padded by --chat-padding-top/-bottom). Towards both edges the messages fade
 * out into the chat background (see .mx_TgFadeEdge below).
 * TgChatChrome keeps --tg-header-block / --tg-composer-block (the space the floating parts take).
 */
html[data-floating-bars] .mx_RoomView_body {
    position: relative;

    > .mx_RoomHeader {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 3;
    }

    /* The pinned plate floats under the header (TgChatChrome keeps --tg-header-bottom) and is glass too. */
    > .mx_TgPinned {
        position: absolute;
        top: calc(var(--tg-header-bottom, 64px) + var(--tg-plates-gap));
        left: 0;
        right: 0;
        z-index: 3;
        margin: 0 auto;
        background-color: var(--tg-glass-background);
        backdrop-filter: var(--tg-glass-backdrop);
    }

    > .mx_MessageComposer {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 3;
    }

    /*
     * What floats directly above the composer, on the composer's own layer and resting on its top edge.
     * In flow it fell behind the composer - which floats absolutely - and the messages ran underneath it,
     * because the space reserved for the bottom of the chat was measured from the composer alone.
     */
    > .mx_TgComposerAbove {
        position: absolute;
        left: 0;
        right: 0;
        bottom: var(--tg-composer-height, 0px);
        z-index: 3;
        display: flex;
        flex-direction: column;
        gap: var(--cpd-space-1x);
        /*
         * A gap above the composer. Without it the lowest of these sits with its bottom edge exactly on
         * the composer's top edge - measured at zero - and a rounded pill flush against a rounded pill
         * reads as one object, so the suggestions looked like part of the box you type in.
         */
        padding-block-end: var(--cpd-space-2x);
        pointer-events: none;

        > * {
            pointer-events: auto;
        }
    }

    > .mx_RoomView_statusArea {
        position: absolute;
        left: 0;
        right: 0;
        bottom: var(--tg-composer-block, 0px);
        z-index: 3;
    }

    > .mx_RoomView_timeline {
        flex: 1 1 auto;
        min-height: 0;
    }

    /*
     * The floating date hangs below everything that floats over the top of the timeline - the bar
     * and the pinned and import plates under it - as tweb pins it (.is-date top:
     * --chat-padding-top, which counts the pinned plate, + $bubble-overflow-big). Under the bar
     * alone it sat on top of the pinned message.
     */
    --mx-timeline-top-inset: calc(var(--tg-header-block, 0px) + 3px);

    /*
     * Only the timeline is meant to run under the floating header - that is the whole point of the
     * glass. Everything else in the room (widgets, the call view, the aux panel) is ordinary content
     * and has to start below it, or the header sits on top of it.
     */
    > :is(.mx_AuxPanel, .mx_AppsDrawer, .mx_CallView) {
        margin-block-start: var(--tg-header-block, 0px);
    }

    /* A widget or call filling the room: the whole body starts clear of the header. */
    &:is(.mx_MainSplit_maximisedWidget, .mx_MainSplit_call) {
        padding-block-start: var(--tg-header-block, 0px);
    }

    /*
     * The old timeline is padded clear of the floating chrome here. The virtualised one is not:
     * padding on its list is space its own measurements know nothing about, so it would stop
     * scrolling that far short of the bottom and strand the last message above the composer.
     * NewTimelinePanel hands it the same numbers as paddingStart/paddingEnd instead.
     */
    .mx_RoomView_MessageList {
        padding-top: calc(var(--tg-header-block, 0px) + 8px);
        padding-bottom: calc(var(--tg-composer-block, 0px) + 8px);
    }

    .mx_JumpToBottomButton {
        bottom: calc(var(--tg-composer-block, 0px) + 0.5rem);
    }

    /* The jump-up button sits under the floating header (and the pinned plate), not behind it. */
    .mx_TopUnreadMessagesBar {
        top: calc(var(--tg-header-block, 0px) + 0.5rem);
    }

    /*
     * Towards both edges the messages fade out into the chat background instead of being blurred: one
     * gradient of the background colour per edge, transparent where the messages are fully visible and
     * opaque where the floating bar starts. A gradient composites on the GPU like any other paint, while a
     * backdrop filter re-reads and re-blurs everything behind it on every scrolled frame.
     */
    .mx_TgFadeEdge {
        position: absolute;
        left: 0;
        right: 0;
        z-index: 2;
        pointer-events: none;
        background-image: linear-gradient(
            to var(--tg-fade-to),
            var(--tg-surface-color) 45%,
            color-mix(in srgb, var(--tg-surface-color) 55%, transparent) 70%,
            transparent 100%
        );
    }

    .mx_TgFadeEdge_top {
        /* Opaque at the header, transparent where messages begin. */
        --tg-fade-to: bottom;

        top: 0;
        height: var(--tg-header-block, 0px);
    }

    .mx_TgFadeEdge_bottom {
        /* Transparent above the composer, opaque at its bottom edge. */
        --tg-fade-to: top;

        bottom: 0;
        height: var(--tg-composer-block, 0px);
    }
}
