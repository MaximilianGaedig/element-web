/*
 * Shared media, ported from Telegram Web K (GPL-3.0): tabs from scss/partials/_slider.scss
 * (.menu-horizontal-scrollable / -div, $menu-height 3rem, --tabs-transition .2s ease-in-out),
 * content from scss/partials/_searchSuper.scss (3-column grid with 1px gaps and $border-radius-big
 * corners, .video-time badge, links rows with a 3rem letter tile).
 */
.mx_SharedMedia {
    --SharedMedia-radius-big: 24px;
    --SharedMedia-tabs-transition: 0.2s ease-in-out;

    /* The strip keeps this height wherever it is: it is a row of labels, not a banner. */
    --SharedMedia-tabs-height: 2.5rem;
    --SharedMedia-tabs-inset: var(--cpd-space-2x);

    /* Marks where the strip starts, so the strip can tell when it has been scrolled against the top. */
    .mx_SharedMedia_tabsSentinel {
        height: 0;
    }

    /* The strip and the media filter button stay on top while the content scrolls. */
    .mx_SharedMedia_tabsRow {
        position: sticky;
        /* Held a little below the top, so the strip reads as floating over the list rather than
           welded to its edge. */
        inset-block-start: var(--SharedMedia-tabs-inset);
        z-index: 3;
        display: flex;
        align-items: center;
        gap: var(--cpd-space-1x);
        margin-block-end: var(--cpd-space-2x);
    }

    /*
     * Holding the top: the media scrolling underneath is blurred behind the strip instead of being
     * covered by a solid bar, so the list stays visibly continuous. The strip's size does not change
     * with it - a row that grows and shrinks as you scroll is a distraction, and on a narrow panel
     * the tabs already scroll sideways within it (overflow-x below), which a height change would
     * interrupt.
     */
    .mx_SharedMedia_tabsRow_stuck .mx_SharedMedia_tabs {
        background-color: color-mix(in srgb, var(--cpd-color-bg-canvas-default) 72%, transparent);
        backdrop-filter: blur(16px) saturate(180%);
        box-shadow: 0 2px 10px 0 rgb(0 0 0 / 12%);
    }

    /* tweb .menu-horizontal-scrollable: tabs keep their width and the strip scrolls sideways. */
    .mx_SharedMedia_tabs {
        position: relative;
        display: flex;
        flex: 1 1 auto;
        min-width: 0;
        height: var(--SharedMedia-tabs-height);
        padding: 0.125rem 0;
        transition: background-color var(--SharedMedia-tabs-transition);
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scrollbar-width: none;
        border-radius: var(--SharedMedia-radius-big);
        background-color: var(--cpd-color-bg-canvas-default);
        box-shadow: 0 1px 4px 0 rgb(0 0 0 / 5%);
    }

    .mx_SharedMedia_tabBackground {
        position: absolute;
        inset-block: 0.25rem;
        inset-inline-start: 0;
        border-radius: 1.25rem;
        background-color: var(--cpd-color-bg-accent-subtle, var(--cpd-color-bg-subtle-secondary));
        transition:
            transform var(--SharedMedia-tabs-transition),
            width var(--SharedMedia-tabs-transition);
        pointer-events: none;
    }

    .mx_SharedMedia_tab {
        position: relative;
        z-index: 1;
        flex: 1 0 auto;
        margin: 0 0.25rem;
        padding: 0 0.75rem;
        border: 0;
        border-radius: 1.25rem;
        background: none;
        font: var(--cpd-font-body-md-semibold);
        white-space: nowrap;
        color: var(--cpd-color-text-secondary);
        cursor: pointer;
        transition: color var(--SharedMedia-tabs-transition);

        &:hover:not(.mx_SharedMedia_tab_active) {
            background-color: var(--cpd-color-bg-subtle-secondary);
        }
    }

    .mx_SharedMedia_filterButton {
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        color: var(--cpd-color-icon-secondary);

        svg {
            width: 24px;
            height: 24px;
        }

        &:hover {
            background-color: var(--cpd-color-bg-subtle-secondary);
        }
    }

    /* In the Telegram profile: the count and the photo/video filter above the grid. */
    .mx_SharedMedia_paneHeader {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 2.5rem;

        .mx_SharedMedia_subtitle {
            margin: 0;
        }
    }

    .mx_SharedMedia_subtitle {
        margin: calc(-1 * var(--cpd-space-1x)) 0 var(--cpd-space-2x);
        padding-inline: var(--cpd-space-3x);
        font: var(--cpd-font-body-sm-regular);
        color: var(--cpd-color-text-secondary);
    }

    .mx_SharedMedia_tab_active {
        color: var(--cpd-color-text-action-accent);
    }

    .mx_SharedMedia_content {
        display: flex;
        flex-direction: column;
        gap: var(--cpd-space-2x);
        animation: mx_SharedMedia_in var(--SharedMedia-tabs-transition) both;
    }

    /*
     * A list tab's rows, placed rather than stacked: only the rows on screen exist, so each is put
     * at the offset the layout measured for it (utils/listWindow.ts).
     */
    .mx_SharedMedia_rows {
        position: relative;
    }

    .mx_SharedMedia_row_placed {
        position: absolute;
        inset-inline: 0;
        /* The rows used to be spaced by the content column's gap, which a placed row is no longer
           subject to. Carried as padding so the space is part of what each row measures. */
        padding-block-end: var(--cpd-space-2x);
    }

    /* Holds the column and the handle beside it. */
    .mx_SharedMedia_column {
        position: relative;
    }

    /*
     * The column is positioned, not laid out: every row is placed at the offset the layout worked
     * out for it (sharedMediaLayout.ts), and only the rows on screen exist. The three columns and
     * the hairline between them live on the row, so a cell is styled exactly as it was.
     */
    .mx_SharedMedia_grid {
        position: relative;
        width: 100%;
        border-radius: var(--SharedMedia-radius-big);
        overflow: hidden;
    }

    .mx_SharedMedia_gridRow {
        position: absolute;
        inset-inline: 0;
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1px;
    }

    /* The month a run of pictures belongs to, as Telegram cuts shared media. */
    .mx_SharedMedia_month {
        position: absolute;
        inset-inline: 0;
        display: flex;
        align-items: center;
        margin: 0;
        padding-inline: var(--cpd-space-1x);
        font: var(--cpd-font-body-sm-semibold);
        color: var(--cpd-color-text-secondary);
    }

    /*
     * Telegram iOS's scrubber, in its numbers (SparseItemGridScrollingArea.swift): a bar 3pt wide and
     * 44pt tall, 3pt in from the edge, 6pt wide while dragged; and the month in a 32pt pill, 12pt in,
     * 13pt medium with even-width digits. Both appear while the grid moves and fade 0.3s two seconds
     * after it stops. Only the bar and the pill take the pointer: the rest of the strip is the grid's.
     */
    /* Takes no room in the column: see SharedMediaPanel's comment on it. */
    .mx_SharedMedia_scrubberDock {
        position: sticky;
        inset-block-start: 0;
        z-index: 4;
        height: 0;
    }

    .mx_SharedMedia_scrubber {
        position: absolute;
        inset-block-start: 0;
        inset-inline: 0;
        pointer-events: none;
        opacity: 0;
        transition: opacity 0.3s ease-in-out;

        /* The states are written from here down: a nested ".state &" would put the column's own
           scope in front of the scrubber's and match nothing. */
        &[data-active] {
            opacity: 1;

            .mx_SharedMedia_scrubberLine,
            .mx_SharedMedia_scrubberDate {
                pointer-events: auto;
            }
        }

        &[data-dragging] .mx_SharedMedia_scrubberLine {
            width: 6px;
            border-radius: 3px;
            cursor: grabbing;
        }

        /* Held under a finger: out from under it, in 0.1s as Telegram does - but 48px rather than
           Telegram's 80pt, which in a panel this narrow sent the pill most of the way across. */
        &[data-grabbed] .mx_SharedMedia_scrubberDate {
            transform: translateX(-48px);
            transition-duration: 0.1s;
        }
    }

    .mx_SharedMedia_scrubberLine {
        position: absolute;
        inset-inline-end: 3px;
        width: 3px;
        height: 44px;
        border-radius: 1.5px;
        background-color: var(--cpd-color-icon-tertiary);
        touch-action: none;
        cursor: grab;
        transition: width 0.2s ease-in-out;

        /* Easier to grab than it is to see: Telegram's hit area is the bar grown by 4pt and 2pt - except
           past the edge, where it would make the panel scroll sideways by a pixel. */
        &::before {
            content: "";
            position: absolute;
            inset: -2px 0 -2px -4px;
        }
    }

    .mx_SharedMedia_scrubberDate {
        position: absolute;
        inset-inline-end: 12px;
        box-sizing: border-box;
        height: 32px;
        padding-inline: 13px;
        display: flex;
        align-items: center;
        border-radius: 16px;
        background-color: color-mix(in srgb, var(--cpd-color-bg-canvas-default) 72%, transparent);
        backdrop-filter: blur(16px);
        box-shadow: 0 1px 4px rgb(0 0 0 / 20%);
        font: var(--cpd-font-body-sm-medium);
        font-size: 13px;
        font-variant-numeric: tabular-nums;
        color: var(--cpd-color-text-primary);
        white-space: nowrap;
        touch-action: none;
        cursor: grab;
        transition: transform 0.2s ease-in-out;
    }

    /* One month label at a time: the scrubber's, while it is showing. */
    .mx_SharedMedia_column:has(.mx_SharedMedia_scrubber[data-active]) .mx_SharedMedia_monthPill {
        opacity: 0;
    }

    /* The same month, kept legible while its heading scrolls away above the column. */
    .mx_SharedMedia_monthPill {
        position: sticky;
        inset-block-start: var(--cpd-space-1x);
        z-index: 2;
        float: inline-end;
        margin-inline-end: var(--cpd-space-2x);
        padding: 0.125rem 0.625rem;
        border-radius: 1rem;
        background-color: color-mix(in srgb, var(--cpd-color-bg-canvas-default) 72%, transparent);
        backdrop-filter: blur(16px);
        font: var(--cpd-font-body-sm-semibold);
        color: var(--cpd-color-text-secondary);
        pointer-events: none;
    }

    .mx_SharedMedia_gridItem {
        position: relative;
        aspect-ratio: 1;
        padding: 0;
        border: 0;
        overflow: hidden;
        background-color: var(--cpd-color-bg-subtle-secondary);
        cursor: pointer;

        img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    }

    /*
     * A cell that has not been fetched yet. The column already knows how many there are, so the
     * space is held and drawn rather than left blank - blank space at the bottom of a list reads as
     * the end of it.
     */
    .mx_SharedMedia_pending {
        display: block;
        /* The row sets the height; this only has to fill the cell it is given. */
        width: 100%;
        height: 100%;
        background-color: var(--cpd-color-bg-subtle-secondary);
        animation: mx_SharedMedia_pendingPulse 1.4s ease-in-out infinite;
    }

    @media (prefers-reduced-motion: reduce) {
        .mx_SharedMedia_pending {
            animation: none;
        }
    }

    /* tweb .video-time */
    .mx_SharedMedia_videoTime {
        position: absolute;
        inset-block-start: 4px;
        inset-inline-start: 5px;
        z-index: 2;
        height: 18px;
        padding: 0 6px 0 5px;
        border-radius: 4px;
        font-size: 12px;
        line-height: 18px;
        color: #fff;
        background-color: rgb(0 0 0 / 35%);
    }

    /* The message itself, with its URL preview card, as the timeline renders it. */
    .mx_SharedMedia_link {
        display: flex;
        flex-direction: column;
        gap: var(--cpd-space-1x);
        padding-inline: var(--cpd-space-2x);

        /* The same card as the timeline, so it takes the width of the row here too. */
        .mx_MediaPreviewGroup {
            --MediaPreview-width: 100%;
        }

        .mx_MediaPreviewTile {
            /* It holds an image that would otherwise square off its corners. */
            overflow: clip;
            border-radius: var(--SharedMedia-radius-big);
        }
    }

    .mx_SharedMedia_linkText {
        min-width: 0;
        font: var(--cpd-font-body-sm-regular);
        word-break: break-word;
    }

    .mx_SharedMedia_sentTime {
        flex: 0 0 auto;
        margin-inline-start: 8px;
        font-size: 12px;
        color: var(--cpd-color-text-secondary);
    }

    .mx_SharedMedia_rowMeta {
        display: flex;
        justify-content: space-between;
        align-self: flex-start;
        width: 100%;
        padding: 0;
        border: 0;
        background: none;
        font: var(--cpd-font-body-xs-regular);
        color: var(--cpd-color-text-secondary);
        cursor: pointer;
    }

    .mx_SharedMedia_row {
        display: flex;
        flex-direction: column;
        gap: var(--cpd-space-1x);
    }

    /* Music and voice: the row before it is played (building a player downloads the whole file). */
    .mx_SharedMedia_audio {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-3x);
        width: 100%;
        padding: var(--cpd-space-1x) var(--cpd-space-2x);
        border: 0;
        border-radius: var(--cpd-space-2x);
        background: none;
        color: inherit;
        font: inherit;
        text-align: start;
        cursor: pointer;

        &:hover {
            background-color: var(--cpd-color-bg-subtle-secondary);
        }
    }

    .mx_SharedMedia_audioPlay {
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        color: var(--cpd-color-icon-on-solid-primary);
        background-color: var(--cpd-color-bg-accent-rest);

        svg {
            width: 20px;
            height: 20px;
        }
    }

    .mx_SharedMedia_audioText {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .mx_SharedMedia_audioTitle {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font: var(--cpd-font-body-md-medium);
    }

    .mx_SharedMedia_audioDuration {
        font: var(--cpd-font-body-sm-regular);
        color: var(--cpd-color-text-secondary);
        font-variant-numeric: tabular-nums;
    }

    /* Selecting, as Telegram does it: a tick on each item and a bar of actions for what is ticked. */
    .mx_SharedMedia_selectionBar {
        position: sticky;
        inset-block-start: 0;
        z-index: 4;
        display: flex;
        align-items: center;
        gap: var(--cpd-space-1x);
        min-height: 2.5rem;
        margin-block-end: var(--cpd-space-2x);
        padding-inline: var(--cpd-space-1x);
        border-radius: var(--cpd-space-2x);
        background-color: var(--cpd-color-bg-subtle-secondary);
    }

    .mx_SharedMedia_selectionCount {
        flex: 1 1 auto;
        font: var(--cpd-font-body-md-semibold);
    }

    .mx_SharedMedia_selectionAction {
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        width: 2rem;
        height: 2rem;
        border-radius: 50%;
        color: var(--cpd-color-icon-secondary);

        svg {
            width: 20px;
            height: 20px;
        }

        &:hover {
            background-color: var(--cpd-color-bg-action-secondary-hovered);
        }
    }

    .mx_SharedMedia_selectionAction_danger {
        color: var(--cpd-color-icon-critical-primary);
    }

    .mx_SharedMedia_tick {
        position: absolute;
        inset-block-start: 4px;
        inset-inline-end: 4px;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        border: 2px solid var(--cpd-color-bg-canvas-default);
        border-radius: 50%;
        background-color: rgb(0 0 0 / 25%);

        svg {
            width: 14px;
            height: 14px;
            color: var(--cpd-color-icon-on-solid-primary);
        }
    }

    .mx_SharedMedia_tick_on {
        background-color: var(--cpd-color-bg-accent-rest);
    }

    .mx_SharedMedia_item_selected {
        img {
            opacity: 0.6;
        }
    }

    .mx_SharedMedia_selectableRow {
        position: relative;
        display: flex;
        align-items: flex-start;
        gap: var(--cpd-space-2x);
        padding-inline-start: 2rem;
        border-radius: var(--cpd-space-2x);

        &.mx_SharedMedia_item_selected {
            background-color: var(--cpd-color-bg-subtle-secondary);
        }

        .mx_SharedMedia_tick {
            inset-block-start: 50%;
            inset-inline: 4px auto;
            transform: translateY(-50%);
        }
    }

    .mx_SharedMedia_selectableRow_body {
        flex: 1 1 auto;
        min-width: 0;
    }

    /* Covers the row so its own buttons don't take the click while the list is in selection mode. */
    .mx_SharedMedia_rowOverlay {
        position: absolute;
        inset: 0;
        z-index: 3;
        border: 0;
        background: none;
        cursor: pointer;
    }

    .mx_SharedMedia_empty {
        padding: var(--cpd-space-8x) var(--cpd-space-4x);
        text-align: center;
        color: var(--cpd-color-text-secondary);
    }

    .mx_SharedMedia_more {
        display: flex;
        justify-content: center;
        min-height: 40px;
    }
}

@keyframes mx_SharedMedia_in {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}

/* Where a date scrubber is doing the job, the scrollbar is a second handle on the same edge. */
[data-mx-scrubbed] {
    scrollbar-width: none;

    &::-webkit-scrollbar {
        display: none;
    }
}

/* The breath of a placeholder waiting for its picture. */
@keyframes mx_SharedMedia_pendingPulse {
    0%,
    100% {
        opacity: 1;
    }

    50% {
        opacity: 0.45;
    }
}
