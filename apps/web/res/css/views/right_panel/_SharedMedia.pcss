/*
 * Shared media, ported from Telegram Web K (GPL-3.0): tabs from scss/partials/_slider.scss
 * (.menu-horizontal-scrollable / -div, $menu-height 3rem, --tabs-transition .2s ease-in-out),
 * content from scss/partials/_searchSuper.scss (3-column grid with 1px gaps and $border-radius-big
 * corners, .video-time badge, links rows with a 3rem letter tile).
 */
.mx_SharedMedia {
    --SharedMedia-radius-big: 24px;
    --SharedMedia-tabs-transition: 0.2s ease-in-out;

    /* The strip and the media filter button stay on top while the content scrolls. */
    .mx_SharedMedia_tabsRow {
        position: sticky;
        inset-block-start: 0;
        z-index: 3;
        display: flex;
        align-items: center;
        gap: var(--cpd-space-1x);
        margin-block-end: var(--cpd-space-2x);
    }

    /* tweb .menu-horizontal-scrollable: tabs keep their width and the strip scrolls sideways. */
    .mx_SharedMedia_tabs {
        position: relative;
        display: flex;
        flex: 1 1 auto;
        min-width: 0;
        height: 3rem;
        padding: 0.25rem 0;
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scrollbar-width: none;
        border-radius: var(--SharedMedia-radius-big);
        background-color: var(--cpd-color-bg-canvas-default);
        box-shadow: 0 1px 4px 0 rgb(0 0 0 / 5%);
    }

    .mx_SharedMedia_tabBackground {
        position: absolute;
        inset-block: 0.25rem;
        inset-inline-start: 0;
        border-radius: 1.25rem;
        background-color: var(--cpd-color-bg-accent-subtle, var(--cpd-color-bg-subtle-secondary));
        transition:
            transform var(--SharedMedia-tabs-transition),
            width var(--SharedMedia-tabs-transition);
        pointer-events: none;
    }

    .mx_SharedMedia_tab {
        position: relative;
        z-index: 1;
        flex: 1 0 auto;
        margin: 0 0.25rem;
        padding: 0 0.75rem;
        border: 0;
        border-radius: 1.25rem;
        background: none;
        font: var(--cpd-font-body-md-semibold);
        white-space: nowrap;
        color: var(--cpd-color-text-secondary);
        cursor: pointer;
        transition: color var(--SharedMedia-tabs-transition);

        &:hover:not(.mx_SharedMedia_tab_active) {
            background-color: var(--cpd-color-bg-subtle-secondary);
        }
    }

    .mx_SharedMedia_filterButton {
        display: flex;
        flex: 0 0 auto;
        align-items: center;
        justify-content: center;
        width: 2.5rem;
        height: 2.5rem;
        border-radius: 50%;
        color: var(--cpd-color-icon-secondary);

        svg {
            width: 24px;
            height: 24px;
        }

        &:hover {
            background-color: var(--cpd-color-bg-subtle-secondary);
        }
    }

    /* In the Telegram profile: the count and the photo/video filter above the grid. */
    .mx_SharedMedia_paneHeader {
        display: flex;
        align-items: center;
        justify-content: space-between;
        min-height: 2.5rem;

        .mx_SharedMedia_subtitle {
            margin: 0;
        }
    }

    .mx_SharedMedia_subtitle {
        margin: calc(-1 * var(--cpd-space-1x)) 0 var(--cpd-space-2x);
        padding-inline: var(--cpd-space-3x);
        font: var(--cpd-font-body-sm-regular);
        color: var(--cpd-color-text-secondary);
    }

    .mx_SharedMedia_tab_active {
        color: var(--cpd-color-text-action-accent);
    }

    .mx_SharedMedia_content {
        display: flex;
        flex-direction: column;
        gap: var(--cpd-space-2x);
        animation: mx_SharedMedia_in var(--SharedMedia-tabs-transition) both;
    }

    .mx_SharedMedia_grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        grid-auto-rows: 1fr;
        gap: 1px;
        width: 100%;
        border-radius: var(--SharedMedia-radius-big);
        overflow: hidden;
    }

    .mx_SharedMedia_gridItem {
        position: relative;
        aspect-ratio: 1;
        padding: 0;
        border: 0;
        overflow: hidden;
        background-color: var(--cpd-color-bg-subtle-secondary);
        cursor: pointer;

        img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
    }

    /* tweb .video-time */
    .mx_SharedMedia_videoTime {
        position: absolute;
        inset-block-start: 4px;
        inset-inline-start: 5px;
        z-index: 2;
        height: 18px;
        padding: 0 6px 0 5px;
        border-radius: 4px;
        font-size: 12px;
        line-height: 18px;
        color: #fff;
        background-color: rgb(0 0 0 / 35%);
    }

    .mx_SharedMedia_link {
        position: relative;
        display: flex;
        min-height: 3.875rem;
        padding-inline-start: 4.4375rem;
    }

    .mx_SharedMedia_linkMedia {
        position: absolute;
        inset-inline-start: 0.6875rem;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 3rem;
        height: 3rem;
        border-radius: 0.375rem;
        font-size: 2rem;
        text-transform: uppercase;
        color: #fff;
        background-color: var(--cpd-color-bg-accent-rest);
    }

    .mx_SharedMedia_linkText {
        display: flex;
        flex-direction: column;
        min-width: 0;
        flex: 1;
        font: var(--cpd-font-body-sm-regular);

        a {
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }
    }

    .mx_SharedMedia_rowTitle {
        display: flex;
        justify-content: space-between;
        margin-block-start: 0.1875rem;
        font: var(--cpd-font-body-md-semibold);
    }

    .mx_SharedMedia_linkSubtitle {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
        white-space: pre-wrap;
        word-break: break-word;
    }

    .mx_SharedMedia_sentTime {
        flex: 0 0 auto;
        margin-inline-start: 8px;
        font-size: 12px;
        color: var(--cpd-color-text-secondary);
    }

    .mx_SharedMedia_sender,
    .mx_SharedMedia_rowMeta {
        align-self: flex-start;
        padding: 0;
        border: 0;
        background: none;
        font: var(--cpd-font-body-xs-regular);
        color: var(--cpd-color-text-secondary);
        cursor: pointer;
    }

    .mx_SharedMedia_row {
        display: flex;
        flex-direction: column;
        gap: var(--cpd-space-1x);
    }

    .mx_SharedMedia_rowMeta {
        display: flex;
        justify-content: space-between;
        width: 100%;
    }

    .mx_SharedMedia_empty {
        padding: var(--cpd-space-8x) var(--cpd-space-4x);
        text-align: center;
        color: var(--cpd-color-text-secondary);
    }

    .mx_SharedMedia_more {
        display: flex;
        justify-content: center;
        min-height: 40px;
    }
}

@keyframes mx_SharedMedia_in {
    from {
        opacity: 0;
    }

    to {
        opacity: 1;
    }
}
