/*
 * The search is a screen of its own on every size, as Telegram's, Slack's and GitHub's are, not a window over
 * the chat list. The glass border, the rounded box and the drawer other dialogs become on a handheld are all
 * dropped (hence the !important: they override Compound's and the handheld dialog rules).
 */
.mx_SpotlightDialog_wrapper {
    .mx_Dialog_border {
        display: contents !important;
    }

    .mx_Dialog {
        position: fixed !important;
        inset: 0 !important;
        width: 100% !important;
        max-width: none !important;
        height: 100dvh !important;
        max-height: none !important;
        margin: 0 !important;
        padding: var(--tg-safe-top, 0px) 0 0 !important;
        box-sizing: border-box;
        overflow: hidden;
        border-radius: 0 !important;
        border: none !important;
        box-shadow: none !important;
        background-color: var(--cpd-color-bg-canvas-default);
        contain: unset;
        animation: mx_SpotlightDialog_in 0.16s ease-out;
    }
}

@keyframes mx_SpotlightDialog_in {
    from {
        opacity: 0;
        transform: translateY(8px);
    }
}

.mx_SpotlightDialog {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;

    .mx_Dialog_header {
        display: none;
    }

    /* One column of reading width, centred, for the header rows and the results alike. */
    .mx_SpotlightDialog_column {
        width: 100%;
        max-width: 760px;
        margin: 0 auto;
        padding: 0 var(--cpd-space-4x);
        box-sizing: border-box;
    }

    .mx_SpotlightDialog_header {
        flex: none;
        display: flex;
        flex-direction: column;
        gap: var(--cpd-space-2x);
        padding: var(--cpd-space-4x) 0 var(--cpd-space-3x);
        border-bottom: 1px solid var(--cpd-color-separator-primary);
    }

    .mx_SpotlightDialog_bar {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-3x);
    }

    .mx_SpotlightDialog_searchBox {
        flex: 1;
        min-width: 0;
        display: flex;
        align-items: center;
        gap: var(--cpd-space-2x);
        height: 44px;
        margin: 0;
        padding: 0 var(--cpd-space-2x) 0 var(--cpd-space-3x);
        box-sizing: border-box;
        border: 1px solid transparent;
        border-radius: 22px;
        background-color: var(--cpd-color-bg-subtle-secondary);
        transition: border-color 0.12s ease-out;

        &:focus-within {
            border-color: var(--cpd-color-border-interactive-hovered);
            background-color: var(--cpd-color-bg-canvas-default);
        }

        > .mx_SpotlightDialog_searchIcon {
            flex: none;
            width: 20px;
            height: 20px;
            color: var(--cpd-color-icon-secondary);
        }

        > input {
            flex: 1;
            min-width: 0;
            display: block;
            box-sizing: border-box;
            height: 100%;
            margin: 0;
            padding: 0;
            border: none;
            background-color: transparent;
            color: var(--cpd-color-text-primary);
            font: var(--cpd-font-body-lg-regular);

            &::placeholder {
                color: var(--cpd-color-text-secondary);
            }
        }

        > .mx_Spinner {
            flex: none;
            width: unset;
            height: unset;
        }

        > .mx_SpotlightDialog_clear {
            flex: none;
            display: flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            border-radius: 50%;
            color: var(--cpd-color-icon-secondary);

            svg {
                width: 18px;
                height: 18px;
            }

            &:hover {
                background-color: var(--cpd-color-bg-subtle-primary);
                color: var(--cpd-color-icon-primary);
            }
        }
    }

    /* Inhibit the selection styling while the focus is not in the field, which is what handles the keyboard. */
    .mx_SpotlightDialog_header:not(:has(.mx_SpotlightDialog_searchBox:focus-within)) + #mx_SpotlightDialog_content {
        --mx_SpotlightDialog_option_selectedBgColor: transparent;

        /* Hide the enter prompt as in this state pressing enter would not actuate that option */
        .mx_SpotlightDialog_enterPrompt {
            visibility: hidden;
        }
    }

    .mx_SpotlightDialog_cancel {
        flex: none;
        color: var(--cpd-color-text-action-accent);
        font: var(--cpd-font-body-lg-medium);
    }

    .mx_SpotlightDialog_close {
        flex: none;
        display: flex;
        align-items: center;
        gap: var(--cpd-space-2x);
        height: 36px;
        padding: 0 var(--cpd-space-2x);
        border-radius: 18px;
        color: var(--cpd-color-icon-secondary);

        kbd {
            padding: 2px var(--cpd-space-1-5x);
            border-radius: 6px;
            background-color: var(--cpd-color-bg-subtle-secondary);
            color: var(--cpd-color-text-secondary);
            font: var(--cpd-font-body-xs-medium);
        }

        svg {
            width: 24px;
            height: 24px;
        }

        &:hover {
            background-color: var(--cpd-color-bg-subtle-secondary);
            color: var(--cpd-color-icon-primary);
        }
    }

    .mx_SpotlightDialog_chipRow {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-2x);
        overflow-x: auto;
        overscroll-behavior-x: contain;
        scrollbar-width: none;
        /* Room for the chips' focus rings, which the scrolling row would clip. */
        padding: 2px 0;

        &::-webkit-scrollbar {
            display: none;
        }

        > button {
            flex: none;
        }
    }

    .mx_SpotlightDialog_chipDivider {
        flex: none;
        width: 1px;
        height: 20px;
        margin: 0 var(--cpd-space-1x);
        background-color: var(--cpd-color-separator-primary);
    }

    #mx_SpotlightDialog_keyboardPrompt {
        flex: none;
        display: flex;
        justify-content: center;
        gap: var(--cpd-space-6x);
        padding: var(--cpd-space-2x) var(--cpd-space-4x);
        border-top: 1px solid var(--cpd-color-separator-primary);
        color: var(--cpd-color-text-secondary);
        font: var(--cpd-font-body-xs-regular);

        kbd {
            display: inline-block;
            min-width: 12px;
            padding: 1px var(--cpd-space-1x);
            margin: 0 2px;
            border-radius: 4px;
            background-color: var(--cpd-color-bg-subtle-secondary);
            color: var(--cpd-color-text-secondary);
            text-align: center;
            /* To avoid any styling inherent with <kbd> elements */
            font-family: inherit;
            font-weight: var(--cpd-font-weight-medium);
            font-size: inherit;
        }
    }

    #mx_SpotlightDialog_content {
        flex: 1;
        min-height: 0;
        overflow-y: auto;
        overscroll-behavior: contain;
        padding: var(--cpd-space-3x) 0 calc(var(--cpd-space-6x) + var(--tg-safe-bottom, 0px));

        ul {
            padding: 0;
            margin: 0;
        }

        .mx_SpotlightDialog_section {
            /* Held at the top while its group scrolls under it, as Telegram's search headings are. */
            > h4,
            > .mx_SpotlightDialog_sectionHeader {
                position: sticky;
                top: calc(-1 * var(--cpd-space-3x));
                z-index: 1;
                margin: 0;
                padding: var(--cpd-space-2x) var(--cpd-space-2x);
                background-color: var(--cpd-color-bg-canvas-default);
            }

            > h4,
            > .mx_SpotlightDialog_sectionHeader > h4 {
                font: var(--cpd-font-body-sm-semibold);
                color: var(--cpd-color-text-secondary);
                margin: 0;
            }

            .mx_SpotlightDialog_sectionHeader {
                display: flex;
                justify-content: space-between;
                align-items: center;

                .mx_SpotlightDialog_options {
                    display: flex;
                    gap: var(--cpd-space-1x);
                }

                .mx_SpotlightDialog_showAll {
                    font: var(--cpd-font-body-sm-semibold);
                    color: var(--cpd-color-text-action-accent);
                    text-decoration: none;
                }
            }

            & + .mx_SpotlightDialog_section {
                margin-top: var(--cpd-space-4x);
            }
        }

        .mx_SpotlightDialog_option {
            border-radius: 12px;
            overflow: hidden;
            text-overflow: ellipsis;

            &:hover,
            &[aria-selected="true"] {
                background-color: var(--mx_SpotlightDialog_option_selectedBgColor, $quinary-content);
            }
        }

        .mx_SpotlightDialog_recentlyViewed {
            > div {
                display: flex;
                white-space: nowrap;
                overflow-x: hidden;
                margin-right: 1px; /* occlude the 1px visible of the very next tile to prevent it looking broken */
            }

            .mx_SpotlightDialog_option {
                padding: var(--cpd-space-1x);
                color: $primary-content;
                font-size: $font-12px;
                line-height: $font-15px;
                display: inline-block;
                width: 58px;
                height: 58px;
                min-width: 58px;
                box-sizing: border-box;
                text-align: center;

                .mx_DecoratedRoomAvatar {
                    margin: 0 9px var(--cpd-space-1x); /* maintain centering */
                }

                & + .mx_SpotlightDialog_option {
                    margin-left: var(--cpd-space-4x);
                }
            }
        }

        .mx_SpotlightDialog_results,
        .mx_SpotlightDialog_recentSearches,
        .mx_SpotlightDialog_otherSearches,
        .mx_SpotlightDialog_hiddenResults {
            .mx_SpotlightDialog_option {
                --mx_SpotlightDialog_option_selectedBgColor: var(--cpd-color-bg-subtle-secondary);

                min-height: 48px;
                box-sizing: border-box;
                padding: var(--cpd-space-2x);
                font-size: $font-15px;
                line-height: $font-24px;
                color: $primary-content;
                position: relative;
                display: flex;
                align-items: center;
                white-space: nowrap;

                .mx_SpotlightDialog_option--endAdornment {
                    display: inline-flex;
                    flex-direction: row;
                    margin-left: auto;
                    align-items: flex-start;
                }

                &.mx_SpotlightDialog_result_multiline {
                    align-items: flex-start;

                    .mx_AccessibleButton {
                        padding: var(--cpd-space-1x) var(--cpd-space-5x);
                        margin: 2px var(--cpd-space-1x);
                    }

                    .mx_SpotlightDialog_enterPrompt {
                        margin-top: 9px;
                        margin-right: var(--cpd-space-2x);
                    }
                }

                .mx_SpotlightDialog_result_name {
                    min-width: 0;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }

                > .mx_SpotlightDialog_metaspaceResult,
                > .mx_DecoratedRoomAvatar,
                > .mx_BaseAvatar {
                    margin-right: var(--cpd-space-2x);
                    width: 24px;
                    height: 24px;
                    flex-shrink: 0;

                    .mx_BaseAvatar {
                        width: inherit;
                        height: inherit;
                    }
                }

                .mx_SpotlightDialog_result_publicRoomDetails {
                    display: flex;
                    flex-direction: column;
                    flex-grow: 1;
                    min-width: 0;

                    .mx_SpotlightDialog_result_publicRoomHeader {
                        display: flex;
                        flex-direction: row;
                        line-height: $font-24px;
                        margin-right: var(--cpd-space-2x);

                        .mx_SpotlightDialog_result_publicRoomName {
                            color: $primary-content;
                            font-size: $font-15px;
                            overflow: hidden;
                            text-overflow: ellipsis;
                        }
                        .mx_SpotlightDialog_result_publicRoomAlias {
                            /* $secondary-content, not $tertiary-content: at 12px this has to meet WCAG AA
                               (4.5:1) against the dialog background, and tertiary is 3.5:1 in the light
                               and dark themes. */
                            color: $secondary-content;
                            font-size: $font-12px;
                            margin-left: var(--cpd-space-2x);
                            overflow: hidden;
                            text-overflow: ellipsis;
                        }
                    }
                    .mx_SpotlightDialog_result_publicRoomDescription {
                        color: $secondary-content;
                        font-size: $font-12px;
                        white-space: normal;
                        word-wrap: break-word;
                        line-height: $font-20px;
                        display: -webkit-box;
                        -webkit-box-orient: vertical;
                        -webkit-line-clamp: 3;
                        overflow: hidden;
                    }
                }

                .mx_SpotlightDialog_notificationBadge {
                    margin-left: var(--cpd-space-2x);
                }

                .mx_SpotlightDialog_option--menu,
                .mx_SpotlightDialog_option--notifications {
                    width: 16px;
                    height: 16px;
                    padding: var(--cpd-space-0-5x);
                    flex-shrink: 0;
                    margin-top: auto;
                    margin-bottom: auto;
                    position: relative;
                    display: none;

                    svg {
                        width: inherit;
                        height: inherit;
                        display: block;
                        color: $tertiary-content;
                    }

                    &:hover svg,
                    &:focus-visible svg {
                        color: $secondary-content;
                    }
                }

                &:hover,
                &[aria-selected="true"] {
                    .mx_SpotlightDialog_option--menu,
                    .mx_SpotlightDialog_option--notifications {
                        display: block;
                    }

                    /* $secondary-content is legible at rest but only 4.2:1 against the hover
                       background ($quinary-content), so step up to $primary-content to keep WCAG AA. */
                    .mx_SpotlightDialog_result_publicRoomDetails {
                        .mx_SpotlightDialog_result_publicRoomHeader .mx_SpotlightDialog_result_publicRoomAlias,
                        .mx_SpotlightDialog_result_publicRoomDescription {
                            color: $primary-content;
                        }
                    }
                }

                &[aria-selected="true"] .mx_SpotlightDialog_enterPrompt {
                    display: inline-block;
                }
            }
        }

        .mx_SpotlightDialog_inviteLink,
        .mx_SpotlightDialog_createRoom {
            margin-top: var(--cpd-space-2x);

            .mx_AccessibleButton {
                position: relative;
                margin: 0;
                padding: 3px var(--cpd-space-2x) 3px var(--cpd-space-7x);

                svg {
                    display: block;
                    position: absolute;
                    left: var(--cpd-space-2x);
                    width: 16px;
                    height: 16px;
                    color: var(--cpd-color-icon-primary);
                }
            }
        }

        .mx_SpotlightDialog_otherSearches {
            .mx_SpotlightDialog_option {
                padding-left: var(--cpd-space-8x);
                position: relative;

                svg {
                    color: $secondary-content;
                    width: 24px;
                    height: 24px;
                    position: absolute;
                    left: var(--cpd-space-1x);
                    top: 50%;
                    transform: translateY(-50%);
                }
            }

            .mx_SpotlightDialog_otherSearches_messageSearchText {
                font-size: $font-15px;
                line-height: $font-24px;
            }
        }

        .mx_SpotlightDialog_result_details {
            margin-left: var(--cpd-space-2x);
            margin-right: var(--cpd-space-2x);
            /* See .mx_SpotlightDialog_result_publicRoomAlias: 12px text needs 4.5:1 at rest too. */
            color: $secondary-content;
            font-size: $font-12px;
            line-height: $font-15px;
            min-width: 0;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        .mx_SpotlightDialog_recentSearches > h4 > .mx_AccessibleButton_kind_link {
            float: right;
            font-size: $font-12px;
            line-height: $font-15px;
            color: $secondary-content;
        }

        .mx_SpotlightDialog_enterPrompt {
            padding: 2px var(--cpd-space-1x);
            /* To avoid any styling inherent with <kbd> elements */
            font-family: inherit;
            font-weight: inherit;
            font-size: $font-12px;
            line-height: $font-15px;
            color: $tertiary-content;
            border-radius: 6px;
            background-color: $quinary-content;
            margin-right: var(--cpd-space-1x);
            display: none;
        }

        .mx_SpotlightDialog_metaspaceResult svg {
            color: $secondary-content;
            width: inherit;
            height: inherit;
        }
    }
}

/* ---- Messages, empty states, and the handheld ---------------------------------------------------------- */

.mx_SpotlightDialog.mx_SpotlightDialog #mx_SpotlightDialog_content {
    .mx_SpotlightDialog_results .mx_SpotlightDialog_option.mx_SpotlightDialog_message {
        /* A chat list row, as Telegram draws a message hit: the chat's avatar, its name and the date, and
           under them who said it and the words that matched. */
        align-items: center;
        gap: var(--cpd-space-3x);
        min-height: 68px;
        white-space: normal;

        > .mx_BaseAvatar {
            flex: none;
            width: 48px;
            height: 48px;
            margin: 0;
        }

        .mx_SpotlightDialog_message_text {
            flex: 1;
            min-width: 0;
            display: flex;
            flex-direction: column;
            gap: 2px;
        }

        .mx_SpotlightDialog_message_head {
            display: flex;
            align-items: baseline;
            gap: var(--cpd-space-2x);
        }

        .mx_SpotlightDialog_message_room {
            flex: 1;
            min-width: 0;
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            font: var(--cpd-font-body-md-semibold);
            color: var(--cpd-color-text-primary);
        }

        .mx_SpotlightDialog_message_date {
            flex: none;
            font: var(--cpd-font-body-xs-regular);
            color: var(--cpd-color-text-secondary);
        }

        .mx_SpotlightDialog_message_line {
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            font: var(--cpd-font-body-sm-regular);
            color: var(--cpd-color-text-secondary);

            .mx_SpotlightDialog_message_sender {
                color: var(--cpd-color-text-primary);
            }

            mark {
                border-radius: 3px;
                padding: 0 1px;
                background-color: var(--cpd-color-bg-accent-subtle, var(--cpd-color-bg-subtle-secondary));
                color: var(--cpd-color-text-action-accent);
                font-weight: var(--cpd-font-weight-semibold);
            }
        }

        .mx_SpotlightDialog_option--endAdornment {
            align-self: center;
        }
    }

    .mx_SpotlightDialog_messageSkeleton {
        display: flex;
        align-items: center;
        gap: var(--cpd-space-3x);
        min-height: 68px;
        padding: var(--cpd-space-2x);
        box-sizing: border-box;
        list-style: none;

        .mx_SpotlightDialog_skeletonAvatar {
            flex: none;
            width: 48px;
            height: 48px;
            border-radius: 50%;
        }

        .mx_SpotlightDialog_skeletonLines {
            display: flex;
            flex: 1;
            flex-direction: column;
            gap: var(--cpd-space-2x);

            > span {
                height: 12px;
                border-radius: 6px;

                &:first-child {
                    width: 35%;
                }

                &:last-child {
                    width: 75%;
                }
            }
        }

        .mx_SpotlightDialog_skeletonAvatar,
        .mx_SpotlightDialog_skeletonLines > span {
            background-color: var(--cpd-color-bg-subtle-primary);
            animation: mx_SpotlightDialog_pulse 1.2s ease-in-out infinite;
        }
    }

    .mx_SpotlightDialog_messagesNote {
        margin: var(--cpd-space-4x);
        color: var(--cpd-color-text-secondary);
        font: var(--cpd-font-body-sm-regular);
        text-align: center;
    }

    .mx_SpotlightDialog_messagesEnd {
        min-height: 1px;
    }

    .mx_SpotlightDialog_results .mx_SpotlightDialog_option.mx_SpotlightDialog_noResults {
        justify-content: center;
        white-space: normal;

        &:hover {
            background-color: transparent;
        }

        .mx_SpotlightDialog_option--endAdornment {
            display: none;
        }
    }
}

.mx_SpotlightDialog_emptyState {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--cpd-space-2x);
    padding: var(--cpd-space-16x) var(--cpd-space-6x) var(--cpd-space-8x);
    text-align: center;

    .mx_SpotlightDialog_emptyState_icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 56px;
        height: 56px;
        margin-bottom: var(--cpd-space-2x);
        border-radius: 50%;
        background-color: var(--cpd-color-bg-subtle-secondary);
        color: var(--cpd-color-icon-secondary);

        svg {
            width: 28px;
            height: 28px;
        }
    }

    .mx_SpotlightDialog_emptyState_title {
        font: var(--cpd-font-heading-sm-semibold);
        color: var(--cpd-color-text-primary);
    }

    .mx_SpotlightDialog_emptyState_description {
        max-width: 320px;
        font: var(--cpd-font-body-md-regular);
        color: var(--cpd-color-text-secondary);
    }
}

@keyframes mx_SpotlightDialog_pulse {
    50% {
        opacity: 0.45;
    }
}

@media (prefers-reduced-motion: reduce) {
    .mx_SpotlightDialog_wrapper .mx_Dialog,
    .mx_SpotlightDialog .mx_SpotlightDialog_messageSkeleton * {
        animation: none !important;
    }
}

/*
 * On a handheld: Cancel instead of the close button, no keyboard hints, taller rows for a thumb, and the
 * horizontal "Recently viewed" strip scrollable by touch.
 */
.mx_SpotlightDialog.mx_SpotlightDialog_handheld {
    .mx_SpotlightDialog_header {
        padding-top: var(--cpd-space-2x);
    }

    .mx_SpotlightDialog_column {
        padding: 0 var(--cpd-space-3x);
    }

    #mx_SpotlightDialog_keyboardPrompt,
    .mx_SpotlightDialog_enterPrompt,
    .mx_SpotlightDialog_option--endAdornment kbd {
        display: none !important;
    }

    .mx_SpotlightDialog_searchBox > input {
        /* 16px or more keeps iOS from zooming into the field when it takes the focus. */
        font-size: 1rem;
    }

    #mx_SpotlightDialog_content {
        .mx_SpotlightDialog_results .mx_SpotlightDialog_option {
            min-height: 56px;
        }

        .mx_SpotlightDialog_recentlyViewed {
            > div {
                overflow-x: auto;
                scrollbar-width: none;
                padding-bottom: var(--cpd-space-1x);
            }

            .mx_SpotlightDialog_option {
                width: 72px;
                min-width: 72px;
                height: auto;
            }
        }
    }
}
