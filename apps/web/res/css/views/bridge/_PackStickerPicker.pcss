/* Sticker picker for MSC2545 image packs, laid out like Telegram Web's sticker tab. */
.mx_PackStickerPicker {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    max-width: calc(100vw - 16px);
    padding: var(--cpd-space-2x);
    gap: var(--cpd-space-2x);
    background-color: var(--cpd-color-bg-canvas-default);
    border-radius: 12px;
}

.mx_PackStickerPicker_search {
    box-sizing: border-box;
    width: 100%;
    padding: var(--cpd-space-1-5x) var(--cpd-space-3x);
    border: 1px solid var(--cpd-color-border-interactive-secondary);
    border-radius: 18px;
    background-color: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-text-primary);
    font: var(--cpd-font-body-md-regular);

    &:focus {
        outline: none;
        border-color: var(--cpd-color-border-interactive-primary);
    }
}

.mx_PackStickerPicker_packName {
    color: var(--cpd-color-text-secondary);
    font: var(--cpd-font-body-sm-semibold);
    padding-inline: var(--cpd-space-1x);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_PackStickerPicker_body {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
}

.mx_PackStickerPicker_grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(72px, 1fr));
    gap: var(--cpd-space-1x);
}

.mx_PackStickerPicker_sticker {
    aspect-ratio: 1;
    padding: 4px;
    border: none;
    border-radius: 8px;
    background: none;
    cursor: pointer;

    &:hover,
    &:focus-visible {
        background-color: var(--cpd-color-bg-subtle-secondary);
    }
}

.mx_PackStickerPicker_media {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    pointer-events: none;
}

.mx_PackStickerPicker_status {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--cpd-space-2x);
    height: 100%;
    color: var(--cpd-color-text-secondary);
}

.mx_PackStickerPicker_tabs {
    display: flex;
    gap: var(--cpd-space-1x);
    overflow-x: auto;
    padding-top: var(--cpd-space-1x);
    border-top: 1px solid var(--cpd-color-separator-primary);
    flex-shrink: 0;
}

.mx_PackStickerPicker_tab {
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    padding: 4px;
    border: none;
    border-radius: 8px;
    background: none;
    cursor: pointer;
    color: var(--cpd-color-text-secondary);

    img,
    video {
        width: 100%;
        height: 100%;
        object-fit: contain;
        pointer-events: none;
    }

    &:hover,
    &.mx_PackStickerPicker_tab_selected {
        background-color: var(--cpd-color-bg-subtle-secondary);
    }
}
