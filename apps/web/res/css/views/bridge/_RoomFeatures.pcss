.mx_MessageComposerFormatBar_button[aria-disabled="true"] {
    opacity: 0.4;
    cursor: not-allowed;
}

.mx_RejectedFiles {
    padding-inline-start: var(--cpd-space-5x);
    text-align: start;
    word-break: break-word;
}

/* Edit/remove entries kept visible (but inert) to explain the bridged network's limits. */
.mx_IconizedContextMenu_item.mx_BlockedAction {
    opacity: 0.5;
    cursor: not-allowed;
}
