/* Telegram-style "last seen …" subtitle under a DM's name. */
.mx_LastSeen {
    color: var(--cpd-color-text-secondary);
    text-align: start;

    &[data-online="true"] {
        color: var(--cpd-color-text-action-accent);
    }
}

/*
 * "••• typing" in the header, like Telegram Web. Dot sizes and keyframes follow Telegram Web K's
 * _peerTyping.scss (GPL-3.0): scale 1 → 2/3, opacity 1 → 0.8, 0.6s cycle.
 */
.mx_TypingIndicator {
    color: var(--cpd-color-text-action-accent);
    display: flex;
    align-items: center;
    min-width: 0;

    .mx_TypingIndicator_text {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }
}

.mx_TypingIndicator_dots {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    margin-inline-end: 4px;
}

.mx_TypingIndicator_dot {
    width: 6px;
    height: 6px;
    margin: 0 0.5px;
    border-radius: 50%;
    background-color: currentcolor;
    animation: mx_TypingIndicator_dotMiddle 0.6s linear infinite;

    &.mx_TypingIndicator_dot_first {
        animation-name: mx_TypingIndicator_dotFirst;
    }

    &.mx_TypingIndicator_dot_last {
        animation-name: mx_TypingIndicator_dotLast;
    }
}

@media (prefers-reduced-motion: reduce) {
    .mx_TypingIndicator_dot {
        animation: none;
    }
}

@keyframes mx_TypingIndicator_dotFirst {
    0%,
    50%,
    100% {
        transform: scale(0.6667);
        opacity: 0.8;
    }

    75% {
        transform: scale(1);
        opacity: 1;
    }
}

@keyframes mx_TypingIndicator_dotMiddle {
    0%,
    100% {
        transform: scale(0.8333);
        opacity: 0.9;
    }

    12.5%,
    62.5% {
        transform: scale(0.6667);
        opacity: 0.8;
    }

    87.5% {
        transform: scale(1);
        opacity: 1;
    }
}

@keyframes mx_TypingIndicator_dotLast {
    0%,
    100% {
        transform: scale(1);
        opacity: 1;
    }

    25%,
    75% {
        transform: scale(0.6667);
        opacity: 0.8;
    }
}
