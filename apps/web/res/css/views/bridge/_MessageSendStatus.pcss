/*
 * The mark rides at the end of the message's last line, the way a messenger puts its ticks, rather
 * than starting a line of its own underneath: it is a property of the message, not a remark about it.
 * Floated because the body is drawn before it and may be several lines long — the float settles onto
 * whichever line ends up last. The Telegram-style bubbles have their own slot for this (TelegramTime)
 * and never render it here.
 */
.mx_SendStatus {
    display: inline-flex;
    align-items: center;
    gap: var(--cpd-space-1x);
    float: inline-end;
    margin-block-start: 2px;
    margin-inline-start: var(--cpd-space-2x);
    vertical-align: middle;
    color: var(--cpd-color-icon-tertiary);
}

.mx_SendStatus_delivered {
    color: var(--cpd-color-icon-success-primary);
}

.mx_SendStatus_failed {
    display: flex;
    float: none;
    margin-block-start: var(--cpd-space-1x);
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-critical-primary);

    svg {
        flex-shrink: 0;
        color: var(--cpd-color-icon-critical-primary);
    }

    .mx_SendStatus_retry {
        display: inline-flex;
        align-items: center;
        gap: var(--cpd-space-1x);
        margin-inline-start: var(--cpd-space-2x);

        svg {
            color: inherit;
        }
    }
}
