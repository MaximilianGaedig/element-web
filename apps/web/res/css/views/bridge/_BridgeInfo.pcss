.mx_BridgeNetworkHeaderBadge {
    gap: var(--cpd-space-1x);
}

/* Room-list avatar with the bridged network's icon tucked into its bottom-right corner. */
.mx_BridgedRoomAvatar {
    position: relative;
    display: inline-flex;
    flex-shrink: 0;

    > .mx_BridgeNetworkIcon {
        position: absolute;
        /* Bottom-left: Element's presence dot occupies the bottom-right corner. */
        inset-inline-start: -3px;
        inset-block-end: -3px;
        border-radius: 4px;
        box-shadow: 0 0 0 2px var(--cpd-color-bg-canvas-default);
    }
}
