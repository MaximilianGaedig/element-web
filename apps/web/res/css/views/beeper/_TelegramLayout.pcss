/*
 * Telegram-style layout (setting "telegramStyleLayout", on by default). Dimensions follow Telegram
 * Web K (GPL-3.0): chat content at most 696px wide and centred (helpers/updateColumnWidths.ts
 * CHAT_WIDTH_MAX), compact message padding, bubble radius 15px and bubble max width 85%
 * (scss/partials/_chatVariables.scss, _chatBubble.scss). Media sizes live in ImageSize.ts.
 * The IRC layout is left alone.
 */
.mx_RoomView_body[data-telegram-layout="true"]:not([data-layout="irc"]) {
    --TelegramLayout-chat-width: 696px;

    /* Let the scroll panel span the room (scrollbar at the edge) and centre its content instead. */
    .mx_RoomView_timeline {
        max-width: none;
    }

    .mx_RoomView_MessageList {
        width: 100%;
        max-width: calc(var(--TelegramLayout-chat-width) + 2 * var(--RoomView_MessageList-padding));
        margin-inline: auto;
    }

    .mx_RoomView_statusArea,
    .mx_MessageComposer {
        width: 100%;
        max-width: calc(var(--TelegramLayout-chat-width) + 2 * var(--RoomView_MessageList-padding));
        margin-inline: auto;
    }
}

/*
 * Event tiles are the shared-components EventTileView (a CSS module), which declares its geometry
 * as custom properties on the tile root; the tile root carries data-testid="event-tile".
 * The gutter drives the bubble padding (gutter - 1px, plus 1px around the content), so 5px gives
 * Telegram's ~5px text inset and a 2.5px gap between bubbles.
 */
.mx_RoomView_body[data-telegram-layout="true"] [data-testid="event-tile"] {
    --event-tile-bubble-corner-radius: 15px;
    --event-tile-bubble-line-max-width: 85%;
    --event-tile-bubble-gutter: 5px;
}

/* One-to-one chats: no avatars (and no names), so the bubbles start at the edge like Telegram. */
.mx_RoomView_body[data-telegram-layout="true"]
    .mx_MessagePanel_noAvatars
    .mx_RoomView_MessageList
    > [data-testid="event-tile"] {
    --event-tile-bubble-margin-inline-start: 8px;
}

.mx_RoomView_body[data-telegram-layout="true"] .mx_GenericEventListSummary[data-layout="bubble"] {
    --maxWidth: 85%;
}

/*
 * tweb `.bubble-content { box-shadow: 0 1px 2px 0 rgba(16, 35, 47, .15) }` (_chatBubble.scss): every
 * bubble, media included, carries a faint edge, so a photo never blends into the chat background.
 * `.bubble.just-media` (stickers) drops both the background and the shadow. Element's media roots clip
 * their overflow, so the edge is drawn inside the media box as an overlay.
 */
.mx_RoomView_body[data-telegram-layout="true"] {
    --TelegramLayout-media-edge: rgb(16 35 47 / 15%);

    :is(
        .mx_ImageBody_container,
        .mx_MVideoBody_container,
        .mx_MAlbumBody_grid,
        .mx_BeeperAnimatedVideo:not(.mx_BeeperAnimatedVideo_sticker)
    ) {
        position: relative;

        &::after {
            content: "";
            position: absolute;
            inset: 0;
            z-index: 1;
            border-radius: inherit;
            box-shadow:
                inset 0 0 0 1px var(--TelegramLayout-media-edge),
                inset 0 -1px 2px 0 var(--TelegramLayout-media-edge);
            pointer-events: none;
        }
    }

    /* Stickers: no background, no edge. */
    :is(.mx_MStickerBody_wrapper, .mx_BeeperAnimatedVideo_sticker) {
        &,
        .mx_MImageBody_thumbnail_container,
        video {
            background: none;
            box-shadow: none;
        }
    }
}

.cpd-theme-dark .mx_RoomView_body[data-telegram-layout="true"] {
    --TelegramLayout-media-edge: rgb(255 255 255 / 10%);
}
