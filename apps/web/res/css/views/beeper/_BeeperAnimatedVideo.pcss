/* Bridged GIF / animated sticker, played muted and looping without controls. */
.mx_BeeperAnimatedVideo {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    max-width: 100%;
    border-radius: var(--MBody-border-radius, 8px);
    overflow: hidden;

    video {
        display: block;
        max-width: 100%;
        height: auto;
        cursor: pointer;
        object-fit: contain;
    }

    .mx_BeeperAnimatedVideo_badge {
        position: absolute;
        inset-block-start: var(--cpd-space-2x);
        inset-inline-start: var(--cpd-space-2x);
        padding: 0 var(--cpd-space-1x);
        border-radius: 4px;
        font: var(--cpd-font-body-xs-semibold);
        color: #fff;
        background-color: rgb(0 0 0 / 60%);
        pointer-events: none;
    }

    .mx_BeeperAnimatedVideo_pack {
        position: absolute;
        inset-block-end: var(--cpd-space-1x);
        inset-inline-start: 50%;
        transform: translateX(-50%);
        padding: 0 var(--cpd-space-2x);
        border-radius: 999px;
        font: var(--cpd-font-body-xs-regular);
        white-space: nowrap;
        color: #fff;
        background-color: rgb(0 0 0 / 60%);
        opacity: 0;
        transition: opacity 0.15s;
    }

    &:hover .mx_BeeperAnimatedVideo_pack,
    &:focus-within .mx_BeeperAnimatedVideo_pack {
        opacity: 1;
    }
}

/* Stickers: no bubble, no background, like m.sticker tiles. */
.mx_BeeperAnimatedVideo.mx_BeeperAnimatedVideo_sticker {
    border-radius: 0;
    background: none;
}

.mx_BeeperAnimatedVideoLightbox {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;

    video {
        max-width: 90vw;
        max-height: 85vh;
    }

    .mx_BeeperAnimatedVideoLightbox_close {
        position: absolute;
        inset-block-start: var(--cpd-space-4x);
        inset-inline-end: var(--cpd-space-4x);
        font-size: 2rem;
        color: #fff;
    }
}
