/*
 * Online / recently-active dot. The pop-in uses Telegram Web K's badge transition
 * (tweb src/scss/base.scss --chatlist-badge-transition-in: .25s cubic-bezier(.35,.35,.47,1.34),
 * src/scss/partials/_chatlist.scss dialog-badge-transition), scale 0 → 1. The fade with time
 * since last activity is ours: the colour ages from green to amber, see below.
 */
.mx_ActivityDot {
    display: block;
    box-sizing: border-box;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    /*
     * Green while online, then through yellow to amber ("away") as the last activity ages: one
     * OKLCH mix from green to orange passes through yellow on its own. Only the last stretch fades.
     */
    --ActivityDot-away: var(--cpd-color-orange-800);
    background-color: color-mix(
        in oklch,
        var(--cpd-color-icon-accent-primary) calc(var(--mx-activity, 1) * 100%),
        var(--ActivityDot-away)
    );
    opacity: clamp(0.35, calc(var(--mx-activity, 1) * 4), 1);
    transition:
        background-color 1s linear,
        opacity 1s linear;
    animation: mx_ActivityDot_in 0.25s cubic-bezier(0.35, 0.35, 0.47, 1.34) both;
}

@keyframes mx_ActivityDot_in {
    from {
        transform: scale(0);
    }

    to {
        transform: scale(1);
    }
}

/*
 * Room list: the avatar is masked with a hole for the dot (room-avatar-view-presence-mask.svg, a
 * radius-6 circle centred on the right edge, 6px above the bottom of a 32px avatar). The dot fills
 * that hole exactly, at any avatar size.
 */
.mx_RoomAvatarView .mx_ActivityDot.mx_RoomAvatarView_PresenceDecoration {
    --ActivityDot-size: calc(var(--room-avatar-size, 32px) * 12 / 32);

    width: var(--ActivityDot-size);
    height: var(--ActivityDot-size);
    left: calc(var(--room-avatar-size, 32px) - var(--ActivityDot-size) / 2);
    bottom: 0;
}
