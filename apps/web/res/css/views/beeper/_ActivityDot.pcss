/*
 * Presence badge as Messenger/Facebook draw it: a grass-green dot while online, a small green
 * "12m" tag for someone active within the hour. Placement follows Telegram Web K
 * (src/scss/partials/_avatar.scss .is-online:after: 14px on a 54px avatar at 39px, i.e. tucked into
 * the bottom-right corner), and the pop-in is tweb's badge transition
 * (--chatlist-badge-transition-in: .25s cubic-bezier(.35,.35,.47,1.34)). Instead of tweb's ring in
 * the surface colour, the room list cuts a transparent gap into the avatar, so it works on any row
 * background (hover, selected).
 */
:root,
[class*="cpd-theme-"] {
    --ActivityDot-online: #31a24c;
    --ActivityDot-recent-bg: #ddf3e2;
    --ActivityDot-recent-fg: #1f7a37;
}

.cpd-theme-dark {
    --ActivityDot-online: #45bd62;
    --ActivityDot-recent-bg: #1c3a24;
    --ActivityDot-recent-fg: #6fd68a;
}

.mx_ActivityDot {
    display: block;
    box-sizing: border-box;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--ActivityDot-online);
    animation: mx_ActivityDot_in 0.25s cubic-bezier(0.35, 0.35, 0.47, 1.34) both;
}

.mx_ActivityDot.mx_ActivityDot_recent {
    width: auto;
    min-width: 16px;
    height: 12px;
    padding: 0 3px;
    border-radius: 6px;
    font: var(--cpd-font-body-xs-semibold);
    font-size: 9px;
    line-height: 12px;
    text-align: center;
    white-space: nowrap;
    color: var(--ActivityDot-recent-fg);
    background-color: var(--ActivityDot-recent-bg);
}

@keyframes mx_ActivityDot_in {
    from {
        transform: scale(0);
    }

    to {
        transform: scale(1);
    }
}

/* Room list (32px avatar): cut-outs in res/img/beeper/avatar-mask-{dot,pill}.svg. */
.mx_RoomAvatarView {
    .mx_RoomAvatarView_RoomAvatar_presence {
        mask-image: url("/res/img/beeper/avatar-mask-dot.svg");
    }

    .mx_RoomAvatarView_RoomAvatar_recent {
        mask-image: url("/res/img/beeper/avatar-mask-pill.svg");
    }

    /* 8px presence icons and the 10px dot share the cut-out centred at (27, 27). */
    .mx_RoomAvatarView_PresenceDecoration {
        left: auto;
        right: 1px;
        bottom: 1px;
    }

    .mx_ActivityDot.mx_RoomAvatarView_PresenceDecoration {
        right: 0;
        bottom: 0;
    }

    .mx_ActivityDot_recent.mx_RoomAvatarView_PresenceDecoration {
        right: -2px;
        bottom: 0;
        transform-origin: right bottom;
    }
}
