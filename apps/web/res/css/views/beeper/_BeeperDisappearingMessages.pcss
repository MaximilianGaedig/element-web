/* A message hidden client-side by a Beeper extension, e.g. a disappearing message that expired. */
.mx_EventTile.mx_EventTile_beeperHidden {
    display: none;
}

.mx_DisappearingMessageBadge {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    margin-inline-end: var(--cpd-space-1x);
    vertical-align: middle;
    font: var(--cpd-font-body-xs-regular);
    color: var(--cpd-color-text-secondary);

    svg {
        color: var(--cpd-color-icon-tertiary);
    }
}

.mx_BeeperRoomHeaderBadge {
    display: inline-flex;
    align-items: center;
    flex-shrink: 0;
    gap: 2px;
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);

    svg {
        color: var(--cpd-color-icon-secondary);
    }
}
