/* A bridged system action such as a call, rendered like other one-line timeline notices. */
.mx_BeeperActionMessage {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    color: var(--cpd-color-text-secondary);

    svg {
        flex-shrink: 0;
        color: var(--cpd-color-icon-secondary);
    }
}
