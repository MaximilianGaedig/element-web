/* The row of emoji at the top of the message menu: Element's own menu, with reactions one click away. */
.mx_MessageMenuReactions {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.125rem;
    padding: 0.375rem 0.5rem;
    border-bottom: 1px solid var(--cpd-color-border-disabled);
}

.mx_MessageMenuReactions_emoji,
.mx_MessageMenuReactions_more {
    all: unset;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    font-size: 1.375rem;
    line-height: 1;
    cursor: pointer;

    &:hover:not(:disabled),
    &:focus-visible {
        background: var(--cpd-color-bg-subtle-secondary);
    }

    &:disabled {
        opacity: 0.35;
        cursor: not-allowed;
    }

    &[aria-pressed="true"] {
        background: color-mix(
            in srgb,
            var(--tg-primary-color, var(--cpd-color-bg-action-primary-rest)) 22%,
            transparent
        );
    }
}

.mx_MessageMenuReactions_more {
    color: var(--cpd-color-icon-secondary);

    svg {
        width: 1.5rem;
        height: 1.5rem;
    }
}
