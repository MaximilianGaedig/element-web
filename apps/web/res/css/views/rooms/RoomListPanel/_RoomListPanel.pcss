.mx_RoomListPanel {
    /*
     * The bar's height: an icon, a label and the padding around them. Declared once and the pill held to
     * it exactly, because every list under the bar reserves this much room at its foot - a pill that grew
     * past its declared height hid the last row of every list behind it.
     */
    --mx-room-list-pill-height: 64px;
    /*
     * The unread-activity toast shares this edge, and had the higher z-index, so it simply hid the pill.
     * Lifted clear of it rather than the pill moved: the pill is the persistent control and belongs at
     * the bottom, with a banner above it, which is the order iOS uses.
     */
    /*
     * How far the floating bar sits from the bottom of the column. Over a home indicator it rests just
     * above the indicator itself rather than a full margin above the whole of the space kept for it:
     * that space is 34px with the indicator in the lowest 13 of it, and a margin on top of all 34 left
     * the bar hanging 50px up the screen.
     */
    --mx-room-list-bar-bottom: max(var(--cpd-space-4x), calc(var(--tg-safe-bottom, 0px) - var(--cpd-space-2x)));
    --mx-room-list-toast-bottom: calc(
        var(--mx-room-list-bar-bottom) + var(--mx-room-list-pill-height) + var(--cpd-space-2x)
    );

    /* The containing block for the pill floating over the list. */
    position: relative;
    background-color: var(--cpd-color-bg-canvas-default);
    height: 100%;
}

/*
 * The two things that are about every chat rather than about one of them: what is waiting for you, and
 * what the chats turned out to contain. Side by side while they are both buttons; once the digest opens
 * into a panel it takes the row and the other wraps below it.
 */
.mx_RoomListPanel_tools {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--cpd-space-2x);
    padding: var(--cpd-space-1x) var(--cpd-space-3x);
}

.mx_RoomListPanel_found {
    flex: 0 0 auto;
    white-space: nowrap;
}

/*
 * The whole-list actions, floating over the list rather than taking a row above it.
 *
 * Centred and clear of the home indicator, as iOS keeps this kind of control, and the list scrolls
 * underneath: on a handset the row it replaces was the scarcest thing on screen.
 *
 * Glass, in the manner of the iOS 26/27 pills: translucent over what is behind, blurred and saturated
 * so the colours beneath read through it, a bright hairline along the top edge where the light catches,
 * and a soft shadow holding it off the list. All of it through the fork's own glass variables, so low
 * power mode and scrolling drop the blur here exactly as they do everywhere else - a backdrop filter
 * over a scrolling list is the one that costs a fifth of a core.
 */
.mx_RoomListPill_bar {
    --mx-room-list-island: 44px;

    position: absolute;
    bottom: var(--mx-room-list-bar-bottom, var(--cpd-space-4x));
    inset-inline: var(--cpd-space-4x);
    /*
     * Above the sticky section headers, as the toast is, and above the screens contacts opens over the
     * column (a card, the duplicates, the editor - z-index 4): the bar is how you get anywhere else, so
     * nothing opened from it covers it.
     */
    z-index: 5;
    /*
     * Three columns with the outer two the same width: the pill is centred whatever the sides hold, so the
     * + coming and going (it is only there over People, and not while its editor is open) moves nothing.
     * Search sits at the start edge and + at the end edge, rather than huddled against the pill.
     */
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    column-gap: var(--cpd-space-2x);
    /* The empty parts of the row are not a control: the list under them stays scrollable and tappable. */
    pointer-events: none;

    > * {
        grid-row: 1;
        pointer-events: auto;
    }
}

/* The glass all three are made of: the same as the composer's islands. */
.mx_RoomListPill,
.mx_RoomListPill_island {
    border-radius: 99px;
    /*
     * The same glass the shared media strip uses when it sticks: the list scrolling underneath is blurred
     * behind the bar rather than covered by a solid one, so the column stays visibly continuous.
     */
    background: color-mix(in srgb, var(--cpd-color-bg-canvas-default) 72%, transparent);
    backdrop-filter: blur(16px) saturate(180%);
    /* The Telegram layout's glass rim (_TgBase.pcss); nothing outside that layout defines it, so no rim there. */
    box-shadow:
        var(--tg-glass-border, 0 0 transparent),
        0 1px 2px rgb(0 0 0 / 10%),
        0 8px 24px rgb(0 0 0 / 14%);
}

.mx_RoomListPill {
    grid-column: 2;
    /* The containing block for the travelling selection mark. */
    position: relative;
    display: flex;
    align-items: center;
    height: var(--mx-room-list-pill-height);
    box-sizing: border-box;
    gap: 2px;
    padding: var(--cpd-space-1x);
    overflow: hidden;
    transition: opacity 160ms ease;
}

/*
 * The mark on the entry you are in, which travels to it.
 *
 * Behind the entries and driven from their measured boxes (useSlidingIndicator), the way
 * mx_SharedMedia_tabBackground is: the entries are not all the same width, so the shape has to be told
 * where to go rather than work it out from a count.
 */
.mx_RoomListPill_selection {
    position: absolute;
    inset-block: var(--cpd-space-1x);
    inset-inline-start: 0;
    border-radius: 99px;
    /*
     * A tinted capsule, not a solid black one: the bar floats on glass over a white list, and filling the
     * current entry with the action colour put a heavy dark blob in the middle of it. The mark says where
     * you are by tinting what is on top of it, which is what it is for.
     */
    background: var(--cpd-color-bg-subtle-primary);
    transition:
        transform 260ms cubic-bezier(0.2, 0, 0, 1),
        width 260ms cubic-bezier(0.2, 0, 0, 1);
    pointer-events: none;
}

/*
 * Search and add, apart from the pill: round islands as tall as the pill, the way the microphone stands
 * beside the composer - search at the start of the row, add at the end. Searching a list in place turns
 * the search island into the field and hands it the others' width - thinner than the pill, as a text field
 * is, because it no longer holds labelled icons.
 */
.mx_RoomListPill_island {
    display: flex;
    align-items: center;
    /* As tall as the search field it turns into: smaller than the pill, which holds labelled icons. */
    width: var(--mx-room-list-island);
    height: var(--mx-room-list-island);
    box-sizing: border-box;
    overflow: hidden;
    /*
     * The islands swap in place: whichever is not wanted fades and shrinks where it stands, the other grows
     * out of the same spot. Both stay rendered, so the change animates in both directions.
     */
    transition:
        width 260ms cubic-bezier(0.2, 0, 0, 1),
        opacity 180ms ease,
        transform 260ms cubic-bezier(0.2, 0, 0, 1);

    &[data-hidden] {
        opacity: 0;
        transform: scale(0.6);
        pointer-events: none;
    }
}

.mx_RoomListPill_find {
    grid-column: 1;
    justify-self: start;
}

.mx_RoomListPill_add {
    grid-column: 3;
    justify-self: end;
}

.mx_RoomListPill_find input {
    /* No border and no box of its own: the island around it is the field's edge. */
    flex: 1 1 auto;
    width: 0;
    min-width: 0;
    padding: 0;
    border: none;
    outline: none;
    background: transparent;
    color: var(--cpd-color-text-primary);
    font: var(--cpd-font-body-md-regular);

    &::-webkit-search-cancel-button {
        display: none;
    }
}

.mx_RoomListPill_islandButton,
.mx_RoomListPill_add {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    padding: 0;
    border: none;
    border-radius: 99px;
    color: var(--cpd-color-icon-secondary);
    cursor: pointer;

    &:hover,
    &:focus-visible {
        color: var(--cpd-color-icon-primary);
    }
}

/* Inside the search island, the button is the island until the island becomes a field. */
.mx_RoomListPill_islandButton {
    width: 100%;
    height: 100%;
    background: transparent;
}

/*
 * A screen's own two answers (the duplicates' ignore all / merge all) in place of search and add. There is no
 * room for words beside the pill on a phone, so while they are up the pill steps aside and each takes half
 * the row, grown from the corner of the island it replaces.
 */
.mx_RoomListPill_action {
    position: absolute;
    inset-block-start: calc((var(--mx-room-list-pill-height) - var(--mx-room-list-island)) / 2);
    width: calc(50% - var(--cpd-space-1x));
    justify-content: center;
    padding: 0 var(--cpd-space-3x);
    border: none;
    color: var(--cpd-color-text-primary);
    font: var(--cpd-font-body-md-semibold);
    white-space: nowrap;
    cursor: pointer;

    &[data-primary] {
        background: var(--cpd-color-bg-action-primary-rest);
        color: var(--cpd-color-text-on-solid-primary);
    }

    &[data-hidden] {
        width: var(--mx-room-list-island);
        padding: 0;
        /* The words would spill out of the circle it shrinks into. */
        color: transparent;
    }
}

.mx_RoomListPill_action_start {
    inset-inline-start: 0;
    transform-origin: left center;
}

.mx_RoomListPill_action_end {
    inset-inline-end: 0;
    transform-origin: right center;
}

.mx_RoomListPill_bar[data-actions] .mx_RoomListPill {
    opacity: 0;
    pointer-events: none;
}

.mx_RoomListPill_bar[data-searching] {
    .mx_RoomListPill,
    .mx_RoomListPill_add {
        opacity: 0;
        pointer-events: none;
    }

    /* The field takes the whole row, over where the pill was. */
    .mx_RoomListPill_find {
        grid-column: 1 / -1;
        width: 100%;
        z-index: 1;

        .mx_RoomListPill_islandButton {
            width: var(--mx-room-list-island);
        }
    }
}

@media (prefers-reduced-motion: reduce) {
    .mx_RoomListPill,
    .mx_RoomListPill_island {
        transition: none;
    }
}

.mx_RoomListPill_entry {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--cpd-space-1x);
    /* Three of these and two islands have to fit a phone-width column: 56px each, the label decides. */
    min-width: 56px;
    min-height: 44px;
    padding: var(--cpd-space-1x) var(--cpd-space-2x);
    border: none;
    border-radius: 99px;
    background: transparent;
    color: var(--cpd-color-icon-secondary);
    font: var(--cpd-font-body-xs-medium);
    letter-spacing: 0.01em;
    cursor: pointer;
    /* The mark moves; only the colour of what is on top of it changes. */
    transition: color 160ms ease;

    &:hover,
    &:focus-visible {
        color: var(--cpd-color-icon-primary);
    }

    &[aria-current="page"] {
        color: var(--cpd-color-text-action-accent);
    }

    span {
        line-height: 1.1;
        white-space: nowrap;
    }
}

@media (prefers-reduced-motion: reduce) {
    .mx_RoomListPill_entry,
    .mx_RoomListPill_selection {
        transition: none;
    }
}
