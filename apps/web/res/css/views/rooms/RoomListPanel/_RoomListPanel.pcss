.mx_RoomListPanel {
    /* A 32px target plus its padding: the pill's height, declared here because the toast needs it too. */
    /* Icon, label and the padding around them: what the bar at the bottom of the column stands in. */
    --mx-room-list-pill-height: 56px;
    /*
     * The unread-activity toast shares this edge, and had the higher z-index, so it simply hid the pill.
     * Lifted clear of it rather than the pill moved: the pill is the persistent control and belongs at
     * the bottom, with a banner above it, which is the order iOS uses.
     */
    --mx-room-list-toast-bottom: calc(
        var(--tg-safe-bottom, 0px) + var(--cpd-space-4x) + var(--mx-room-list-pill-height) + var(--cpd-space-2x)
    );

    /* The containing block for the pill floating over the list. */
    position: relative;
    background-color: var(--cpd-color-bg-canvas-default);
    height: 100%;
}

/* Fork: the search field and what is left of the bridge status share one row. */
.mx_RoomListPanel_searchRow {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-1x);
    padding-inline-end: var(--cpd-space-2x);

    > :first-child {
        flex: 1 1 auto;
        min-width: 0;
    }
}

/*
 * The two things that are about every chat rather than about one of them: what is waiting for you, and
 * what the chats turned out to contain. Side by side while they are both buttons; once the digest opens
 * into a panel it takes the row and the other wraps below it.
 */
.mx_RoomListPanel_tools {
    display: flex;
    flex: 0 0 auto;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--cpd-space-2x);
    padding: var(--cpd-space-1x) var(--cpd-space-3x);
}

.mx_RoomListPanel_found {
    flex: 0 0 auto;
    white-space: nowrap;
}

/*
 * The whole-list actions, floating over the list rather than taking a row above it.
 *
 * Centred and clear of the home indicator, as iOS keeps this kind of control, and the list scrolls
 * underneath: on a handset the row it replaces was the scarcest thing on screen.
 *
 * Glass, in the manner of the iOS 26/27 pills: translucent over what is behind, blurred and saturated
 * so the colours beneath read through it, a bright hairline along the top edge where the light catches,
 * and a soft shadow holding it off the list. All of it through the fork's own glass variables, so low
 * power mode and scrolling drop the blur here exactly as they do everywhere else - a backdrop filter
 * over a scrolling list is the one that costs a fifth of a core.
 */
.mx_RoomListPill {
    position: absolute;
    bottom: calc(var(--tg-safe-bottom, 0px) + var(--cpd-space-4x));
    left: 50%;
    transform: translateX(-50%);
    /* Above the sticky section headers, as the toast is. */
    z-index: 3;
    display: flex;
    align-items: center;
    min-height: var(--mx-room-list-pill-height);
    box-sizing: border-box;
    gap: 2px;
    padding: var(--cpd-space-1x);
    /* A pill, as Element's other rounded chrome writes it. */
    border-radius: 99px;
    background: var(--tg-glass-background, var(--cpd-color-bg-canvas-default));
    backdrop-filter: var(--tg-glass-backdrop, none);
    box-shadow:
        inset 0 1px 0 rgb(255 255 255 / 40%),
        0 1px 2px rgb(0 0 0 / 10%),
        0 8px 24px rgb(0 0 0 / 14%);
}

/*
 * One entry: the icon with its name under it, and the one you are in filled.
 *
 * A bar of bare icons is a guess per icon, and without a mark on the current one it says what you can do
 * but never where you are. The whole entry is the target rather than the icon, so it clears the 44px a
 * finger needs even though the glyph is 22.
 */
.mx_RoomListPill_entry {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 2px;
    min-width: 60px;
    min-height: 44px;
    padding: var(--cpd-space-1x) var(--cpd-space-2x);
    border: none;
    border-radius: 99px;
    background: transparent;
    color: var(--cpd-color-icon-secondary);
    font: var(--cpd-font-body-xs-medium);
    cursor: pointer;
    transition:
        background-color 120ms ease,
        color 120ms ease;

    &:hover,
    &:focus-visible {
        color: var(--cpd-color-icon-primary);
    }

    &[aria-current="page"] {
        background: var(--cpd-color-bg-action-primary-rest);
        color: var(--cpd-color-icon-on-solid-primary);
    }

    span {
        line-height: 1.1;
        white-space: nowrap;
    }
}

@media (prefers-reduced-motion: reduce) {
    .mx_RoomListPill_entry {
        transition: none;
    }
}
