.mx_RoomListPanel {
    background-color: var(--cpd-color-bg-canvas-default);
    height: 100%;
}

/* Sidebar shortcuts belong to the same narrow column as the room list. */
.mx_RoomListPanel_tools {
    display: grid;
    flex: 0 0 auto;
    grid-template-columns: minmax(0, 1fr);
    gap: 0;
    min-width: 0;
    padding: var(--cpd-space-1x) var(--cpd-space-2x);
}

.mx_RoomListPanel_tools .mx_AiDigest_ask,
.mx_RoomListPanel_found {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    max-width: 100%;
    justify-content: flex-start;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

/* Fork: the search field and what is left of the bridge status share one row. */
.mx_RoomListPanel_searchRow {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-1x);
    padding-inline-end: var(--cpd-space-2x);

    > :first-child {
        flex: 1 1 auto;
        min-width: 0;
    }
}
