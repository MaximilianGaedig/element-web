/*
 * The user's settings as a place rather than a dialog: the column lists the sections (UserSettingsList)
 * and the page beside it is the chosen one (UserSettingsPage). The sections' own contents are Element's,
 * untouched; only what holds them is here. On a phone each is the whole screen in turn (_TgHandheld.pcss).
 */

/* ---- The list, in the column ---------------------------------------------------------------------- */

.mx_UserSettingsList {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
}

/* Back at the start, then the name: the column is not the chats, and says what it is instead. */
.mx_UserSettingsList_header {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    padding: var(--cpd-space-2x) var(--cpd-space-4x);
}

.mx_UserSettingsList_title {
    margin: 0;
    font: var(--cpd-font-heading-sm-semibold);
    color: var(--cpd-color-text-primary);
}

/* In place of the chats' search, which the settings do not have: the same field, at the head of the list. */
.mx_UserSettingsList_search {
    display: flex;
    align-items: center;
    gap: var(--cpd-space-2x);
    margin: 0 var(--cpd-space-4x) var(--cpd-space-2x);
    padding: 0 var(--cpd-space-3x);
    min-height: 40px;
    border-radius: var(--cpd-space-5x);
    background: var(--cpd-color-bg-subtle-secondary);
    color: var(--cpd-color-icon-secondary);

    &:focus-within {
        outline: 2px solid var(--cpd-color-border-focused);
    }

    > input {
        all: unset;
        flex: 1;
        min-width: 0;
        font: var(--cpd-font-body-md-regular);
        color: var(--cpd-color-text-primary);

        &::placeholder {
            color: var(--cpd-color-text-secondary);
        }
    }
}

.mx_UserSettingsList_sections {
    flex: 1;
    min-height: 0;
    margin: 0;
    padding: 0 var(--cpd-space-2x);
    /* The last row can be scrolled clear of the bar floating over the column's foot. */
    padding-bottom: var(--mx-room-list-toast-bottom, 6rem);
    overflow-y: auto;
    list-style: none;
}

/* The rows of a menu, as Element's own: an icon in the secondary colour, the name, a rounded highlight. */
.mx_UserSettingsList_section {
    all: unset;
    box-sizing: border-box;
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--cpd-space-4x);
    width: 100%;
    min-height: 44px;
    padding: var(--cpd-space-2x) var(--cpd-space-3x);
    border-radius: var(--cpd-space-3x);
    font: var(--cpd-font-body-md-medium);
    color: var(--cpd-color-text-primary);
    cursor: pointer;

    > svg {
        flex: 0 0 auto;
        color: var(--cpd-color-icon-secondary);
    }

    > span {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    /* A finger has no hover: on a touch screen the highlight would stay on after the tap. */
    @media (hover: hover) {
        &:hover {
            background: var(--cpd-color-bg-action-tertiary-hovered);
        }
    }

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        outline-offset: -2px;
    }

    /*
     * The section open beside the list, marked as the open chat is in the chat list: its selected
     * background (a step past the hover one, which is what keeps the two apart) and the accent bar at the
     * start. After the hover rule, so a selected row stays selected under the pointer, as the chat's does.
     */
    &[aria-selected="true"] {
        background:
            linear-gradient(var(--cpd-color-bg-accent-rest), var(--cpd-color-bg-accent-rest)) left center / 4px 70%
                no-repeat,
            var(--cpd-color-bg-action-tertiary-selected);

        > svg {
            color: var(--cpd-color-icon-primary);
        }
    }

    /* Recovery not set up: the dot the settings dialog put on its Encryption tab. */
    &[data-alert]::after {
        content: "";
        width: 8px;
        height: 8px;
        margin-inline-start: auto;
        border-radius: 50%;
        background-color: var(--cpd-color-icon-critical-primary);
    }
}

/* Read out, not seen: the count of what a search found. */
.mx_UserSettingsList_status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
}

/* A result is the setting's name with the section it is in under it. */
.mx_UserSettingsList_result {
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 0;

    > .mx_UserSettingsList_resultSection {
        font: var(--cpd-font-body-sm-regular);
        color: var(--cpd-color-text-secondary);
    }
}

.mx_UserSettingsList_empty {
    padding: var(--cpd-space-4x);
    font: var(--cpd-font-body-md-regular);
    color: var(--cpd-color-text-secondary);
    text-align: center;
}

/* ---- The page, beside it -------------------------------------------------------------------------- */

.mx_UserSettingsPage {
    /*
     * The column's sizes for the navigation a phone shows over the foot of the page (RoomListPill), so the
     * body can be kept clear of it as the lists are (_RoomListPanel.pcss declares them for the column).
     */
    --mx-room-list-pill-height: 64px;
    --mx-room-list-bar-bottom: max(var(--cpd-space-4x), calc(var(--tg-safe-bottom, 0px) - var(--cpd-space-2x)));
    --mx-room-list-toast-bottom: calc(
        var(--mx-room-list-bar-bottom) + var(--mx-room-list-pill-height) + var(--cpd-space-2x)
    );

    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    min-height: 0;
    background: var(--cpd-color-bg-canvas-default);
}

/* In place of a chat's header, at its height: the section's name, and on a phone the way back. */
.mx_UserSettingsPage_header {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    gap: var(--cpd-space-2x);
    min-height: 56px;
    padding: 0 var(--cpd-space-6x);
    border-bottom: 1px solid var(--cpd-color-separator-primary);
    box-sizing: border-box;
}

.mx_UserSettingsPage_title {
    margin: 0;

    /* Where the focus goes when a section opens: it is not a control, so it needs no ring of its own. */
    &:focus {
        outline: none;
    }
    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        outline-offset: 2px;
    }

    overflow: hidden;
    font: var(--cpd-font-heading-sm-semibold);
    color: var(--cpd-color-text-primary);
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_UserSettingsPage_body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    padding: var(--cpd-space-6x) var(--cpd-space-8x) var(--cpd-space-16x);

    /*
     * A readable measure in a pane that can be the width of a monitor, as the dialog was 980px at most: the
     * section is centred in it rather than strung across, or stuck to the list with a void beside it.
     */
    > .mx_SettingsTab {
        box-sizing: border-box;
        max-width: 720px;
        margin-inline: auto;
    }
}

/* The setting a search led to, shown once where it is; reduced motion gets the colour without the fade. */
@keyframes mx_UserSettingsPage_found {
    from {
        background-color: var(--cpd-color-bg-accent-rest);
    }
    to {
        background-color: transparent;
    }
}

.mx_UserSettingsPage_found {
    border-radius: var(--cpd-space-2x);
    animation: mx_UserSettingsPage_found 1.6s ease-out;
}

.mx_UserSettingsPage_toastContainer {
    position: absolute;
    bottom: var(--cpd-space-10x);
    width: 100%;
    display: flex;
    justify-content: center;
    pointer-events: none;

    > * {
        pointer-events: auto;
    }
}
