.mx_BridgesTab_summary,
.mx_BridgesTab_note {
    margin: 0 0 0.75rem;
    font: var(--cpd-font-body-md-regular);
    color: var(--cpd-color-text-secondary);
}

.mx_BridgesTab_empty {
    padding: 1.5rem 1rem;
    border-radius: 1rem;
    background: var(--cpd-color-bg-subtle-secondary);
    text-align: center;

    p {
        margin: 0.25rem 0 0;
        font: var(--cpd-font-body-md-regular);
        color: var(--cpd-color-text-secondary);
    }
}

.mx_BridgesTab_emptyTitle {
    font: var(--cpd-font-body-lg-semibold);
}

/* An inset grouped list: rounded cards, hairlines between them. */
.mx_BridgesTab_list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.mx_BridgeCard {
    border-radius: 1rem;
    background: var(--cpd-color-bg-subtle-secondary);
    overflow: hidden;

    &[open] .mx_BridgeCard_chevron {
        transform: rotate(90deg);
    }
}

.mx_BridgeCard_summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-height: 3.5rem;
    padding: 0.5rem 0.875rem;
    list-style: none;
    cursor: pointer;

    &::-webkit-details-marker {
        display: none;
    }

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        outline-offset: -2px;
    }
}

.mx_BridgeCard_avatar {
    flex: 0 0 auto;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: hsl(var(--hue) 55% 42%);
    color: #fff;
    font: var(--cpd-font-body-lg-semibold);
}

.mx_BridgeCard_titles {
    flex: 1 1 auto;
    min-width: 0;
    display: flex;
    flex-direction: column;
}

.mx_BridgeCard_title {
    font: var(--cpd-font-body-md-semibold);
}

.mx_BridgeCard_subtitle {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: var(--cpd-font-body-sm-regular);
    color: var(--cpd-color-text-secondary);
}

/* Status is an icon and a word, never a colour alone. */
.mx_BridgeCard_status {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.125rem 0.625rem;
    border-radius: 1rem;
    background: var(--cpd-color-bg-canvas-default);
    font: var(--cpd-font-body-sm-semibold);
    color: var(--cpd-color-text-secondary);
}

.mx_BridgeCard--connected .mx_BridgeCard_status {
    color: var(--cpd-color-text-success-primary);
}

.mx_BridgeCard--connecting .mx_BridgeCard_status {
    color: var(--tg-primary-color);
}

.mx_BridgeCard--problem .mx_BridgeCard_status,
.mx_BridgeCard--disconnected .mx_BridgeCard_status {
    color: var(--cpd-color-text-critical-primary);
    background: color-mix(in srgb, var(--cpd-color-text-critical-primary) 10%, transparent);
}

.mx_BridgeCard_chevron {
    flex: 0 0 auto;
    color: var(--cpd-color-icon-secondary);
    font-size: 1.25rem;
    transition: transform 0.2s ease;
}

.mx_BridgeCard_body {
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
    padding: 0.25rem 0.875rem 0.875rem;
}

.mx_BridgeCard_callout {
    padding: 0.875rem;
    border-radius: 0.75rem;
    background: color-mix(in srgb, var(--cpd-color-text-critical-primary) 9%, var(--cpd-color-bg-canvas-default));

    p {
        margin: 0.25rem 0 0;
        font: var(--cpd-font-body-sm-regular);
        color: var(--cpd-color-text-secondary);
    }
}

.mx_BridgeCard_calloutTitle {
    font: var(--cpd-font-body-md-semibold);
    color: var(--cpd-color-text-critical-primary);
}

.mx_BridgeCard_steps {
    margin: 0.5rem 0 0.75rem;
    padding-inline-start: 1.25rem;
    font: var(--cpd-font-body-md-regular);
}

.mx_BridgeCard_import {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
}

.mx_BridgeCard_importText {
    font: var(--cpd-font-body-md-regular);
    font-variant-numeric: tabular-nums;
}

.mx_BridgeCard_facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(8rem, 1fr));
    gap: 0.5rem 1rem;
    margin: 0;

    dt {
        font: var(--cpd-font-body-sm-regular);
        color: var(--cpd-color-text-secondary);
    }

    dd {
        margin: 0.125rem 0 0;
        font: var(--cpd-font-body-md-semibold);
        font-variant-numeric: tabular-nums;
    }
}

.mx_BridgeCard_actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
}

/* 48px targets; the one main action is filled. */
.mx_BridgeCard_primary,
.mx_BridgeCard_secondary {
    all: unset;
    box-sizing: border-box;
    display: grid;
    place-items: center;
    min-height: 3rem;
    padding: 0 1.25rem;
    border-radius: 0.875rem;
    font: var(--cpd-font-body-md-semibold);
    cursor: pointer;

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        outline-offset: 2px;
    }
}

.mx_BridgeCard_primary {
    width: 100%;
    background: var(--tg-primary-color);
    color: var(--cpd-color-text-on-solid-primary, #fff);
}

.mx_BridgeCard_secondary {
    flex: 1 1 auto;
    background: var(--cpd-color-bg-canvas-default);
    color: var(--tg-primary-color);
}

@media (prefers-reduced-motion: reduce) {
    .mx_BridgeCard_chevron {
        transition: none;
    }
}
