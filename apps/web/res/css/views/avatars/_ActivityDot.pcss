/*
 * Presence badge as Messenger/Facebook draw it: a green dot while online, a small green "12m" tag
 * for someone active within the hour. Colours are Facebook's own tokens (read from facebook.com's
 * :root / .__fb-dark-mode): --badge-background-color-green for the dot, --positive text on
 * --positive-background for the tag. Placement follows Telegram Web K
 * (src/scss/partials/_avatar.scss .is-online:after: 14px on a 54px avatar at 39px, i.e. tucked into
 * the bottom-right corner), and the pop-in is tweb's badge transition
 * (--chatlist-badge-transition-in: .25s cubic-bezier(.35,.35,.47,1.34)). Instead of tweb's ring in
 * the surface colour, the room list cuts a transparent gap into the avatar, so it works on any row
 * background (hover, selected).
 */
:root,
[class*="cpd-theme-"] {
    --ActivityDot-online: #24832c;
    --ActivityDot-recent-bg: #deefe1;
    --ActivityDot-recent-fg: #24832c;
}

.cpd-theme-dark {
    --ActivityDot-online: #3fbb46;
    --ActivityDot-recent-bg: #1f3520;
    --ActivityDot-recent-fg: #3fbb46;
}

.mx_ActivityDot {
    display: block;
    box-sizing: border-box;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: var(--ActivityDot-online);
    animation: mx_ActivityDot_in 0.25s cubic-bezier(0.35, 0.35, 0.47, 1.34) both;
}

.mx_ActivityDot.mx_ActivityDot_recent {
    width: auto;
    min-width: 16px;
    height: 12px;
    padding: 0 3px;
    border-radius: 6px;
    font: var(--cpd-font-body-xs-semibold);
    font-size: 9px;
    font-weight: 700;
    line-height: 12px;
    text-align: center;
    white-space: nowrap;
    color: var(--ActivityDot-recent-fg);
    background-color: var(--ActivityDot-recent-bg);
}

@keyframes mx_ActivityDot_in {
    from {
        transform: scale(0);
    }

    to {
        transform: scale(1);
    }
}

/*
 * Room list (32px avatar): gradient cut-outs around the dot and the tag. The doubled class
 * outranks Element's own placement (_RoomAvatarView.pcss: left: size - 4px), whatever the file order.
 */
.mx_RoomAvatarView.mx_RoomAvatarView {
    /* Tunable (TgTweaksPanel sets the --tg-presence-* overrides): size, offsets from the corner, gap. */
    --PresenceDot-size: var(--tg-presence-dot-size, 10px);
    --PresenceDot-right: var(--tg-presence-dot-right, 0px);
    --PresenceDot-bottom: var(--tg-presence-dot-bottom, 0px);
    --PresenceDot-gap: var(--tg-presence-dot-gap, 1px);
    --PresenceDot-cx: calc(100% - var(--PresenceDot-right) - var(--PresenceDot-size) / 2);
    --PresenceDot-cy: calc(100% - var(--PresenceDot-bottom) - var(--PresenceDot-size) / 2);
    --PresenceDot-hole: calc(var(--PresenceDot-size) / 2 + var(--PresenceDot-gap));

    /* The cut-out follows the dot: a transparent circle around it. */
    .mx_RoomAvatarView_RoomAvatar_presence {
        mask-image: radial-gradient(
            circle at var(--PresenceDot-cx) var(--PresenceDot-cy),
            transparent var(--PresenceDot-hole),
            #000 calc(var(--PresenceDot-hole) + 0.5px)
        );
        mask-size: 100% 100%;
    }

    /*
     * The tag's cut-out: its pill (ActivityDot measures --PresenceTag-width/-height) grown by the gap,
     * following the tag sliders like the dot's. Full avatar minus (left cap + right cap + middle band);
     * lengths, not percentages, since mask-position percentages are relative to (box - layer).
     */
    --PresenceTag-right: var(--tg-presence-tag-right, -8px);
    --PresenceTag-bottom: var(--tg-presence-tag-bottom, -3px);
    --PresenceTag-hole: calc(var(--PresenceTag-height, 12px) / 2 + var(--PresenceDot-gap));
    --PresenceTag-cy: calc(
        var(--room-avatar-size, 32px) - var(--PresenceTag-bottom) - var(--PresenceTag-height, 12px) / 2
    );
    --PresenceTag-cx-end: calc(
        var(--room-avatar-size, 32px) - var(--PresenceTag-right) - var(--PresenceTag-height, 12px) / 2
    );
    --PresenceTag-cx-start: calc(
        var(--room-avatar-size, 32px) - var(--PresenceTag-right) - var(--PresenceTag-width, 24px) +
            var(--PresenceTag-height, 12px) / 2
    );

    .mx_RoomAvatarView_RoomAvatar_recent {
        /*
         * Every layer is full-size: a sized/positioned layer snaps to whole pixels while the caps sit on
         * fractional ones (the tag is ~18.7px wide), which left steps where they met. The middle band is
         * a horizontal band intersected with a vertical one, and its long edges share the caps' 0.5px ramp.
         */
        mask-image:
            linear-gradient(#000, #000),
            radial-gradient(
                circle var(--PresenceTag-hole) at var(--PresenceTag-cx-start) var(--PresenceTag-cy),
                #000 calc(var(--PresenceTag-hole) - 0.5px),
                transparent var(--PresenceTag-hole)
            ),
            radial-gradient(
                circle var(--PresenceTag-hole) at var(--PresenceTag-cx-end) var(--PresenceTag-cy),
                #000 calc(var(--PresenceTag-hole) - 0.5px),
                transparent var(--PresenceTag-hole)
            ),
            linear-gradient(
                to right,
                transparent var(--PresenceTag-cx-start),
                #000 var(--PresenceTag-cx-start),
                #000 var(--PresenceTag-cx-end),
                transparent var(--PresenceTag-cx-end)
            ),
            linear-gradient(
                to bottom,
                transparent calc(var(--PresenceTag-cy) - var(--PresenceTag-hole)),
                #000 calc(var(--PresenceTag-cy) - var(--PresenceTag-hole) + 0.5px),
                #000 calc(var(--PresenceTag-cy) + var(--PresenceTag-hole) - 0.5px),
                transparent calc(var(--PresenceTag-cy) + var(--PresenceTag-hole))
            );
        mask-size: 100% 100%;
        mask-position: 0 0;
        mask-repeat: no-repeat;
        /* Top to bottom: full avatar minus (left cap + right cap + (horizontal band x vertical band)). */
        mask-composite: subtract, add, add, intersect, add;
    }

    /* 8px presence icons and the 10px dot share the cut-out centred at (27, 27). */
    .mx_RoomAvatarView_PresenceDecoration {
        left: auto;
        right: 1px;
        bottom: 1px;
    }

    .mx_ActivityDot.mx_RoomAvatarView_PresenceDecoration {
        width: var(--PresenceDot-size);
        height: var(--PresenceDot-size);
        right: var(--PresenceDot-right);
        bottom: var(--PresenceDot-bottom);
    }

    /* The "12m" tag hangs 3px below the avatar and 8px past its edge, level with the bridged-network badge. */
    .mx_ActivityDot_recent.mx_RoomAvatarView_PresenceDecoration {
        width: auto;
        height: 12px;
        right: var(--PresenceTag-right);
        bottom: var(--PresenceTag-bottom);
        transform-origin: right bottom;
    }
}
