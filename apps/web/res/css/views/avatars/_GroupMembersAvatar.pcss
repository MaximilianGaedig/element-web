/* A group's avatar made of its members (GroupMembersAvatar): petals placed in % so it scales with its box. */
.mx_GroupMembersAvatar {
    position: relative;
    display: inline-block;
    flex: 0 0 auto;
    box-sizing: border-box;
    padding: 0;
    border: none;
    background: none;
    vertical-align: middle;

    &:is(button) {
        cursor: pointer;
    }
}

.mx_GroupMembersAvatar_petal {
    position: absolute;
    mask-size: 100% 100%;
    mask-repeat: no-repeat;

    > .mx_BaseAvatar {
        width: 100% !important;
        height: 100% !important;

        > img {
            width: 100%;
            height: 100%;
        }
    }
}
