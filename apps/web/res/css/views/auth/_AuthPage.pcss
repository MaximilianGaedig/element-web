.mx_AuthPage {
    width: 100%;
    min-height: 100%;
    display: flex;
    flex-direction: column;
    background-color: $authpage-bg-color;
    /*
     * The screen the app actually has, and the edges it must keep clear of. Installed to a home screen
     * the app draws under the status bar and the home indicator (viewport-fit=cover), and iOS then
     * reports 100vh as the *safe* height - which left the bottom of the screen unpainted below this
     * page. The dynamic viewport is the whole screen, and the insets put the content back inside it.
     */
    height: 100dvh;
    box-sizing: border-box;
    padding-block: env(safe-area-inset-top, 0px) env(safe-area-inset-bottom, 0px);
    overflow: auto;
}

.mx_AuthPage_modal {
    display: flex;
    /* Never wider than the screen it is on, whatever the card inside it asks for. */
    max-width: 100%;
    margin: 100px auto auto;
    border-radius: var(--cpd-space-6x);
    background-color: $authpage-modal-bg-color;

    @media only screen and (max-height: 768px) {
        margin-top: 50px;
    }

    @media only screen and (max-width: 480px) {
        margin-top: 0;
    }

    &.mx_AuthPage_modal_withBlur {
        /* Apply a blurred shadow around the modal */
        box-shadow: 0 2px 4px 0 rgb(0, 0, 0, 0.33);

        .mx_AuthPage_modalContent {
            /* Make the modal's background semitransparent */
            background-color: $authpage-modal-content-with-blur-bg-color;
        }
    }
}
