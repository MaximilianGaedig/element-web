.mx_Welcome {
    display: flex;
    flex-direction: column;
    align-items: center;
    background-color: var(--cpd-color-bg-canvas-default);
    box-sizing: border-box;
    padding: var(--cpd-space-11x) var(--cpd-space-12x) var(--cpd-space-4x);

    &.mx_WelcomePage_registrationDisabled {
        .mx_ButtonCreateAccount {
            display: none;
        }
    }
}

/*
 * On a phone the welcome card has to fit the phone: its buttons are a fixed 380px and it pads 48px on
 * each side, which comes to 476px - wider than the screen, so the card ran off the right edge with no
 * way to scroll to it.
 */
@media only screen and (max-width: 480px) {
    .mx_Welcome {
        width: 100%;
        padding-inline: var(--cpd-space-6x);
    }

    .mx_DefaultWelcome .mx_DefaultWelcome_buttons a {
        width: 100%;
    }
}

.mx_Welcome .mx_AuthBody_language {
    width: 160px;
    margin: var(--cpd-space-1x) 0;
}

/* Invert image colours in dark mode. */
.cpd-theme-dark .mx_WelcomePage_logo {
    filter: invert(1);
}
