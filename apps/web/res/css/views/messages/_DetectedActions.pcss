/*
 * What a message asks of you (DetectedActions.tsx), under the message: a time to put in the calendar,
 * a number to ring. Small and quiet - the message is the thing being read, and most messages show
 * nothing here at all.
 */
.mx_DetectedActions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--cpd-space-2x);
    margin-top: var(--cpd-space-2x);

    .mx_DetectedActions_chip {
        display: inline-flex;
        align-items: center;
        gap: var(--cpd-space-1x);
        min-height: 0;
        padding: var(--cpd-space-1x) var(--cpd-space-3x);
        border-radius: 999px;
        font: var(--cpd-font-body-sm-medium);
        text-decoration: none;

        svg {
            width: 1rem;
            height: 1rem;
            flex: 0 0 auto;
        }
    }
}

/* A measurement needs no press: the converted value is the whole of the answer. */
.mx_DetectedActions_chip--plain {
    display: inline-flex;
    align-items: center;
    gap: var(--cpd-space-1x);
    padding: var(--cpd-space-1x) var(--cpd-space-2x);
    border-radius: 99px;
    background: var(--cpd-color-bg-subtle-secondary);
    font: var(--cpd-font-body-sm-medium);
    color: var(--cpd-color-text-secondary);

    svg {
        width: 1em;
        height: 1em;
    }
}

/*
 * A phrase in a message that turned out to be something: a time, a number, a place, a flight, a parcel.
 * Marked where it was written rather than only offered as a chip below - the words themselves are where
 * a finger goes first, which is how iOS has done it for years.
 *
 * It has to read as part of the sentence, so it keeps the message's own type and colour and takes only
 * an underline; a button's usual padding, background and border would make the sentence lumpy.
 */
.mx_DetectedMark {
    margin: 0;
    padding: 0;
    border: none;
    background: none;
    font: inherit;
    color: inherit;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--cpd-color-text-action-accent) 60%, transparent);
    text-decoration-thickness: 2px;
    text-underline-offset: 2px;
    cursor: pointer;

    &:hover,
    &:focus-visible {
        text-decoration-color: var(--cpd-color-text-action-accent);
    }
}
