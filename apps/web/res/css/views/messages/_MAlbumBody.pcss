.mx_MAlbumBody {
    display: flex;
    flex-direction: column;
    gap: var(--cpd-space-2x);
    max-width: 100%;
}

/* Telegram's grouped-media layout (see GroupedMediaLayout.ts): the box gets the layout's pixel width and aspect
   ratio inline, and every cell is absolutely positioned in percent, so the album scales down as a whole.
   tweb caps album attachments at min(451px, 100%). */
.mx_MAlbumBody_grid {
    position: relative;
    max-width: min(451px, 100%);
    border-radius: var(--cpd-space-2x);
    overflow: hidden;

    .mx_HiddenMediaPlaceholder {
        position: absolute;
        inset: 0;
    }
}

.mx_MAlbumBody_cell {
    position: absolute;
    box-sizing: border-box;
    min-width: 0;
    min-height: 0;
    padding: 0;
    border: none;
    margin: 0;
    overflow: hidden;
    cursor: pointer;
    background-color: var(--cpd-color-bg-subtle-secondary);

    img,
    video {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        /* the cell handles clicks and right-clicks for the item */
        pointer-events: none;
    }

    &:focus-visible {
        outline: 2px solid var(--cpd-color-border-focused);
        outline-offset: -2px;
    }
}

.mx_MAlbumBody_cell_playing {
    cursor: auto;
    background-color: black;

    video {
        object-fit: contain;
        pointer-events: auto;
    }
}

.mx_MAlbumBody_play {
    position: absolute;
    inset: 50% auto auto 50%;
    transform: translate(-50%, -50%);
    display: flex;
    padding: var(--cpd-space-2x);
    border-radius: 50%;
    color: white;
    background-color: rgb(0 0 0 / 55%);

    svg {
        width: 24px;
        height: 24px;
    }
}

.mx_MAlbumBody_caption .mx_EventTile_body {
    white-space: pre-wrap;
}

.mx_AlbumLightbox {
    position: relative;
    width: 100%;
    height: 100%;
}

.mx_AlbumLightbox_loading {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    color: white;
}

.mx_AlbumLightbox_video {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;

    video {
        max-width: 90%;
        max-height: 90%;
    }
}

.mx_AlbumLightbox_close {
    position: absolute;
    top: var(--cpd-space-4x);
    right: var(--cpd-space-4x);
    color: white;

    svg {
        width: 28px;
        height: 28px;
    }
}

.mx_AlbumLightbox_nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    z-index: 1;
    display: flex;
    padding: var(--cpd-space-2x);
    border-radius: 50%;
    color: white;
    background-color: rgb(0 0 0 / 40%);

    svg {
        width: 32px;
        height: 32px;
    }

    &:hover {
        background-color: rgb(0 0 0 / 65%);
    }
}

.mx_AlbumLightbox_prev {
    left: var(--cpd-space-4x);
}

.mx_AlbumLightbox_next {
    right: var(--cpd-space-4x);
}

.mx_AlbumLightbox_position {
    position: absolute;
    bottom: var(--cpd-space-4x);
    left: 50%;
    transform: translateX(-50%);
    padding: var(--cpd-space-1x) var(--cpd-space-3x);
    border-radius: var(--cpd-space-4x);
    color: white;
    background-color: rgb(0 0 0 / 50%);
    font: var(--cpd-font-body-sm-regular);
}
