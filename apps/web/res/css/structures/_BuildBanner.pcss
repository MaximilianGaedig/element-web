/* The bar for a non-production build (src/vector/buildBanner.tsx): the app takes the rest of the page below it. */
.mx_hasBuildBanner body {
    display: flex;
    flex-direction: column;
}

.mx_hasBuildBanner #matrixchat {
    flex: 1 1 0;
    min-height: 0;
    /* index.html sets height: 100% inline on this element. */
    height: auto !important;
}
