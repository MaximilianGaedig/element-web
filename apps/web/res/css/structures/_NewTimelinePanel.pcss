/*
 * The new timeline's reply-preview rules — the loading skeleton and the row
 * heights that keep it height-neutral — live alongside the reply components in
 * _ReplyChain.pcss / _ReplyTile.pcss.
 */
.mx_NewTimelinePanel {
    /* Fill the room view body, like the old message panel does. */
    height: 100%;

    /* Each message keeps its virtual row; the sender avatar closes the run. */
    .mx_NewTimelinePanel_senderMessage {
        position: relative;

        /*
         * tweb puts the bubble 2.875rem from the avatar's edge; the line then pulls itself back by
         * Element's line margin, which without this ate tweb's gap and slid the bubble under the avatar.
         */
        [data-testid="event-tile"] {
            --event-tile-bubble-margin-inline-start: calc(
                8px + 2.875rem - var(--event-tile-bubble-line-margin-inline-start, 0px)
            );
        }

        [data-testid="event-tile-slot-avatar"] {
            display: none;
        }
    }

    .mx_NewTimelinePanel_senderAvatar {
        /* Out of flow so extending a sender run never changes the previous row's height. */
        position: absolute;
        inset-inline-start: 8px;
        inset-block-end: 2.5px;
        z-index: 2;
    }

    /* Kept mounted but invisible, e.g. while search results are shown, so the
       timeline keeps its scroll position and loaded window. */
    &.mx_NewTimelinePanel_hidden {
        display: none;
    }

    /* The virtualized timeline renders its rows as an <ol role="list"> of <li>
       tiles (mx_TimelineView_list / mx_TimelineView_tile in TimelineView; the <ol>
       and <li> reset their own list markers inline). Inset the tile content to
       match the legacy mx_RoomView_MessageList padding so messages don't sit flush
       against the panel edges.

       The inset goes on the tiles rather than the <ol>: the rows are absolutely
       positioned, so their containing block is the <ol>'s padding box and padding
       there would not inset them. box-sizing + padding-inline on each row does,
       and — being horizontal only — leaves the virtualizer's measured row heights
       and vertical offsets untouched. */
    .mx_TimelineView_tile {
        box-sizing: border-box;
        padding-inline: var(--RoomView_MessageList-padding);
    }

    /* The date of the day being read, floating over the top of the list while scrolling
       (TimelineView positions and fades it; this is only how it looks). It is the same
       separator the list draws, so the wording matches, but standing on its own over the
       messages it has to read as a label above them rather than as a divider between
       them — hence no rules, and the pill that Element's other floating timeline chrome
       uses. The inner element is the separator's own label row. */
    .mx_NewTimelinePanel_stickyDate {
        justify-content: center;
        margin-block: var(--cpd-space-2x);

        hr {
            display: none;
        }

        > div {
            padding: var(--cpd-space-1x) var(--cpd-space-4x);
            /* A pill, as Element's other rounded chrome writes it. */
            border-radius: 99px;
            background: var(--cpd-color-bg-subtle-secondary);
            color: var(--cpd-color-text-secondary);
            /* The same lift the pinned-message banner floats over the timeline with. */
            box-shadow: 0 var(--cpd-space-2x) var(--cpd-space-6x) calc(var(--cpd-space-2x) * -1) rgb(27, 29, 34, 0.1);
        }
    }

    /* The row holding the spinner shown while more history is fetched. Its height is
       fixed so the row always measures the same. */
    .mx_NewTimelinePanel_loading {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 32px;
        overflow: hidden;
    }

    /* An image that fails to load replaces its reserved media box with a short
       error message, which would otherwise pull every row below it upwards. Hold
       the row at the height of the box being replaced — ImageBodyView passes it
       as --mx-image-reserved-height, and only for images whose event declared
       dimensions; anything else reserved no box, so it gets no minimum.

       The error state sets `display: block`, so laying the message out needs flex
       re-asserting here; the root's `flex-direction: column` then means the cross
       axis is horizontal, and centring in the box is align-items (horizontally)
       plus justify-content (vertically). */
    span.mx_ImageBody {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: var(--mx-image-reserved-height, 0);
    }
}
